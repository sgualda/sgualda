---
import '@styles/fonts.css';
import '@styles/tokens.css';
import '@styles/base.css';
import { SITE, SOCIAL, EXPERTISE, SAME_AS } from '@lib/site';
import ErrorLog from '@components/ErrorLog.astro';
import ThemeToggle from '@components/ThemeToggle.astro';
import CookieBanner from '@components/CookieBanner.astro';
import Analytics from '@components/Analytics.astro';

interface Props {
  title: string;
  description: string;
  /**
   * Override the canonical. Defaults to the current page URL.
   *
   * `false` drops it entirely, which only the 404 page wants: it is served at
   * every URL that does not exist, so no single address is its canonical one.
   * It was declaring /404/ — an address that itself answers 404, a page
   * pointing at its own absence. Pages that are merely noindex keep theirs;
   * those have a real URL, and a self-reference there is correct.
   */
  canonical?: string | false;
  /** Social share image, absolute or site-relative. */
  image?: string;
  /** Extra JSON-LD nodes to merge into the @graph. */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  /**
   * Drops the floating theme control. For pages that are one task and nothing
   * else — the brief — where a control in the corner is a distraction and, on a
   * phone, sits on top of the last answer.
   */
  bare?: boolean;
}

const { title, description, canonical, image, schema = [], noindex = false, bare = false } = Astro.props;

// Each page gets its own card, generated at build time from its <h1>.
// Falls back to the default if that page has no generated image yet.
const slug = Astro.url.pathname === '/'
  ? 'home'
  : Astro.url.pathname.replace(/^\/|\/$/g, '').replace(/\//g, '-');
const ogPath = image ?? `/og/${slug}.png`;

const url = typeof canonical === 'string' ? canonical : new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(ogPath, SITE.url).href;
/**
 * The site name is a suffix, not a tax.
 *
 * " | Sergio Gualda" is 16 characters out of the ~60 Google shows, and eight
 * pages were being truncated purely to carry it — losing the end of the actual
 * title, which is the part somebody is scanning for. So it is appended only
 * when there is room. Google renders the site name separately from the title
 * anyway, and a truncated title costs more than a missing suffix.
 */
const SUFFIX = ` | ${SITE.name}`;
const fullTitle =
  title.includes(SITE.name) || title.length + SUFFIX.length > 60 ? title : title + SUFFIX;

/**
 * Articles get the page's own social card as their schema image.
 *
 * Without it, `BlogPosting` and `Article` are ineligible for a result with a
 * thumbnail and — the part that costs more — ineligible for Google Discover,
 * which for first-person writing about decisions is plausibly the largest
 * single source of traffic this site can earn. Every page already generates a
 * card at build time; they were simply never declared to the article node.
 *
 * Done here rather than in the three page templates because this is the only
 * place that already knows a page's card path. Adding a fourth article type
 * later gets it without anyone remembering to.
 *
 * `ImageObject` with dimensions rather than a bare URL: Google's article
 * guidance asks for images at least 1200px wide, and stating the size saves it
 * from fetching the file to find out.
 */
const ARTICLE_TYPES = new Set(['Article', 'BlogPosting', 'NewsArticle', 'TechArticle']);
const withImage = (node: Record<string, unknown>) =>
  ARTICLE_TYPES.has(node['@type'] as string) && !node.image
    ? { ...node, image: { '@type': 'ImageObject', url: ogImage, width: 1200, height: 630 } }
    : node;

// Person + WebSite ship on every page; page-specific nodes get merged in.
const graph = [
  {
    '@type': 'Person',
    '@id': `${SITE.url}/#person`,
    name: SITE.name,
    jobTitle: SITE.role,
    url: SITE.url,
    email: `mailto:${SITE.email}`,
    image: new URL('/img/sergio-gualda.jpg', SITE.url).href,
    description:
      'Product designer in Barcelona. Takes vague problems to shipped first versions for small teams building SaaS, mobile apps and internal tools, and publishes what the decisions cost.',
    address: { '@type': 'PostalAddress', addressLocality: 'Barcelona', addressCountry: 'ES' },
    knowsAbout: [...EXPERTISE],
    sameAs: [...SAME_AS],
    /**
     * `hasOccupation` rather than only the `jobTitle` string above.
     *
     * jobTitle is text on a page. Occupation is a typed node with a category
     * code, which is what lets an engine place this person in the same class as
     * every other product designer instead of matching a phrase. The code is
     * the O*NET-SOC entry for web and digital interface designers, the closest
     * standard classification that exists for this work.
     */
    hasOccupation: {
      '@type': 'Occupation',
      name: SITE.role,
      occupationalCategory: '15-1255.00',
      occupationLocation: { '@type': 'City', name: 'Barcelona' },
      skills: [...EXPERTISE],
    },
    worksFor: { '@id': `${SITE.url}/#practice` },
  },
  {
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: SITE.url,
    name: SITE.name,
    inLanguage: SITE.locale,
    publisher: { '@id': `${SITE.url}/#person` },
  },
  /**
   * The practice as an entity in its own right.
   *
   * Everything hung off the Person, so there was no business to resolve — only
   * a man with an email address. A one-person consultancy is still an
   * organisation that is hired, invoiced and searched for, and a knowledge
   * graph has nowhere to attach reviews, services or an address without a node
   * to attach them to.
   *
   * Deliberately `@id`-linked to the Person via `founder` rather than merged
   * into it: they are two things, and conflating them is how a knowledge panel
   * ends up describing a company as a human being.
   *
   * `ProfessionalService` rather than plain `Organization`, and declared once
   * here rather than again on /work-with-me/. That page had its own
   * ProfessionalService node, so adding an Organization created two nodes
   * describing the same business under two types — the precise conflation this
   * comment warns about, introduced while writing it. One node, referenced by
   * @id from anywhere that needs it.
   */
  {
    '@type': 'ProfessionalService',
    '@id': `${SITE.url}/#practice`,
    name: `${SITE.name} — Product Design`,
    url: SITE.url,
    email: `mailto:${SITE.email}`,
    logo: new URL('/icon-512.png', SITE.url).href,
    image: new URL('/img/sergio-gualda.jpg', SITE.url).href,
    description:
      'Independent product design practice in Barcelona. Product strategy, discovery and design for small teams building SaaS, mobile apps and internal tools.',
    address: { '@type': 'PostalAddress', addressLocality: 'Barcelona', addressCountry: 'ES' },
    areaServed: { '@type': 'Place', name: 'Worldwide' },
    priceRange: '$$',
    founder: { '@id': `${SITE.url}/#person` },
    employee: { '@id': `${SITE.url}/#person` },
    knowsAbout: [...EXPERTISE],
    /**
     * No sameAs on the practice, on purpose.
     *
     * The Person's list includes uxerfy.com/about/, which is a page about
     * Sergio. Copying it here would assert that this practice and Uxerfy are
     * the same business, and they are not — Uxerfy is a separate thing he
     * founded, selling a different service. The two are already connected
     * correctly through `founder`, which says "same person" without claiming
     * "same company".
     *
     * There is no third-party page identifying this practice yet. When there
     * is one — a directory listing, a company profile — it belongs here.
     */
  },
  ...schema.map(withImage),
];
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical !== false && <link rel="canonical" href={url} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — ${SITE.name}`} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />

    {/* The tab icon is the memoji, the same mark as the header and the app
        icons — not the drawn "SG" that used to be here.

        No SVG entry any more, and that is the point rather than an omission:
        browsers prefer an SVG icon over everything else when one is offered, so
        leaving favicon.svg listed meant the letterform kept winning no matter
        what the .ico contained. The mark is a raster portrait, so a vector
        version buys nothing anyway.

        32px first: that is what a tab shows on any modern display, and it is
        where the face is legible. 16px exists for older screens, .ico for
        Windows shortcuts and the crawlers and readers that still ask for
        /favicon.ico by name without reading the markup. */}
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />

    <!-- Blocking on purpose, and the only inline script on the site. Anything
         async here means the page paints in the wrong theme and then corrects
         itself, which is worse than no dark mode at all. Two lines, no
         dependencies, runs before the first paint. -->
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — essays`} href="/rss.xml" />

    <!-- Self-hosted. No third-party connection, and the two files the first
         screen needs are preloaded so text paints without a flash. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/zalando-sans-expanded-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/archivo-latin.woff2" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
    <Analytics />
    <slot name="head" />
    <ErrorLog />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot name="nav" />
    <main id="main"><slot /></main>
    <slot name="footer" />
    {!bare && <ThemeToggle />}
    {!bare && <CookieBanner />}
  </body>
</html>
