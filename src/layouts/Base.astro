---
import '@styles/fonts.css';
import '@styles/tokens.css';
import '@styles/base.css';
import { SITE, SOCIAL, EXPERTISE } from '@lib/site';
import ErrorLog from '@components/ErrorLog.astro';

interface Props {
  title: string;
  description: string;
  /** Override the canonical. Defaults to the current page URL. */
  canonical?: string;
  /** Social share image, absolute or site-relative. */
  image?: string;
  /** Extra JSON-LD nodes to merge into the @graph. */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, canonical, image, schema = [], noindex = false } = Astro.props;

// Each page gets its own card, generated at build time from its <h1>.
// Falls back to the default if that page has no generated image yet.
const slug = Astro.url.pathname === '/'
  ? 'home'
  : Astro.url.pathname.replace(/^\/|\/$/g, '').replace(/\//g, '-');
const ogPath = image ?? `/og/${slug}.png`;

const url = canonical ?? new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(ogPath, SITE.url).href;
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;

// Person + WebSite ship on every page; page-specific nodes get merged in.
const graph = [
  {
    '@type': 'Person',
    '@id': `${SITE.url}/#person`,
    name: SITE.name,
    jobTitle: SITE.role,
    url: SITE.url,
    email: `mailto:${SITE.email}`,
    image: new URL('/img/sergio-gualda.jpg', SITE.url).href,
    description:
      'Product designer in Barcelona. Takes vague problems to shipped first versions for small teams building SaaS, mobile apps and internal tools, and publishes what the decisions cost.',
    address: { '@type': 'PostalAddress', addressLocality: 'Barcelona', addressCountry: 'ES' },
    knowsAbout: [...EXPERTISE],
    sameAs: [SOCIAL.linkedin, SOCIAL.instagram, SOCIAL.community].filter(Boolean),
  },
  {
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: SITE.url,
    name: SITE.name,
    inLanguage: SITE.locale,
    publisher: { '@id': `${SITE.url}/#person` },
  },
  ...schema,
];
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — ${SITE.name}`} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1e1c1c" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — essays`} href="/rss.xml" />

    <!-- Self-hosted. No third-party connection, and the two files the first
         screen needs are preloaded so text paints without a flash. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/zalando-sans-expanded-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/archivo-latin.woff2" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
    <slot name="head" />
    <ErrorLog />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot name="nav" />
    <main id="main"><slot /></main>
    <slot name="footer" />
  </body>
</html>
