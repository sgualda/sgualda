---
import Base from '@layouts/Base.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { SITE } from '@lib/site';
import { BLUNT_HTML, FAQ_HTML } from '@lib/work-with-me';
import '@styles/quiz.css';

/**
 * /work-with-me/ — matches the Figma frame "Work with me".
 *
 * Deliberately no prices: Sergio cannot publish them while employed.
 * The qualifier is the point of the page, so it sits above everything else.
 */

// Build the FAQPage schema from the rendered markup, so the structured data
// can never drift from what a visitor actually reads.
const faqs = [...FAQ_HTML.matchAll(/<summary>([\s\S]*?)<span class="pm">[\s\S]*?<div class="ans">([\s\S]*?)<\/div>/g)].map(
  (m) => ({
    q: m[1].replace(/<[^>]+>/g, '').trim(),
    a: m[2].replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim(),
  })
);
---

<Base
  title="Work with me — product design help for small teams"
  description="Answer four questions and get a straight recommendation on how I would help: a working session, a product review, a written critique, embedded work, or none of them."
  schema={[
    {
      '@type': 'ProfessionalService',
      name: `${SITE.name} — Product Design Consulting`,
      areaServed: 'Worldwide',
      email: SITE.email,
      address: { '@type': 'PostalAddress', addressLocality: 'Barcelona', addressCountry: 'ES' },
      serviceType: [
        'Product Design Consulting',
        'Product Strategy',
        'Product Discovery',
        'Design Critique',
        'Design Systems',
      ],
      provider: { '@id': `${SITE.url}/#person` },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ]}
>
  <Header slot="nav" />

  <!-- ── hero + qualifier ── -->
  <section class="col hero">
    <span class="eyebrow">Work with me</span>
    <h1>Let's find out<br />if I can actually help</h1>
    <p class="sub">
      Four questions, half a minute, and you get a straight answer on how I would work with
      you — or that I would not, which happens about a third of the time. Nothing is booked
      and nothing is sent.
    </p>
  </section>

  <div class="col">
    <div class="panel">
      <div class="dots" id="qfDots" role="presentation"><i class="on"></i><i></i><i></i><i></i></div>
      <div id="qfBox" role="status" aria-live="polite" aria-atomic="true"></div>
    </div>
    <p class="aside">
      Rather just write? <a href="#brief">Skip to the brief</a> or email
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
    </p>
  </div>

  <!-- ── do not hire me if ── -->
  <section class="section col">
    <span class="eyebrow">Read this first</span>
    <h2>Do not hire me if…</h2>
    <p class="sub">
      Every one of these has happened, more than once.<br />
      I would rather lose the project in a paragraph than in month two.
    </p>
    <div class="blunt" set:html={BLUNT_HTML} />
  </section>

  <!-- ── faq ── -->
  <section class="section col">
    <span class="eyebrow">Questions</span>
    <h2>The things<br />people ask me.</h2>
    <div class="faq" set:html={FAQ_HTML} />
  </section>

  <!-- ── brief ── -->
  <section class="section col" id="brief">
    <span class="eyebrow">No call required</span>
    <h2>Send a brief.</h2>
    <p class="sub">
      Five short steps, about three minutes. I read every one myself and reply within a day
      with what fits, what it would involve and what it costs — or that none of it fits.
    </p>
    <div class="panel" style="margin-top:34px">
      <div class="dots" id="bDots"><i class="on"></i><i></i><i></i><i></i><i></i></div>
      <div id="bBox"></div>
      <!-- Honeypot. Hidden from people, irresistible to bots. -->
      <div class="hp" aria-hidden="true">
        <label for="website">Website</label>
        <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
    </div>
    <p class="aside">
      Or just email me — <a href={`mailto:${SITE.email}`}>{SITE.email}</a>. The form only exists
      so you do not have to work out what to tell me.
    </p>
  </section>

  <Footer slot="footer" />
</Base>

<style is:global>
  /* "Do not hire me if…" — the markup arrives via set:html, so these cannot be
     scoped. Matches the Figma frame: an empty outlined circle set well apart
     from the text, and no dividing lines between items. */
  .blunt { text-align: left; margin-top: 44px; }
  .blunt .b {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 26px;
    align-items: start;
  }
  .blunt .b + .b { margin-top: 40px; }
  .blunt .x {
    width: 20px; height: 20px;
    border-radius: 50%;
    border: 1px solid var(--ink);
    margin-top: 3px;
  }
  .blunt .x svg { display: none; }
  .blunt h3 {
    font-family: var(--font-display);
    font-size: 1rem; font-weight: 600;
    letter-spacing: -0.03em; line-height: 1.3;
    margin-bottom: 8px;
  }
  .blunt p {
    font-size: 0.9375rem; line-height: 1.55;
    letter-spacing: 0; color: var(--dim);
  }

  @media (max-width: 480px) {
    .blunt .b { grid-template-columns: 16px 1fr; gap: 16px; }
    .blunt .x { width: 16px; height: 16px; }
  }
</style>

<style>
  .hero { padding-top: clamp(52px, 9vh, 84px); }
  .hero h1 { margin-bottom: 18px; }

  .panel {
    margin-top: 34px;
    background: var(--paper);
    border: 1px solid var(--hair);
    border-radius: var(--radius-card);
    padding: clamp(26px, 5vw, 38px) clamp(20px, 4vw, 30px);
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .aside { margin-top: 16px; font-size: 0.875rem; color: var(--dim); letter-spacing: 0; }
  .aside a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
</style>

<script>
  import { Q, OUT, decide, KIND, SPECIFIC } from '@lib/work-with-me';
  import { celebrate, settle } from '@lib/feedback';
  import { createQuiz } from '@lib/quiz';

  const $ = (id: string) => document.getElementById(id)!;
  const answers: Record<string, string> = {};
  let rec: string | null = null;

  /* ── qualifier ── */

  createQuiz<string>({
    questions: Q.map((q) => ({
      key: q.k,
      text: q.q,
      options: q.o.map(([value, label, note]) => ({ value, label, note })),
    })),
    box: $('qfBox'),
    dots: $('qfDots'),

    resolve(picked) {
      Q.forEach((q, i) => (answers[q.k] = String(picked[i].value)));
      rec = decide(answers);
      return rec;
    },

    renderQuestion: (q, i, total) =>
      `<div class="step">` +
      (i > 0 ? `<button class="back" type="button" data-quiz-back>← Back</button>` : '') +
      `<span class="eyebrow">Question ${i + 1} of ${total}</span>` +
      `<h2 class="qq" data-quiz-head tabindex="-1">${q.text}</h2>` +
      q.options
        .map((o, n) =>
          `<button class="opt" type="button" data-quiz-opt="${n}">${o.label}` +
          (o.note ? `<em>${o.note}</em>` : '') + `</button>`)
        .join('') +
      `</div>`,

    renderVerdict(key) {
      const o = OUT[key];
      return (
        `<div class="step">` +
        `<span class="vlab">${o.lab}</span>` +
        `<h2 class="vname" data-quiz-head tabindex="-1">${o.name}</h2>` +
        `<span class="vmeta">${o.meta}</span><div class="vwhy">${o.why}</div>` +
        `<div class="vcols"><div><h4>What you would get</h4><ul>` +
        o.get.map((g: string) => `<li>${g}</li>`).join('') +
        `</ul></div><div class="no"><h4>What it is not</h4><ul>` +
        o.not.map((g: string) => `<li>${g}</li>`).join('') +
        `</ul></div></div><p class="vnote">${o.note}</p>` +
        `<div class="vacts">` +
        (key === 'notyet'
          ? `<a class="btn btn--dark" href="/tools/">Try a free check</a>` +
            `<a class="btn btn--ghost" href="/writing/">Read something instead</a>`
          : `<a class="btn btn--dark" href="#brief" id="toBrief">Send a tailored brief</a>` +
            `<a class="btn btn--ghost" href="mailto:hello@sgualda.com">Just email me</a>`) +
        `</div><button class="back" type="button" data-quiz-restart>Start over</button></div>`
      );
    },

    onRender({ verdict }) {
      if (!verdict) return;

      // 'nope' and 'notyet' turn somebody away. Honest, a third of replies,
      // and not a celebration.
      const panel = $('qfBox').closest('.panel');
      if (verdict === 'nope' || verdict === 'notyet') settle(panel);
      else celebrate(panel);

      document.getElementById('toBrief')?.addEventListener('click', () => paint(kindOf()));
    },
  });

  /* ── brief ── */
  // The quiz engine tracks its own dots; the brief is a form, not a quiz, so
  // it keeps its own.
  const setDots = (el: HTMLElement, i: number) =>
    el.querySelectorAll('i').forEach((d, k) => d.classList.toggle('on', k <= i));

  const kindOf = () => (rec && SPECIFIC[OUT[rec].kind] ? OUT[rec].kind : 'unsure');
  let step = 1;

  function paint(kind: string) {
    const f = SPECIFIC[kind] ?? SPECIFIC.unsure;
    const field = ([id, lab, type, hint]: string[]) => {
      const h = hint ? `<p class="hint">${hint}</p>` : '';
      if (type.startsWith('select|'))
        return `<div class="f"><label for="${id}">${lab}</label><select id="${id}">${type
          .split('|')
          .slice(1)
          .map((o) => `<option>${o}</option>`)
          .join('')}</select>${h}</div>`;
      if (type === 'input') return `<div class="f"><label for="${id}">${lab}</label><input id="${id}">${h}</div>`;
      return `<div class="f"><label for="${id}">${lab}</label><textarea id="${id}"></textarea>${h}</div>`;
    };

    const panes: string[] = [
      `<span class="eyebrow">Step 1 of 5</span>` +
        (rec ? `<p class="tag">Based on your answers: ${OUT[rec].name}</p>` : '') +
        `<p class="qq">What kind of help are you after?</p>` +
        KIND.map(([k, label]) => `<label class="ck"><input type="radio" name="kind" value="${label}" data-k="${k}"${k === kind ? ' checked' : ''}><span>${label}</span></label>`).join(''),
      `<span class="eyebrow">Step 2 of 5</span><p class="qq">What are you building?</p>` +
        field(['b1', 'Product name and link', 'input', 'A link is worth more than a description.']) +
        field(['b2', 'Team size', 'select|Just me|2–5|6–15|16–40|More than 40', '']),
      `<span class="eyebrow">Step 3 of 5</span><p class="qq">What is actually blocked?</p>` +
        field(['b4', 'In your own words', 'textarea', 'Do not polish it. The messy version is more useful.']),
      `<span class="eyebrow">Step 4 of 5</span><p class="qq">A few specifics.</p>` + f.map(field).join(''),
      `<span class="eyebrow">Step 5 of 5</span><p class="qq">Where do I reply?</p>` +
        field(['b9', 'Name', 'input', '']) +
        field(['b10', 'Email', 'input', '']),
    ];

    $('bBox').innerHTML =
      `<div class="step">${panes[step - 1]}<div class="fnav">` +
      (step > 1 ? `<button class="btn btn--ghost" type="button" data-go="${step - 1}">Back</button>` : `<span></span>`) +
      (step < 5
        ? `<button class="btn btn--dark" type="button" data-go="${step + 1}">Continue</button>`
        : `<button class="btn btn--dark" type="button" id="send">Send the brief</button>`) +
      `</div></div>`;

    setDots($('bDots'), step - 1);
    $('bBox').querySelectorAll<HTMLButtonElement>('[data-go]').forEach((b) =>
      b.addEventListener('click', () => {
        step = +b.dataset.go!;
        paint(kindOf());
        $('brief').scrollIntoView({ behavior: 'smooth', block: 'start' });
      })
    );
    document.getElementById('send')?.addEventListener('click', submit);
  }

  /* ── submitting ── */
  const opened = Date.now();
  const val = (id: string) => (document.getElementById(id) as HTMLInputElement | null)?.value?.trim() ?? '';

  async function submit() {
    const btn = document.getElementById('send') as HTMLButtonElement;
    const email = val('b10');
    const blocked = val('b4');

    // Validate before touching the network, and say which field is wrong.
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
      showError('I need an email address that works, or I cannot reply.');
      return;
    }
    if (blocked.length < 20) {
      showError('Step 3 is the one I actually read. A couple of sentences is enough.');
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Sending…';
    document.getElementById('bErr')?.remove();

    const kindEl = document.querySelector<HTMLInputElement>('input[name=kind]:checked');
    const specifics: Record<string, string> = {};
    document.querySelectorAll<HTMLElement>('#bBox .f').forEach((f) => {
      const field = f.querySelector<HTMLInputElement>('input,textarea,select');
      const label = f.querySelector('label')?.textContent ?? '';
      if (field && field.value.trim() && !['b1', 'b2', 'b4', 'b9', 'b10'].includes(field.id)) {
        specifics[label] = field.value.trim();
      }
    });

    try {
      const res = await fetch('/api/brief.php', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          kind: kindEl?.value,
          recommendation: rec ? OUT[rec].name : undefined,
          product: val('b1'),
          team: val('b2'),
          blocked,
          specifics,
          name: val('b9'),
          email,
          website: val('website'),
          elapsed: Date.now() - opened,
        }),
      });
      const out = await res.json();
      if (!res.ok || !out.ok) throw new Error(out.error || 'Something went wrong.');

      celebrate($('bBox').closest('.panel'));
      $('bBox').innerHTML =
        `<div class="step" role="status"><p class="vname">That is everything I need.</p>` +
        `<p class="vnote">I read every brief myself and reply within a day — with what fits, ` +
        `what it would involve and what it costs, or that none of it fits. ` +
        `A confirmation is on its way to ${email}.</p></div>`;
      $('bDots').style.display = 'none';
    } catch (err) {
      btn.disabled = false;
      btn.textContent = 'Send the brief';
      showError(
        err instanceof Error ? err.message : 'Could not send. Email hello@sgualda.com instead.'
      );
    }
  }

  function showError(msg: string) {
    document.getElementById('bErr')?.remove();
    const p = document.createElement('p');
    p.id = 'bErr';
    p.className = 'formErr';
    p.setAttribute('role', 'alert');
    p.textContent = msg;
    document.querySelector('#bBox .fnav')?.before(p);
  }

  // The qualifier starts itself; the brief needs its first step painted.
  paint('unsure');
</script>
