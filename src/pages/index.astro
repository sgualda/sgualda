---
import { getCollection } from 'astro:content';
import Base from '@layouts/Base.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Newsletter from '@components/Newsletter.astro';
import Testimonials from '@components/Testimonials.astro';
import { getTestimonials, reviewSchema } from '@lib/testimonials';
import { Image } from 'astro:assets';
import studio from '../assets/studio.jpg';
import { SITE } from '@lib/site';

/**
 * Home — built to match the Figma frame "Home" section by section.
 */

/**
 * The four projects on the home page, in the order Sergio named them.
 * Deliberately a hand-written list rather than the collection's `order`
 * field: the work page shows everything, and this one shows the four he
 * wants a stranger to see first. Two of the six are buried on purpose and
 * belong on /work/, not here.
 */
const FEATURED = ['truvi', 'ecoco-mobile-app', 'glintale', 'truvi-developer-portal'];
const all = await getCollection('projects', ({ data }) => !data.draft);
const featured = FEATURED.map((id) => all.find((c) => c.id === id)).filter((c) => c !== undefined);
if (featured.length !== FEATURED.length) {
  throw new Error(
    `Home: ${FEATURED.filter((id) => !all.some((c) => c.id === id)).join(', ')} not in the cases collection`
  );
}


/* Same call the component renders from, so the markup can never describe a
   quote the page does not show. Empty until the quotes arrive, and an empty
   array adds no node. */
const voices = await getTestimonials();

---

<Base
  title={`${SITE.role} in Barcelona — ${SITE.name}`}
  description="I design and build things on the internet, and write down what the mistakes cost. Web design, development and audits for small teams, from Barcelona."
  schema={reviewSchema(voices)}
>
  <Header slot="nav" />

  <!-- ── hero ── -->
  <section class="col hero">
    {/* Sergio's wording, and this is the third time it has been put back.
        Twice for SEO, once — 2026-08-20 — because the site started selling web
        development and an h1 ending "through design" names half of what is on
        offer. He prefers his line, so his line stays. Do not swap it again.

        The trade is known and accepted: this line carries no term anybody
        searches for, so the <title> does that work alone. */}
    <h1>Building<br />experiences<br />through design</h1>
    <p class="sub">
      I’ve built products from zero, failed, iterated, and figured out what actually matters in
      the early stages of a business. Now I help others skip the expensive mistakes.
    </p>
    <div class="actions">
      {/* One primary, one secondary. Two solid buttons side by side make the
          reader choose between two equals, which is a decision nobody came
          here to make. The work is the supporting act. */}
      <a class="btn btn--dark" href="/collaborate/">Let’s talk</a>
      <a class="btn btn--ghost" href="/work/">See the work</a>
    </div>
  </section>

  <!-- ── what I do ── -->
  <section class="section">
    <div class="col">
      <span class="eyebrow">What I do</span>
      <h2>I take vague problems<br />to shipped first versions.</h2>
      <p class="sub">
        Design and code, usually with two or three other people, usually with less time than
        the plan needed. 7+ years of it, mostly SaaS, mobile apps and the sites around them.
      </p>
    </div>

    <div class="wide grid">
      {
        featured.map((c) => (
          <a class="slot" href={`/work/${c.id}/`} aria-label={`${c.data.title} — ${c.data.summary}`}>
            <Image
              src={c.data.cover!}
              alt={c.data.coverAlt ?? ''}
              widths={[320, 640, 960]}
              sizes="(max-width: 560px) calc(100vw - 40px), 272px"
              loading="lazy"
              style={`object-position:${c.data.coverPosition}`}
            />
          </a>
        ))
      }
    </div>

  </section>

  <!-- ── the idea ── -->
  <section class="section">
    <div class="col">
      <h2>Making things is<br />no longer the hard part.</h2>
      <p class="sub">
        Anyone can produce a screen. Almost nobody can say why that one and not another.
        That’s the part I work on, and the only part <a href="/writing/">worth writing down</a>.
        Most of it happens <a href="/about/">here in Barcelona</a>, and
        <a href="/now/">this is what I’m on now</a>.
      </p>
    </div>
    <div class="wide">
      <Image
        src={studio}
        alt="The desk where most of this gets made"
        class="wide-shot"
        widths={[560, 880, 1760]}
        sizes="(max-width: 560px) calc(100vw - 40px), 880px"
      />
    </div>
  </section>

  <!-- ── what it cost ── -->
  <section class="section col">
    <span class="eyebrow">What it cost</span>
    <h2>Some of my projects<br />are buried, in public.</h2>
    <p class="sub">
      A portfolio of things that worked teaches nobody anything, because what worked depended
      on a team, a market and a moment you will never have.
    </p>
    <div class="actions" style="margin-top:30px">
      <a class="btn btn--dark" href="/work/">See the work</a>
    </div>
  </section>

  {/* Straight after the section admitting projects are buried, and straight
      before the ask. Proof belongs immediately before a request, and it lands
      hardest as the counterweight to somebody having just listed their own
      failures. Renders nothing until there are quotes to show. */}
  <Testimonials />

  {/* No collaborate banner here, on purpose.
      The home already ends on the work and then asks for an email. A third
      block asking for something else in between turns the bottom of the page
      into a queue of requests. The banner belongs at the end of a page that
      has just made an argument — an essay, a project, the about page — not at
      the end of the front door. */}

  <!-- ── newsletter ── -->
  {/* A band, so it stays on --shell with the header, the footer and every
      other band. Only grids step out to --shell-wide. */}
  <section class="section">
    <div class="col">
      <Newsletter />
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  /* Three rows, not three cards. A card grid here would be the first thing on
     the page that looks like a services company, forty pixels above a section






  /* Room to breathe under the header.
     The header is sticky and about 64px tall, so 56px of padding on a laptop
     put the top of a 96px headline within a few pixels of the nav — the two
     read as one block, and the largest type on the site had nothing above it.
     The floor is now more than the header's own height, so there is always a
     clear band of paper between the menu and the first word. */
  .hero { padding-top: clamp(96px, 16vh, 176px); }
  .hero h1 { margin-bottom: 22px; }
  .hero .actions { margin-top: 30px; }
  .skip-to {
    margin-top: var(--space-5);
    font-size: 0.875rem;
    letter-spacing: 0;
    color: var(--dim);
  }
  .skip-to a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .skip-to a:hover { opacity: 0.6; }
  h2 + .sub { margin-top: 16px; }

  /* Four projects, bare images as in the comp. No caption: Sergio's call. The
     link name comes from aria-label instead, so the four are still
     distinguishable to anybody not looking at them.

     One row at --shell-wide, two at tablet, one column on a phone. It was a
     2×2 block inside a 560px column with the right-hand half of a 1280px
     screen empty next to it. */
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-top: 42px;
  }
  .slot { display: block; text-align: left; }
  .slot img {
    display: block;
    width: 100%;
    /* Square, as in the comp. A square crop of a 2304×1271 screenshot shows
       about 55% of its width, anchored left so the navigation and the first
       column survive and the crop lands on the empty right-hand side. */
    aspect-ratio: 1 / 1;
    object-fit: cover;
    background: var(--surface);
    border: 1px solid var(--hair);
    border-radius: var(--radius-card);
    transition: opacity 0.28s var(--ease), transform 0.28s var(--ease);
  }
  .slot:hover img { opacity: 0.86; transform: translateY(-2px); }
  @media (max-width: 820px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .grid { grid-template-columns: 1fr; } }

  .wide-shot {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius-card);
    margin-top: var(--space-8);







  }
</style>
