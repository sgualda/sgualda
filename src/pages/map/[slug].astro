---
import { getCollection } from 'astro:content';
import Base from '@layouts/Base.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { SITE } from '@lib/site';
import { getStages, getTools, type Stage } from '@lib/content';

export async function getStaticPaths() {
  const STAGES = await getStages();
  const TOOLS = await getTools();
  return STAGES.map((s, i) => ({
    params: { slug: s.slug },
    props: {
      s,
      prev: STAGES[i - 1] ?? null,
      next: STAGES[i + 1] ?? null,
      tools: s.tools.map((slug) => TOOLS.find((t) => t.slug === slug)).filter(Boolean),
    },
  }));
}

const { s, prev, next, tools } = Astro.props as {
  s: Stage;
  prev: Stage | null;
  next: Stage | null;
  tools: any[];
};
const terms = (await getCollection('glossary'))
  .filter((g) => g.data.stage === s.slug)
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<Base
  title={s.seoTitle}
  description={s.meta}
  schema={[
    {
      '@type': 'FAQPage',
      '@id': `${SITE.url}/map/${s.slug}/#faq`,
      mainEntity: s.faqs.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ]}
>
  <Header slot="nav" />

  <section class="col intro">
    <Breadcrumbs items={[{ label: 'Map', href: '/map/' }, { label: `Stage ${s.n} of 05` }]} />
    <h1>{s.name}</h1>
    <p class="sub">{s.lead}</p>
  </section>

  <section class="section col">
    <span class="eyebrow">What this stage is</span>
    <h2>{s.question}</h2>
    <div class="body">
      {s.body.map((p) => <p set:html={p} />)}
    </div>
  </section>

  <section class="section col">
    <span class="eyebrow">Where it goes wrong</span>
    <h2>Three ways to lose<br />time here.</h2>
    <ol class="traps">
      {s.traps.map((t) => <li>{t}</li>)}
    </ol>
  </section>

  <section class="section col">
    <div class="signal">
      <span class="eyebrow">You’re past this stage when</span>
      <p>{s.signal}</p>
    </div>
  </section>

  <section class="section col">
    <span class="eyebrow">Start here</span>
    <h2>What to check<br />before you commit.</h2>
    {/* The stage question, reused rather than restated. Everything on this
        page exists to answer it, and naming it here is what turns a list of
        links into a reason to click one. */}
    <p class="sub">
      Everything at this stage comes back to one question — <em>{s.question}</em> Each of these
      takes a different run at it, and gives you a verdict rather than a score.
    </p>
    <p class="why">
      They are free and they take under a minute. That is the point: the cheapest thing you can
      do at this stage is find out you were about to be wrong, and the most expensive is finding
      out a quarter later.
    </p>
    <ul class="tools rail">
      {
        tools.map((t) => (
          <li>
            <a href={`/tools/${t.slug}/`}>
              <span class="pill">{t.time} · {t.count}</span>
              <span class="h">{t.n}</span>
              <span class="p">{t.out}</span>
              <span class="gets">You get: {t.answers.map(([n]) => n).join(' · ')}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Converts a reader who recognised themselves in this stage. No price:
       Sergio cannot publish one, so the CTA sells the next conversation. -->
  <section class="section col">
    <span class="eyebrow">If you’re stuck here right now</span>
    <h2>There’s a version<br />where I help.</h2>
    <div class="offer">
      <div>
        <h3>{s.cta.title}</h3>
        <p>{s.cta.body}</p>
      </div>
      <a class="btn btn--dark" href="/work-with-me/">See if I can help</a>
    </div>
    <p class="fine">
      Four questions on that page tell you whether this is worth it for you — including when it’s not.
    </p>
  </section>

  <section class="section col">
    <nav class="pager" aria-label="Stages">
      {
        prev ? (
          <a href={`/map/${prev.slug}/`} class="prev">
            <em>Previous</em>
            <span>{prev.n} · {prev.name}</span>
          </a>
        ) : <span />
      }
      {
        next ? (
          <a href={`/map/${next.slug}/`} class="next">
            <em>Next</em>
            <span>{next.n} · {next.name}</span>
          </a>
        ) : <span />
      }
    </nav>

  </section>


  {terms.length > 0 && (
    <section class="section col">
      <span class="eyebrow">Vocabulary</span>
      <h2>Words this check uses.</h2>
      <dl class="terms-inline">
        {terms.map((g) => (
          <div>
            <dt><a href={`/glossary/#${g.id}`}>{g.data.name}</a></dt>
            <dd>{g.data.definition}</dd>
          </div>
        ))}
      </dl>
    </section>
  )}

  <section class="section col">
    <span class="eyebrow">Questions</span>
    <h2>About this stage.</h2>
    <div class="faq">
      {
        s.faqs.map(({ q, a }) => (
          <details>
            <summary>{q}<span class="pm" aria-hidden="true">+</span></summary>
            <div class="ans"><p>{a}</p></div>
          </details>
        ))
      }
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .intro { padding-top: clamp(44px, 8vh, 72px); }
  .intro h1 { margin-bottom: 18px; }

  .question {
    margin-top: 34px;
    padding: 26px;
    background: var(--surface);
    border-radius: var(--radius-card);
    font-family: var(--font-display);
    font-size: 1.125rem; font-weight: 600; letter-spacing: var(--ls-heading); line-height: var(--lh-tight);
  }

  .body {
    margin-top: 28px;
    font-size: 1.0625rem; line-height: var(--lh-read); letter-spacing: 0; color: var(--dim);
  }
  .body :global(p + p) { margin-top: 1.1em; }
  .body :global(strong) { color: var(--ink); font-weight: 600; }
  .body :global(em) { font-style: italic; }

  .traps { list-style: none; counter-reset: t; text-align: left; margin-top: 34px; }
  .traps li {
    counter-increment: t; position: relative; padding: 18px 0 18px 40px;
    font-size: 1rem; line-height: var(--lh-ui); letter-spacing: 0; color: var(--dim);
  }
  .traps li + li { border-top: 1px solid var(--hair); }
  .traps li::before {
    content: counter(t, decimal-leading-zero);
    position: absolute; left: 0; top: 21px;
    font-family: var(--font-mono); font-size: 0.6875rem; color: var(--ink);
  }

  /* No slab, no border. It is one sentence: the strongest thing on the page,
     and a black box around it made it look like an advertisement for itself.
     Type and space do the work instead. */
  .signal { padding: clamp(20px, 4vw, 34px) 0; }
  .signal p {
    margin-top: 16px;
    font-family: var(--font-display); font-size: 1.25rem; font-weight: 600;
    letter-spacing: var(--ls-heading); line-height: var(--lh-tight);
  }

  /* The same rail as the tool pages. Two or three checks stacked vertically
     read as "here is a list to work through"; side by side they read as "pick
     one", which is what the section is actually for. */
  .tools { list-style: none; text-align: left; margin-top: 34px; padding-block: 4px; }
  .tools > li { width: 268px; }
  .tools a {
    display: flex; flex-direction: column; height: 100%;
    background: var(--surface); border-radius: var(--radius-card); padding: 22px;
    border: 1px solid transparent;
    transition: border-color 0.24s var(--ease), transform 0.24s var(--ease);
  }
  .tools a:hover { border-color: var(--ink); transform: translateY(-2px); }
  .tools .gets { margin-top: auto; }
  .pill {
    display: inline-block; font-size: 0.625rem; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--dim);
    background: var(--paper); border-radius: var(--radius-pill); padding: 5px 10px;
    margin-bottom: 12px;
  }
  .tools .h {
    display: block; font-family: var(--font-display); font-size: 1rem;
    font-weight: 600; letter-spacing: var(--ls-heading); margin-bottom: 6px;
  }
  .tools .p { font-size: 0.875rem; line-height: var(--lh-ui); letter-spacing: 0; color: var(--dim); }
  /* The possible verdicts, named. "A verdict rather than a score" is a claim;
     listing the four verdicts is the evidence, and it is what tells somebody
     whether the answer would be useful before they spend the minute. */
  .tools .gets {
    display: block;
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--hair);
    font-size: 0.75rem;
    line-height: var(--lh-ui);
    letter-spacing: 0;
    color: var(--dim);
  }

  .why {
    margin-top: var(--space-5);
    font-size: 0.9375rem;
    line-height: var(--lh-read);
    letter-spacing: 0;
    color: var(--dim);
  }

  .offer {
    margin-top: 32px;
    background: var(--surface);
    border-radius: var(--radius-card);
    padding: clamp(30px, 5vw, 40px);
    text-align: left;
    display: flex; flex-direction: column; gap: 22px; align-items: flex-start;
  }
  .offer h3 { margin-bottom: 10px; }
  .offer p { font-size: 1rem; line-height: var(--lh-read); letter-spacing: 0; color: var(--dim); }
  .fine { margin-top: 18px; font-size: 0.8125rem; letter-spacing: 0; color: var(--dim); }

  .pager {
    display: flex; justify-content: space-between; gap: 16px;
    padding-top: 26px; border-top: 1px solid var(--hair); text-align: left;
  }
  .pager a { display: block; transition: opacity 0.2s var(--ease); }
  .pager a:hover { opacity: 0.6; }
  .pager .next { text-align: right; }
  .pager em {
    display: block; font-style: normal; font-size: 0.6875rem;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--dim); margin-bottom: 5px;
  }
  .pager span {
    font-family: var(--font-display); font-size: 0.9375rem;
    font-weight: 600; letter-spacing: var(--ls-heading);
  }
</style>

<style>
  .terms-inline { text-align: left; margin-top: var(--space-6); }
  .terms-inline > div { padding: var(--space-5) 0; }
  .terms-inline > div + div { border-top: 1px solid var(--hair); }
  .terms-inline dt {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: var(--ls-heading);
    margin-bottom: var(--space-2);
  }
  .terms-inline dt a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .terms-inline dt a:hover { opacity: 0.6; }
  .terms-inline dd {
    margin: 0;
    font-size: 0.9375rem;
    line-height: var(--lh-read);
    letter-spacing: 0;
    color: var(--dim);
  }
</style>

<script>
  import { rails } from '@lib/rail';
  rails();
</script>
