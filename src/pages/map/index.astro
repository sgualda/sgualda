---
import Base from '@layouts/Base.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Newsletter from '@components/Newsletter.astro';
import { getStages } from '@lib/content';

const STAGES = await getStages();

/** /map/, the Figma frame "Map", with the route made interactive. */

---

<Base
  title="The five stages of building a product"
  description="Five stages of building a product, each with its own problem — because advice that saves you at one stage can hurt you at another."
  schema={[
    {
      '@type': 'DefinedTermSet',
      name: 'The five stages of building a product',
      hasDefinedTerm: STAGES.map((s) => ({
        '@type': 'DefinedTerm',
        name: s.name,
        description: s.lead,
        url: `https://sgualda.com/map/${s.slug}/`,
      })),
    },
  ]}
>
  <Header slot="nav" />

  <section class="col intro">
    <span class="eyebrow">Map</span>
    <h1>Five stages,<br />five problems.</h1>
    <p class="sub">
      Each stage has a different problem, and advice that saves you in one can hurt you in
      another. They are numbered, not ordered — pick the one you are in.
    </p>
  </section>

  {/* One route, vertical, and it is the navigation.

      The page used to show these five stages twice: a horizontal curve that
      broke out of the site's column, and then a list of the same five things
      underneath it. Two components, one set of content, and the curve was the
      one that could not be read on a phone.

      The line is a CSS rule now rather than an animated SVG path. The old one
      drew itself with `stroke-dasharray: 1000` — a hardcoded length — and the
      real path is longer than that, so the stroke ran out partway along and
      the route simply stopped after stage 03. A border cannot run out. */}
  <section class="section col">
    <span class="eyebrow">Pick one</span>
    <h2>Where are you<br />right now?</h2>

    <ol class="rows route">
      {
        STAGES.map((s) => (
          <li>
            <a href={`/map/${s.slug}/`}>
              <span class="r-node" aria-hidden="true">{s.n}</span>
              <span class="r-title">{s.name}</span>
              <span class="r-note">{s.lead}</span>
              <span class="r-go" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </span>
            </a>
          </li>
        ))
      }
    </ol>

    <p class="route-note">Every one of them has cost me something. Stage 03 the most.</p>
  </section>

  <section class="section col">
    <Newsletter
      title="One decision,<br />and what it cost."
      body="Free. Leave whenever. No roundups, no five tips, no news."
    />
  </section>

  <Footer slot="footer" />
</Base>

<style><style>
  .intro { padding-top: clamp(52px, 9vh, 84px); }
  .intro h1 { margin-bottom: 18px; }

  /* The route draws itself once, on entry. */
  /* Faint baseline the route sits on, with a tick under each stage. */
  @keyframes pop { from { opacity: 0; } to { opacity: 1; } }

  /* First and last sit at the edges: centring their labels would push them
     outside the card. */
  /* Halo that expands on hover. */
  /* The description is hidden until you reach for the node. */
  /* ── mobile: the route turns vertical ──
     A five-point horizontal path cannot be read at 375px. It was hidden here
     for a while, which meant the page’s signature element simply did not
     exist for most visitors. It changes shape instead: same five stops, same
     order, same links, running top to bottom. */
  @keyframes rise-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }

  /* The stage list is `.rows` from base.css. Only its top margin is local. */
  .stages { margin-top: 40px; }

  /* ── the route ──
     `.rows` from base.css, plus a node column and the line that threads them.
     The line is a 1px border on each row, clipped at the first and last node so
     the route starts and ends on a stage rather than in mid-air. It runs behind
     the nodes, which are painted on the page colour. */
  .route { margin-top: 44px; }
  .route > li { border: 0; position: relative; }
  .route > li:last-child { border-bottom: 0; }
  .route > li::before {
    content: '';
    position: absolute;
    left: 21px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--hair);
  }
  .route > li:first-child::before { top: 50%; }
  .route > li:last-child::before { bottom: 50%; }

  .route a {
    grid-template-columns: 44px 1fr auto;
    grid-template-areas: 'node title go' 'node note go';
    column-gap: 20px;
    padding: 20px 0;
  }
  .r-node {
    grid-area: node;
    align-self: center;
    position: relative;
    z-index: 1;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-pill);
    border: 1px solid var(--hair);
    background: var(--paper);
    font-family: var(--font-mono);
    font-size: var(--fs-fine);
    color: var(--dim);
    transition: border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .route a:hover .r-node { border-color: var(--ink); color: var(--ink); }
  /* No meta line in this variant — the node is the number. */
  .route .r-title { margin-top: 0; }

  .route-note {
    margin-top: 34px;
    font-size: var(--fs-fine);
    line-height: var(--lh-ui);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--dim);
  }

  /* The node stays on a phone: it is the stage's identity, not decoration.
     The arrow goes, as everywhere else — the row is the target. */
  @media (max-width: 560px) {
    .route a {
      grid-template-columns: 38px 1fr;
      grid-template-areas: 'node title' 'node note';
      column-gap: 16px;
    }
    .r-node { width: 38px; height: 38px; }
    .route > li::before { left: 18px; }
  }
  @media (prefers-reduced-motion: reduce) { .r-node { transition: none; } }
</style>

