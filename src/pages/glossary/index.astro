---
import { getCollection } from 'astro:content';
import Base from '@layouts/Base.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import NextStep from '@components/NextStep.astro';
import { getTools, getStages } from '@lib/content';
import { SITE } from '@lib/site';

/**
 * /glossary/ — the vocabulary this site uses with a specific meaning.
 *
 * The point is not decoration. A language model answering "what is a polite
 * no" quotes a definition, and DefinedTerm with a stable @id is how it knows
 * this page is the definition rather than a passing mention.
 */
const terms = (await getCollection('glossary')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name)
);
const tools = await getTools();
const stages = await getStages();
---

<Base
  title="Glossary — the words this site uses"
  description="Sixteen terms used with a specific meaning here: workaround, repeat use, polite no, reversible decision, switching cost. Each with a definition and where it applies."
  schema={[
    {
      '@type': 'DefinedTermSet',
      '@id': `${SITE.url}/glossary/#set`,
      name: 'Product decisions glossary',
      description: 'Vocabulary used with a specific meaning on sgualda.com.',
      hasDefinedTerm: terms.map((t) => ({
        '@type': 'DefinedTerm',
        '@id': `${SITE.url}/glossary/#${t.id}`,
        name: t.data.name,
        description: t.data.definition,
        inDefinedTermSet: `${SITE.url}/glossary/#set`,
      })),
    },
  ]}
>
  <Header slot="nav" />

  <section class="col intro">
    <span class="eyebrow">Glossary</span>
    <h1>The words<br />I use.</h1>
    <p class="sub">
      Sixteen terms that carry a specific meaning here. Most of them are ordinary words used
      precisely, which is worse than jargon if nobody says which precision.
    </p>
  </section>

  {/* Sixteen terms in one alphabetical list stopped being scannable around
      twelve. Filtering in the browser rather than linking to anchors: the
      answer to "is X in here" is faster than the answer to "where is X". */}
  <div class="col">
    <div class="find" hidden>
      <label class="sr-only" for="q">Filter terms</label>
      <input id="q" type="search" placeholder="Filter, workaround, polite no…" autocomplete="off" />
      <p class="count" id="count" role="status" aria-live="polite"></p>
    </div>

    <dl class="terms">
      {
        terms.map((t) => {
          const tool = t.data.tool ? tools.find((x) => x.slug === t.data.tool) : undefined;
          const stage = t.data.stage ? stages.find((x) => x.slug === t.data.stage) : undefined;
          return (
            <div class="term" id={t.id} data-find={`${t.data.name} ${t.data.definition} ${t.data.topics.join(' ')}`.toLowerCase()}>
              {/* An h3 inside the dt: the definition list keeps its semantics
                  and each term becomes a heading a search engine can lift as
                  an answer on its own. Sixteen terms under one h2 were
                  invisible individually. */}
              <dt><h3>{t.data.name}</h3></dt>
              <dd>
                <p class="def">{t.data.definition}</p>
                <p class="note">{t.data.note}</p>
                {(tool || stage) && (
                  <p class="where">
                    {tool && <a href={`/tools/${tool.slug}/`}>{tool.n}</a>}
                    {stage && <a href={`/map/${stage.slug}/`}>Stage {stage.n} — {stage.name}</a>}
                  </p>
                )}
              </dd>
            </div>
          );
        })
      }
    </dl>
  </div>


  <NextStep line="These are the decisions I get hired to help with." />

  <Footer slot="footer" />
</Base>

<style>
  .intro { padding-top: clamp(52px, 9vh, 84px); }
  .intro h1 { margin-bottom: 18px; }

  .find { margin-top: var(--space-8); }
  .find input {
    width: 100%;
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 14px 18px;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--hair);
    border-radius: var(--radius-pill);
    outline: none;
    transition: border-color 0.2s var(--ease);
  }
  .find input::placeholder { color: var(--dim); }
  .find input:focus { border-color: var(--ink); }
  .find input:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--ink) 26%, transparent);
  }
  .find .count {
    margin-top: var(--space-3);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
    min-height: 1em;
  }

  .terms { text-align: left; margin-top: var(--space-6); }
  .term[hidden] { display: none; }
  .term { padding: var(--space-6) 0; }
  .term + .term { border-top: 1px solid var(--hair); }
  /* An anchored term must not land under the sticky header. */
  .term { scroll-margin-top: 80px; }

  dt { margin-bottom: var(--space-3); }
  dt h3 {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: var(--ls-heading);
  }
  dd { margin: 0; }
  .def { font-size: 1rem; line-height: var(--lh-read); letter-spacing: 0; color: var(--dim); }
  .note {
    margin-top: var(--space-3);
    padding-left: var(--space-4);
    border-left: 2px solid var(--hair);
    font-size: 0.9375rem;
    line-height: var(--lh-ui);
    letter-spacing: 0;
    color: var(--dim);
  }
  .where { margin-top: var(--space-4); display: flex; gap: var(--space-4); flex-wrap: wrap; }
  .where a {
    font-size: 0.8125rem;
    letter-spacing: 0;
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .where a:hover { opacity: 0.6; }
</style>

<script>
  const q = document.getElementById('q') as HTMLInputElement | null;
  const count = document.getElementById('count');
  const terms = [...document.querySelectorAll<HTMLElement>('.term')];

  if (q && count) {
    // The field only appears once JavaScript has run: without it, filtering is
    // impossible and an empty box that does nothing is worse than no box.
    q.closest('.find')!.hidden = false;

    q.addEventListener('input', () => {
      const v = q.value.trim().toLowerCase();
      let shown = 0;
      for (const t of terms) {
        const hit = !v || (t.dataset.find ?? '').includes(v);
        t.hidden = !hit;
        if (hit) shown++;
      }
      count.textContent = v ? `${shown} of ${terms.length}` : '';
    });
  }
</script>
