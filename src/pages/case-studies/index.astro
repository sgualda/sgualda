---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@layouts/Base.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { SITE } from '@lib/site';

/**
 * /case-studies/ — matches the Figma frame "Work".
 *
 * The grid is driven by the `cases` collection, so it can never disagree with
 * what is on the page. Two of the six have no cover on purpose: they are the
 * buried ones, and there is nothing to show. They get the status set in type
 * instead of a grey rectangle, which reads as a decision rather than a
 * missing asset.
 *
 * Note: the comp says "Burried". Fixed to "Buried".
 */
const cases = (await getCollection('cases', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || b.data.published.valueOf() - a.data.published.valueOf()
);

/**
 * Status is the interesting axis of this particular portfolio.
 *
 * The page's own thesis is that some of these are dead and that the dead ones
 * are the useful part — and until now that was visible on two cards out of six,
 * because only the buried ones lack a cover. The other four were unlabelled
 * squares.
 *
 * Wording: 'shipped' and 'buried' were already in the content schema and in the
 * copy on this page, so they are the site's own vocabulary rather than
 * something invented for a filter. 'Finished' was the obvious translation for
 * the fourth state and is wrong — a product is rarely finished, it is shipped.
 * 'Paused' over 'on hold', which is what a company says.
 *
 * Ordered roughly by how alive each thing is, not alphabetically.
 */
const STATES = [
  { key: 'all', label: 'All' },
  { key: 'in-progress', label: 'In progress' },
  { key: 'shipped', label: 'Shipped' },
  { key: 'paused', label: 'Paused' },
  { key: 'buried', label: 'Buried' },
] as const;

const filters = STATES.map((s) => ({
  ...s,
  n: s.key === 'all' ? cases.length : cases.filter((c) => c.data.status === s.key).length,
}));

/** Labels for the cards. Same words as the filters, or they are two vocabularies. */
const LABEL: Record<string, string> = Object.fromEntries(
  STATES.filter((s) => s.key !== 'all').map((s) => [s.key, s.label])
);

---

<Base
  title="Work — products I designed and built"
  description="Products I designed or built, alive and dead. The dead ones have post-mortems, which is the part most portfolios leave out."
  schema={[
    {
      '@type': 'CollectionPage',
      name: 'Work',
      description: 'Products designed or built by Sergio Gualda, with post-mortems.',
      /* The cards are images now, so the titles and summaries that used to sit
         under them are gone from the page. They stay here, where a crawler
         still reads what this page is a list of. */
      hasPart: cases.map((c) => ({
        '@type': 'CreativeWork',
        name: c.data.title,
        abstract: c.data.summary,
        url: `${SITE.url}/case-studies/${c.id}/`,
        dateCreated: c.data.year,
      })),
    },
  ]}
>
  <Header slot="nav" />

  <section class="col intro">
    <span class="eyebrow">Work</span>
    <h1>Things I’ve built</h1>
    <p class="sub">
      Products I designed or built, alive and dead. The dead ones have post-mortems, which is
      the part most portfolios leave out.
    </p>
  </section>

  <div class="col">
    <div class="filters rail" role="group" aria-label="Filter by status">
      {
        filters.map((f, i) => (
          <button
            class:list={['chip', { on: i === 0 }]}
            type="button"
            data-filter={f.key}
            aria-pressed={i === 0}
          >
            {f.label} <span>{f.n}</span>
          </button>
        ))
      }
    </div>
    <p class="fcount" id="filterCount" role="status" aria-live="polite"></p>

    <div class="grid" id="grid">
      {
        cases.length
          ? /* Image only. With no visible text the link needs a name of its
               own, or a screen reader announces six links called "image". */
            cases.map((c) => (
              <a
                class="card"
                data-state={c.data.status}
                href={`/case-studies/${c.id}/`}
                aria-label={`${c.data.title} — ${LABEL[c.data.status]} — ${c.data.summary}`}
              >
                {c.data.cover ? (
                  <Image
                    class="thumb"
                    src={c.data.cover}
                    alt={c.data.coverAlt ?? ''}
                    widths={[320, 640, 960]}
                    sizes="(max-width: 560px) calc(100vw - 40px), 272px"
                    loading="lazy"
                    style={`object-position:${c.data.coverPosition}`}
                  />
                ) : (
                  <div class="thumb none"><span>{LABEL[c.data.status]}</span></div>
                )}
                {/* Title and status on every card, at every width.
                    It used to be title-only and phone-only: on desktop the
                    status was visible on the two buried ones and nowhere else,
                    so four of the six were squares that said nothing. The
                    status is the most interesting thing about this portfolio
                    and it was the thing the grid hid. */}
                <span class="name">
                  {c.data.title}
                  <b class="state" data-state={c.data.status}>{LABEL[c.data.status]}</b>
                </span>
              </a>
            ))
          : [0, 1, 2, 3].map(() => <div class="thumb placeholder" aria-hidden="true" />)
      }
    </div>

    {/* Shown by the filter script when a state has nothing in it. Every state
        has at least one project today, so this is for the day one empties —
        a filter that returns silence reads as a broken page. */}
    <p class="none-here" id="noneHere" hidden>
      Nothing here yet. <button type="button" class="linky" data-filter="all">Show everything</button>.
    </p>

    {cases.length === 0 && (
      <p class="empty">Case studies are being written. <a href="/writing/">Read something meanwhile</a>.</p>
    )}
  </div>

  <section class="section col">
    <div class="band">
      <h2>Want to build<br />something together?</h2>
      <p>Tell me where you are and where you want to go.</p>
      <a class="btn btn--on-band" href="/work-with-me/">Hire me</a>
      <p class="fine">A written reply within five working days. No call.</p>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .intro { padding-top: clamp(52px, 9vh, 84px); }

  /* Same chips as /tools/, same rail behaviour: centred while they fit,
     scrolled with faded edges once they do not. */
  .filters { gap: 8px; margin-top: 44px; padding-block: 4px; }
  .filters[data-start='true'][data-end='true'] { justify-content: center; }
  .chip {
    font-family: var(--font-body); font-size: 0.8125rem; font-weight: 500;
    letter-spacing: var(--ls-read);
    padding: 12px 18px; border-radius: var(--radius-pill);
    border: 1px solid var(--hair); background: transparent; color: var(--ink);
    cursor: pointer; white-space: nowrap;
    transition: background 0.2s var(--ease), border-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .chip span { color: var(--dim); margin-left: 2px; }
  .chip:hover { border-color: var(--ink); }
  .chip.on { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .chip.on span { color: color-mix(in srgb, var(--paper) 60%, transparent); }

  .fcount {
    margin-top: var(--space-4);
    font-size: 0.6875rem; letter-spacing: var(--ls-caps); text-transform: uppercase;
    color: var(--dim); min-height: 1em;
  }

  .none-here {
    margin-top: var(--space-8);
    text-align: center;
    color: var(--dim);
    font-size: 1.0625rem;
  }
  .none-here[hidden] { display: none; }
  .linky {
    color: var(--ink); text-decoration: underline; text-underline-offset: 3px;
    text-decoration-color: var(--hair); cursor: pointer; font: inherit;
  }
  .linky:hover { text-decoration-color: var(--ink); }

  /* The status, on every card. Quiet — it labels the work, it is not the work. */
  .state {
    display: block;
    margin-top: 3px;
    font-weight: 400;
    font-size: 0.75rem;
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--dim);
  }
  .state[data-state='buried'] { color: var(--err); }

  .card.in { animation: card-in 0.42s var(--ease) both; animation-delay: calc(var(--d) * 42ms); }
  @keyframes card-in {
    from { opacity: 0; transform: translateY(10px) scale(0.985); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) { .card.in { animation: none; } }

  .intro h1 { margin-bottom: 18px; }



  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 30px; }
  .thumb {
    display: block;
    width: 100%;
    background: var(--surface);
    border-radius: var(--radius-card);
    /* Square, as in the comp. A square crop of a 2304×1271 screenshot shows
       about 55% of its width, anchored left so the navigation and the first
       column survive and the crop falls on the empty right-hand side. */
    aspect-ratio: 1 / 1;
    object-fit: cover;
    /* The covers are screenshots on light interfaces. A hairline stops them
       dissolving into the page in light and floating in dark. */
    border: 1px solid var(--hair);
    transition: opacity 0.28s var(--ease);
  }
  /* The two buried projects have no screenshot, because there is nothing to
     show, which is the whole point of them. A flat grey rectangle read as a
     missing asset; a soft gradient with the status set into a pill reads as a
     decision. Built from --ink, so it follows the theme. */
  .thumb.none {
    display: grid;
    place-items: center;
    background:
      radial-gradient(120% 90% at 20% 10%, color-mix(in srgb, var(--ink) 13%, transparent), transparent 60%),
      radial-gradient(110% 80% at 85% 95%, color-mix(in srgb, var(--ink) 20%, transparent), transparent 55%),
      var(--surface);
  }
  .thumb.none span {
    font-size: 0.6875rem;
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--dim);
    padding: 7px 14px;
    border: 1px solid var(--hair);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--paper) 72%, transparent);
    backdrop-filter: blur(6px);
  }
  .card { text-align: left; display: block; }
  .card:hover .thumb { opacity: 0.82; }

  /* Visible at every width now, not just on a phone. The grid used to rely on
     hover to reveal what a tile was, which leaves a touch screen with six
     unlabelled squares — and hid the status, which is the point of this page. */
  .name {
    display: block;
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: var(--ls-heading);
    color: var(--ink);
  }
  .card[hidden] { display: none; }

  .empty { margin-top: 26px; font-size: 0.9375rem; color: var(--dim); }
  .empty a { text-decoration: underline; text-underline-offset: 3px; }

  .band {
    background: var(--band);
    color: var(--on-band);
    border: 1px solid color-mix(in srgb, var(--on-band) 8%, var(--band));
    border-radius: var(--radius-band);
    padding: clamp(38px, 6vw, 58px) 24px;
  }
  .band h2 { color: var(--on-band); }
  .band p {
    margin-top: 12px;
    font-size: 1rem;
    color: color-mix(in srgb, var(--on-band) 70%, transparent);
  }
  .fine {
    margin-top: 16px;
    font-size: 0.75rem;
    color: color-mix(in srgb, var(--on-band) 55%, transparent);
  }

  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }
</style>


<script>
  import { rails } from '@lib/rail';
  rails();

  /* ── status filter ── */
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const cards = document.querySelectorAll<HTMLElement>('.card');
  const count = document.getElementById('filterCount');
  const none = document.getElementById('noneHere');

  function apply(f: string) {
    chips.forEach((c) => {
      const on = c.dataset.filter === f;
      c.classList.toggle('on', on);
      c.setAttribute('aria-pressed', String(on));
    });

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let shown = 0;
    cards.forEach((card) => {
      const keep = f === 'all' || card.dataset.state === f;
      card.hidden = !keep;
      if (!keep) return;
      if (!reduced) {
        card.style.setProperty('--d', String(Math.min(shown, 6)));
        // Restart the animation: removing and re-adding in one frame is a
        // no-op, so the reflow read forces it.
        card.classList.remove('in');
        void card.offsetWidth;
        card.classList.add('in');
      }
      shown++;
    });

    /**
     * A filter that returns nothing has to say so.
     *
     * Every state has at least one project today, so this is for the day one
     * empties — Paused holds a single project, and it only takes Sergio
     * restarting ecoco for that chip to return silence. An empty grid with no
     * message reads as a page that broke, and the way out is a control the
     * visitor has to work out for themselves.
     */
    if (none) none.hidden = shown > 0;

    if (count) {
      const label = chips2label(f);
      count.textContent =
        f === 'all' ? '' : shown === 1 ? `1 project — ${label}` : `${shown} projects — ${label}`;
    }
  }

  const chips2label = (f: string) =>
    (document.querySelector<HTMLButtonElement>(`.chip[data-filter="${f}"]`)?.firstChild
      ?.textContent ?? '').trim().toLowerCase();

  chips.forEach((chip) => chip.addEventListener('click', () => apply(chip.dataset.filter!)));
  // The way out of an empty state, which is the only reason it is a button.
  none?.querySelector<HTMLButtonElement>('.linky')?.addEventListener('click', () => apply('all'));
</script>
