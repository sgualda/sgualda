---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@layouts/Base.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { SITE } from '@lib/site';

/**
 * /case-studies/ — matches the Figma frame "Work".
 *
 * The grid is driven by the `cases` collection, so it can never disagree with
 * what is on the page. Two of the six have no cover on purpose: they are the
 * buried ones, and there is nothing to show. They get the status set in type
 * instead of a grey rectangle, which reads as a decision rather than a
 * missing asset.
 *
 * Note: the comp says "Burried". Fixed to "Buried".
 */
const cases = (await getCollection('cases', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || b.data.published.valueOf() - a.data.published.valueOf()
);

---

<Base
  title="Work — products I designed and built"
  description="Products I designed or built, alive and dead. The dead ones have post-mortems, which is the part most portfolios leave out."
  schema={[
    {
      '@type': 'CollectionPage',
      name: 'Work',
      description: 'Products designed or built by Sergio Gualda, with post-mortems.',
      /* The cards are images now, so the titles and summaries that used to sit
         under them are gone from the page. They stay here, where a crawler
         still reads what this page is a list of. */
      hasPart: cases.map((c) => ({
        '@type': 'CreativeWork',
        name: c.data.title,
        abstract: c.data.summary,
        url: `${SITE.url}/case-studies/${c.id}/`,
        dateCreated: c.data.year,
      })),
    },
  ]}
>
  <Header slot="nav" />

  <section class="col intro">
    <span class="eyebrow">Work</span>
    <h1>Things I’ve built</h1>
    <p class="sub">
      Products I designed or built, alive and dead. The dead ones have post-mortems, which is
      the part most portfolios leave out.
    </p>
  </section>

  <div class="col">
    <div class="grid" id="grid">
      {
        cases.length
          ? /* Image only. With no visible text the link needs a name of its
               own, or a screen reader announces six links called "image". */
            cases.map((c) => (
              <a class="card" href={`/case-studies/${c.id}/`} aria-label={`${c.data.title} — ${c.data.summary}`}>
                {c.data.cover ? (
                  <Image
                    class="thumb"
                    src={c.data.cover}
                    alt={c.data.coverAlt ?? ''}
                    widths={[320, 640, 960]}
                    sizes="(max-width: 560px) calc(100vw - 40px), 272px"
                    loading="lazy"
                    style={`object-position:${c.data.coverPosition}`}
                  />
                ) : (
                  <div class="thumb none"><span>{c.data.status}</span></div>
                )}
                {/* Visible on a phone only. On desktop the grid is scannable and
                    a hover reveals the link target; on a phone there is no hover
                    and no tooltip, so six unlabelled squares tell a visitor
                    nothing at all about a portfolio. */}
                <span class="name">{c.data.title}</span>
              </a>
            ))
          : [0, 1, 2, 3].map(() => <div class="thumb placeholder" aria-hidden="true" />)
      }
    </div>

    {cases.length === 0 && (
      <p class="empty">Case studies are being written. <a href="/writing/">Read something meanwhile</a>.</p>
    )}
  </div>

  {/*
    The page was 61 words: a heading, one line and six unlabelled squares.

    That fails in two directions. A stranger deciding whether to hire somebody
    cannot tell from a grid of screenshots what kind of problems he takes on. And
    a search engine reading the page has nothing to classify — no context, no
    specialism, nothing that would let it answer "product designer" for anybody.

    Written from what the six projects actually are rather than as positioning:
    two employed, two co-founded, two buried. That pattern is the most useful
    thing about this work and it was the one thing the page did not say.
  */}
  <section class="section col ground">
    <h2>Two vantage points,<br />and two things that died.</h2>
    <p>
      <a href="/case-studies/truvi/">truvi</a> and its
      <a href="/case-studies/truvi-developer-portal/">developer portal</a> are the day job: a SaaS
      dashboard and an API reference, designed inside a real team, with all the negotiation that
      involves and none of the freedom a portfolio shot implies.
      <a href="/case-studies/ecoco-mobile-app/">ecoco</a> and
      <a href="/case-studies/glintale/">glintale</a> are the other side of the desk — two products I
      co-founded and built on evenings and weekends, where nobody hands you a brief and every
      decision is also a decision about money.
    </p>
    <p>
      Most of what I know came from doing both. Working inside somebody else’s roadmap teaches you
      how decisions actually get made; funding your own teaches you what they cost. Reading one
      without the other is how designers end up with strong opinions and no scars.
    </p>
    <p>
      The work is mostly SaaS dashboards, mobile apps and tools built for developers — products with
      a job to do rather than a homepage to admire. Small teams, two to forty people, usually with
      less time than the plan needed.
    </p>
    <p>
      <a href="/case-studies/rangos/">Rangos</a> and
      <a href="/case-studies/weeknotes/">Weeknotes</a> are the two that died, and they are here with
      post-mortems on purpose. A portfolio of things that worked teaches nobody anything, because
      what worked depended on a team, a market and a moment you will never have. What failed is
      more portable.
    </p>
  </section>

  <section class="section col">
    <div class="band">
      <h2>Want to build<br />something together?</h2>
      <p>Tell me where you are and where you want to go.</p>
      <a class="btn btn--on-band" href="/work-with-me/">Hire me</a>
      <p class="fine">A written reply within five working days. No call.</p>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .intro { padding-top: clamp(52px, 9vh, 84px); }

  /* Prose, not a "sub". Four paragraphs at .sub size would shout; this is
     meant to be read, so it takes the reading measure and the reading colour. */
  .ground { text-align: left; }
  .ground h2 { text-align: center; margin-bottom: var(--space-7); }
  .ground p {
    color: var(--dim);
    font-size: 1.0625rem;
    line-height: var(--lh-read);
    letter-spacing: var(--ls-read);
    max-width: 68ch;
    margin-inline: auto;
  }
  .ground p + p { margin-top: var(--space-5); }
  .ground a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--hair);
    transition: text-decoration-color 0.2s var(--ease);
  }
  .ground a:hover { text-decoration-color: var(--ink); }
  .intro h1 { margin-bottom: 18px; }



  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 30px; }
  .thumb {
    display: block;
    width: 100%;
    background: var(--surface);
    border-radius: var(--radius-card);
    /* Square, as in the comp. A square crop of a 2304×1271 screenshot shows
       about 55% of its width, anchored left so the navigation and the first
       column survive and the crop falls on the empty right-hand side. */
    aspect-ratio: 1 / 1;
    object-fit: cover;
    /* The covers are screenshots on light interfaces. A hairline stops them
       dissolving into the page in light and floating in dark. */
    border: 1px solid var(--hair);
    transition: opacity 0.28s var(--ease);
  }
  /* The two buried projects have no screenshot, because there is nothing to
     show, which is the whole point of them. A flat grey rectangle read as a
     missing asset; a soft gradient with the status set into a pill reads as a
     decision. Built from --ink, so it follows the theme. */
  .thumb.none {
    display: grid;
    place-items: center;
    background:
      radial-gradient(120% 90% at 20% 10%, color-mix(in srgb, var(--ink) 13%, transparent), transparent 60%),
      radial-gradient(110% 80% at 85% 95%, color-mix(in srgb, var(--ink) 20%, transparent), transparent 55%),
      var(--surface);
  }
  .thumb.none span {
    font-size: 0.6875rem;
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--dim);
    padding: 7px 14px;
    border: 1px solid var(--hair);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--paper) 72%, transparent);
    backdrop-filter: blur(6px);
  }
  .card { text-align: left; display: block; }
  .card:hover .thumb { opacity: 0.82; }

  .name { display: none; }
  @media (max-width: 560px) {
    .name {
      display: block;
      margin-top: var(--space-3);
      font-family: var(--font-display);
      font-size: 0.9375rem;
      font-weight: 600;
      letter-spacing: var(--ls-heading);
      color: var(--ink);
    }
  }
  .card[hidden] { display: none; }

  .empty { margin-top: 26px; font-size: 0.9375rem; color: var(--dim); }
  .empty a { text-decoration: underline; text-underline-offset: 3px; }

  .band {
    background: var(--band);
    color: var(--on-band);
    border: 1px solid color-mix(in srgb, var(--on-band) 8%, var(--band));
    border-radius: var(--radius-band);
    padding: clamp(38px, 6vw, 58px) 24px;
  }
  .band h2 { color: var(--on-band); }
  .band p {
    margin-top: 12px;
    font-size: 1rem;
    color: color-mix(in srgb, var(--on-band) 70%, transparent);
  }
  .fine {
    margin-top: 16px;
    font-size: 0.75rem;
    color: color-mix(in srgb, var(--on-band) 55%, transparent);
  }

  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }
</style>

