---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@layouts/Base.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { SITE } from '@lib/site';

export async function getStaticPaths() {
  const cases = (await getCollection('cases', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order
  );
  return cases.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, others: cases.filter((c) => c.id !== entry.id).slice(0, 3) },
  }));
}

const { entry, others } = Astro.props as {
  entry: CollectionEntry<'cases'>;
  others: CollectionEntry<'cases'>[];
};
const { Content } = await render(entry);
const d = entry.data;

const STATUS: Record<string, string> = {
  alive: 'Alive',
  shipped: 'Shipped',
  'in-progress': 'In progress',
  buried: 'Buried',
};
---

<Base
  title={`${d.title} — ${d.role}`}
  description={d.description}
  schema={[
    {
      // Article, not CreativeWork: the page is a written account *about* a
      // product, and CreativeWork does not tell a search engine which of the
      // two it is looking at.
      '@type': 'Article',
      headline: d.title,
      name: d.title,
      description: d.description,
      author: { '@id': `${SITE.url}/#person` },
      publisher: { '@id': `${SITE.url}/#person` },
      datePublished: d.published.toISOString(),
      inLanguage: 'en',
      // What the article is *about*. Without this the page is prose with a
      // title; with it, the product is an entity a search engine can hold.
      about: {
        '@type': 'SoftwareApplication',
        name: d.title,
        applicationCategory: 'BusinessApplication',
        creator: { '@id': `${SITE.url}/#person` },
      },
    },
  ]}
>
  <Header slot="nav" />

  <article>
    <header class="col head">
      {/* The project, not its status. Three of the six are "In progress", so the
        status made the breadcrumb identical on three pages and answered a
        question nobody navigating had asked. */}
      <Breadcrumbs items={[{ label: 'Work', href: '/case-studies/' }, { label: d.title }]} />
      <h1>{d.title}</h1>
      <p class="sub">{d.summary}</p>

      <dl class="facts">
        <div><dt>Role</dt><dd>{d.role}</dd></div>
        <div><dt>Where</dt><dd>{d.client}</dd></div>
        <div><dt>When</dt><dd>{d.year}</dd></div>
      </dl>
    </header>

    {
      d.cover && (
        <div class="col">
          <Image
            src={d.cover}
            alt={d.coverAlt ?? ''}
            class="cover"
            widths={[560, 1120]}
            sizes="(max-width: 560px) calc(100vw - 40px), 560px"
            loading="eager"
          />
        </div>
      )
    }

    <div class="col prose">
      <Content />
    </div>
  </article>

  <section class="section col">
    <span class="eyebrow">More</span>
    <h2>Other things<br />I’ve built.</h2>
    {/* The same card as /work/: image only, square, in a rail. Two formats for
        the same object on two pages is how a site stops looking like one site. */}
    <ul class="others rail">
      {
        others.map((c) => (
          <li>
            <a href={`/case-studies/${c.id}/`} aria-label={`${c.data.title} — ${c.data.summary}`}>
              {c.data.cover ? (
                <Image
                  class="thumb"
                  src={c.data.cover}
                  alt={c.data.coverAlt ?? ''}
                  widths={[240, 480]}
                  sizes="236px"
                  sizes="236px"
                  loading="lazy"
                  style={`object-position:${c.data.coverPosition}`}
                />
              ) : (
                <div class="thumb none"><span>{c.data.status}</span></div>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="col next">
    <p class="sub">Recognise any of this in your own product?</p>
    <div class="actions">
      <a class="btn btn--dark" href="/work-with-me/">See if I can help</a>
      <a class="btn btn--ghost" href="/tools/">Run a free check</a>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .head { padding-top: clamp(44px, 8vh, 72px); }
  .head h1 { margin-bottom: 16px; }

  .facts {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 18px; margin-top: 32px; text-align: left;
    padding-top: 26px; border-top: 1px solid var(--hair);
  }
  .facts dt {
    font-size: 0.625rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--dim); margin-bottom: 5px;
  }
  .facts dd { margin: 0; font-size: 0.9375rem; line-height: var(--lh-tight); letter-spacing: var(--ls-read); }


  .cover { width: 100%; border-radius: var(--radius-card); margin-top: var(--space-8); }

  /* Long-form reads left-aligned; the centred treatment stops working past a
     couple of paragraphs. */
  .prose {
    margin-top: 48px; text-align: left;
    font-size: 1.0625rem; line-height: var(--lh-read); letter-spacing: 0; color: var(--dim);
  }
  .prose :global(p) { margin-bottom: 1.2em; }
  .prose :global(h2) {
    color: var(--ink); font-size: clamp(1.3rem, 2.8vw, 1.6rem);
    margin: 2.2em 0 0.7em; letter-spacing: var(--ls-heading);
  }
  .prose :global(strong) { color: var(--ink); font-weight: 600; }
  .prose :global(a) { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .prose :global(a:hover) { opacity: 0.6; }
  .prose :global(img) { width: 100%; border-radius: var(--radius-card); margin: 2.2em 0; }

  .others { list-style: none; text-align: left; margin-top: 34px; padding-block: 4px; }
  .others > li { width: 236px; }
  .others .thumb {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    background: var(--surface);
    border: 1px solid var(--hair);
    border-radius: var(--radius-card);
    transition: opacity 0.28s var(--ease), transform 0.28s var(--ease);
  }
  .others a:hover .thumb { opacity: 0.86; transform: translateY(-2px); }
  .others .thumb.none { display: grid; place-items: center; }
  .others .thumb.none span {
    font-size: 0.6875rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--dim);
  }
  .tag {
    display: inline-block; font-size: 0.625rem; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--dim);
    background: var(--paper); border-radius: var(--radius-pill);
    padding: 5px 11px; margin-bottom: 12px;
  }

  .next { margin-top: var(--gap); padding-top: 44px; border-top: 1px solid var(--hair); }
  .next .actions { margin-top: 22px; }

  @media (max-width: 560px) {
    .facts { grid-template-columns: 1fr; gap: 14px; }
  }
</style>

<script>
  import { rails } from '@lib/rail';
  rails();
</script>
