---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@layouts/Base.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { SITE } from '@lib/site';

export async function getStaticPaths() {
  const cases = (await getCollection('cases', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order
  );
  return cases.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, others: cases.filter((c) => c.id !== entry.id).slice(0, 3) },
  }));
}

const { entry, others } = Astro.props as {
  entry: CollectionEntry<'cases'>;
  others: CollectionEntry<'cases'>[];
};
const { Content } = await render(entry);
const d = entry.data;

const STATUS: Record<string, string> = {
  alive: 'Alive',
  shipped: 'Shipped',
  'in-progress': 'In progress',
  buried: 'Buried',
};
---

<Base
  title={`${d.title} — ${d.role}`}
  description={d.description}
  schema={[
    {
      '@type': 'CreativeWork',
      name: d.title,
      description: d.description,
      author: { '@id': `${SITE.url}/#person` },
      dateCreated: d.year,
    },
  ]}
>
  <Header slot="nav" />

  <article>
    <header class="col head">
      <Breadcrumbs items={[{ label: 'Work', href: '/case-studies/' }, { label: STATUS[d.status] }]} />
      <h1>{d.title}</h1>
      <p class="sub">{d.summary}</p>

      <dl class="facts">
        <div><dt>Role</dt><dd>{d.role}</dd></div>
        <div><dt>Where</dt><dd>{d.client}</dd></div>
        <div><dt>When</dt><dd>{d.year}</dd></div>
      </dl>
    </header>

    {
      d.cover && (
        <div class="col">
          <Image src={d.cover} alt={d.coverAlt ?? ''} class="cover" widths={[560, 1120]} loading="eager" />
        </div>
      )
    }

    <div class="col prose">
      <Content />
    </div>
  </article>

  <section class="section col">
    <span class="eyebrow">More</span>
    <h2>Other things<br />I’ve built.</h2>
    <ul class="others">
      {
        others.map((c) => (
          <li class="card-link">
            <a href={`/case-studies/${c.id}/`}>
              <span class="tag">{STATUS[c.data.status]}</span>
              <h3>{c.data.title}</h3>
              <p>{c.data.summary}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="col next">
    <p class="sub">Recognise any of this in your own product?</p>
    <div class="actions">
      <a class="btn btn--dark" href="/work-with-me/">See if I can help</a>
      <a class="btn btn--ghost" href="/tools/">Run a free check</a>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .head { padding-top: clamp(44px, 8vh, 72px); }
  .head h1 { margin-bottom: 16px; }

  .facts {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 18px; margin-top: 32px; text-align: left;
    padding-top: 26px; border-top: 1px solid var(--hair);
  }
  .facts dt {
    font-size: 0.625rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--dim); margin-bottom: 5px;
  }
  .facts dd { margin: 0; font-size: 0.9375rem; line-height: 1.4; letter-spacing: -0.01em; }


  .cover { width: 100%; border-radius: var(--radius-card); margin-top: var(--space-8); }

  /* Long-form reads left-aligned; the centred treatment stops working past a
     couple of paragraphs. */
  .prose {
    margin-top: 48px; text-align: left;
    font-size: 1.0625rem; line-height: 1.7; letter-spacing: 0; color: var(--dim);
  }
  .prose :global(p) { margin-bottom: 1.2em; }
  .prose :global(h2) {
    color: var(--ink); font-size: clamp(1.3rem, 2.8vw, 1.6rem);
    margin: 2.2em 0 0.7em; letter-spacing: -0.03em;
  }
  .prose :global(strong) { color: var(--ink); font-weight: 600; }
  .prose :global(a) { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .prose :global(a:hover) { opacity: 0.6; }
  .prose :global(img) { width: 100%; border-radius: var(--radius-card); margin: 2.2em 0; }

  .others { list-style: none; text-align: left; margin-top: 34px; display: grid; gap: 14px; }
  .tag {
    display: inline-block; font-size: 0.625rem; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--dim);
    background: var(--paper); border-radius: var(--radius-pill);
    padding: 5px 11px; margin-bottom: 12px;
  }
  .others h3 { font-size: 1rem; margin-bottom: 7px; }
  .others p { font-size: 0.875rem; line-height: 1.5; letter-spacing: 0; color: var(--dim); }

  .next { margin-top: var(--gap); padding-top: 44px; border-top: 1px solid var(--hair); }
  .next .actions { margin-top: 22px; }

  @media (max-width: 560px) {
    .facts { grid-template-columns: 1fr; gap: 14px; }
  }
</style>
