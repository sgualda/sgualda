---
import Base from '@layouts/Base.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Collaborate from '@components/Collaborate.astro';
import { SITE } from '@lib/site';
import { Image } from 'astro:assets';
import portrait from '../../assets/portrait.jpg';

/**
 * When this page last actually changed. Bump it when you edit the copy.
 *
 * It used to be `new Date()`, which meant the ProfilePage schema carried the
 * build timestamp to the millisecond: every build told Google the author page
 * had just been modified, whether or not a word had changed. That is the exact
 * pattern search engines treat as date manipulation, and it also made the build
 * non-deterministic — two builds of identical source produced different bytes,
 * so there was no way to look at a deploy and know what had really changed.
 *
 * Same constant pattern as /privacy/, /legal/ and /now/.
 */
const UPDATED = new Date('2026-08-04');

/**
 * /about/ — matches the Figma frame "About".
 *
 * Note this page is LEFT-aligned, unlike the Home. That is deliberate in the
 * comp: it is one long first-person read, and centred paragraphs would fight it.
 */

const goodAt = [
  {
    title: 'Making the hard thing look easy',
    body: 'The best compliment a product gets is that nobody notices it. That takes throwing away most of what you drew, and it is the part I am actually good at, not adding, removing.',
  },
  {
    title: 'Taking a vague problem to a shipped first version',
    body: 'Somebody describes a mess in a meeting, and six weeks later there is something real in front of a user. Small team, no ceremony. Most of the work on this site comes from here.',
  },
  {
    title: 'Scoping when the deadline is not negotiable',
    body: 'Finding the version that can exist in the time available and still be worth showing. Twice now, six weeks to a working demo — both times by cutting more than felt safe.',
  },
  {
    title: 'Saying the thing nobody in the room wants to say',
    body: 'Usually a version of “we have not checked whether anybody wants this”. It makes meetings longer and quarters shorter, and it is most of what you are actually paying for.',
  },
];

const notFor = [
  {
    title: 'Brand, illustration, motion',
    body: 'I would be competent and somebody else would be good. Paying me for it is paying a premium for competent.',
  },
  {
    title: 'Making a decision you have already made look validated',
    body: 'I will agree with the parts that are right and say the rest out loud, in front of whoever is in the room. If that is inconvenient, hire somebody cheaper — it is a much cheaper way to get the same nothing.',
  },
  {
    title: 'Pushing pixels on a roadmap somebody else wrote',
    body: 'I am genuinely worse at this than the person you can hire full-time, who will be faster, cheaper and closer to the product. This is not modesty. It is a warning about your money.',
  },
  {
    title: 'Being the reason the project is late',
    body: 'I am one person with one client at a time, and I will tell you before we start if the dates do not work. What I will not do is take the project anyway and manage your expectations afterwards.',
  },
];


---

<Base
  title="About — Sergio Gualda, designer and developer in Barcelona"
  description="I’m a designer and developer based in Barcelona, originally from Almeria. I help founders and small teams turn messy ideas into products and sites that work."
  schema={[
    {
      // ProfilePage rather than AboutPage: this is the author page every
      // BlogPosting on the site points at, and ProfilePage is the type Google
      // documents for exactly that. AboutPage describes an organisation.
      '@type': 'ProfilePage',
      name: 'About Sergio Gualda',
      dateModified: UPDATED.toISOString(),
      mainEntity: { '@id': `${SITE.url}/#person` },
    },
  ]}
>
  <Header slot="nav" />

  <article class="col page">
    <Image
      src={portrait}
      alt="Sergio Gualda"
      class="portrait"
      widths={[128, 256]}
      sizes="108px"
      loading="eager"
    />

    <h1>Hello,</h1>

    <div class="bio">
      <p>
        My name is Sergio — most places on the internet, sgualda. I design and build digital
        products, based in Barcelona, originally from Almeria (southern Spain).
      </p>
      <p>
        I’ve always been drawn to understanding how things could be different. As a kid, I was
        more interested in possibilities than instructions. Fascinated by the logic behind how
        things behaved. That same mindset is what led me into product design.
      </p>
      <p>
        The road here was not exactly planned. I started out learning how to build things with
        code. Later, I got into visual work and communication. Somewhere along the way, I
        realized what I really cared about was creating things that make sense to people, things
        that feel good to use and solve real problems.
      </p>
      <p>
        Now I help founders and companies turn messy ideas into clear, usable products. I care
        about flow, simplicity, and making digital experiences feel effortless. If someone
        does not have to think too hard while using something, I’ve done my job right.
      </p>
      <p>
        I believe in being honest, staying curious, and not taking things too seriously. I enjoy
        working with people who are passionate, open to experimenting (and messing up), and who
        see feedback as a way to get better, not as something personal. Bonus points if you can
        make me laugh in the process.
      </p>
    </div>

    {/* The questions people actually type about a person, where, for whom,
        how long — answered in one place. Every figure here is already stated
        somewhere else on the site; none of it is new, it was just never
        gathered where a search engine or a model would look for it. */}
    <dl class="facts">
      <div><dt>Where</dt><dd>Barcelona, CET. Remote across Europe.</dd></div>
      <div><dt>How long</dt><dd>7+ years in product, mostly SaaS and mobile apps.</dd></div>
      <div><dt>Who with</dt><dd>Teams of roughly two to forty people. Founders, and the person who can change the plan.</dd></div>
      <div><dt>What kind of work</dt><dd>Zero-to-one product, scoping under a deadline, and saying the thing nobody in the room wants to say.</dd></div>
      <div><dt>Languages</dt><dd>Spanish and English.</dd></div>
    </dl>

    {/* One column, two halves, and the honest one sits apart.

        This was side-by-side columns, which is the obvious way to lay out a
        comparison and the wrong one here. Two columns inside a 560px reading
        column give about 28 characters a line — less than half a comfortable
        measure — so every four words the eye jumped, four-word headlines broke
        across three lines, and the rows never aligned across the gap, which
        meant it did not even read as a comparison. It read as two unrelated
        lists that happened to be adjacent.

        Full width fixes the measure. The contrast is carried by the surface
        instead: "not good at" is a filled block, set apart from the page the
        way its content is set apart from the pitch. One quiet move, no icons,
        no colour, and the half most people skip is the half that now has an
        edge around it. */}
    <section class="block strengths">
      <div class="half">
        <span class="tag">Good at</span>
        <dl>
          {goodAt.map((x) => (
            <div>
              <dt>{x.title}</dt>
              <dd>{x.body}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="half half--not">
        <span class="tag">Not good at</span>
        <dl>
          {notFor.map((x) => (
            <div>
              <dt>{x.title}</dt>
              <dd>{x.body}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

  </article>

  <Collaborate line="Think we would work well together?" />

  <Footer slot="footer" />
</Base>

<style>
  .page { text-align: left; padding-top: clamp(40px, 7vh, 72px); }

  .portrait {
    width: 108px;
    height: 108px;
    border-radius: var(--radius-sm);
    object-fit: cover;
    margin-bottom: var(--space-7);
  }

  h1 { margin-bottom: 26px; }

  .bio p {
    font-size: var(--fs-body);
    line-height: var(--lh-read);
    letter-spacing: 0;
    color: var(--dim);
  }
  .bio p + p { margin-top: 1.15em; }

  .block { margin-top: clamp(58px, 8vw, 86px); }
  /* Rows, not one two-column grid.
     A `dl` laid out as a single grid puts every dt and dd in its own cell, so
     the row height is set by whichever is taller and the label ends up
     floating against a two-line answer. Each pair gets its own row, and the
     two baselines are matched inside it. */
  .facts {
    margin: var(--space-9) 0;
    padding: var(--space-7) 0;
    border-block: 1px solid var(--hair);
    font-size: var(--fs-sub);
    line-height: var(--lh-read);
    letter-spacing: var(--ls-read);
  }
  .facts > div {
    display: grid;
    grid-template-columns: minmax(0, 34%) 1fr;
    gap: var(--space-5);
    align-items: baseline;
  }
  .facts > div + div { margin-top: var(--space-5); }
  .facts dt { color: var(--dim); }
  .facts dd { margin: 0; }
  @media (max-width: 560px) {
    .facts > div { grid-template-columns: 1fr; gap: var(--space-1); }
  }

  .block h2 { margin-bottom: 26px; }
  .block .lead {
    margin: -14px 0 26px;
    font-size: var(--fs-sub);
    line-height: var(--lh-ui);
    letter-spacing: 0;
    color: var(--dim);
  }

  dl dt {
    font-family: var(--font-display);
    font-size: var(--fs-body);
    font-weight: 600;
    letter-spacing: var(--ls-heading);
    line-height: var(--lh-tight);
    margin-bottom: 8px;
  }
  dl dd {
    font-size: var(--fs-body);
    line-height: var(--lh-ui);
    letter-spacing: 0;
    color: var(--dim);
  }
  /* ── good at / not good at ── */
  .strengths { display: grid; gap: 34px; }

  .tag {
    display: block;
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--dim);
    margin-bottom: var(--space-5);
  }

  .half dl { display: grid; gap: 0; }
  .half dl > div { padding: var(--space-6) 0; border-top: 1px solid var(--hair); }
  .half dl > div:first-of-type { border-top: 0; padding-top: 0; }

  /* The second half is a block, not a column.
     Same rows, same type, one surface — which is the whole difference. */
  .half--not {
    background: var(--surface);
    border-radius: var(--radius-card);
    padding: clamp(24px, 5vw, 38px);
  }
  .half--not dl > div { border-top-color: color-mix(in srgb, var(--ink) 10%, transparent); }
  .half--not dl > div:first-of-type { padding-top: 0; }

  .half dt { margin-bottom: var(--space-3); }
  /* One paragraph size on this page, at a measure somebody can read. */
  .half dd { font-size: var(--fs-sub); line-height: var(--lh-read); max-width: 60ch; }
</style>
