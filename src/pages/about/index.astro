---
import Base from '@layouts/Base.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import NextStep from '@components/NextStep.astro';
import { SITE } from '@lib/site';
import { Image } from 'astro:assets';
import portrait from '../../assets/portrait.jpg';

/**
 * /about/ — matches the Figma frame "About".
 *
 * Note this page is LEFT-aligned, unlike the Home. That is deliberate in the
 * comp: it is one long first-person read, and centred paragraphs would fight it.
 */

const goodAt = [
  {
    title: 'Making the hard thing look easy',
    body: 'The best compliment a product gets is that nobody notices it. That takes throwing away most of what you drew, and it is the part I am actually good at — not adding, removing.',
  },
  {
    title: 'Taking a vague problem to a shipped first version',
    body: 'Somebody describes a mess in a meeting, and six weeks later there is something real in front of a user. Small team, no ceremony. Most of the work on this site comes from here.',
  },
  {
    title: 'Scoping when the deadline is not negotiable',
    body: 'Finding the version that can exist in the time available and still be worth showing. Twice now, six weeks to a working demo — both times by cutting more than felt safe.',
  },
  {
    title: 'Saying the thing nobody in the room wants to say',
    body: 'Usually a version of “we have not checked whether anybody wants this”. It makes meetings longer and quarters shorter, and it is most of what you are actually paying for.',
  },
];

const notFor = [
  {
    title: 'Brand, illustration, motion',
    body: 'I would be competent and somebody else would be good. Paying me for it is paying a premium for competent.',
  },
  {
    title: 'Making a decision you have already made look validated',
    body: 'I will agree with the parts that are right and say the rest out loud, in front of whoever is in the room. If that is inconvenient, hire somebody cheaper — it is a much cheaper way to get the same nothing.',
  },
  {
    title: 'Pushing pixels on a roadmap somebody else wrote',
    body: 'I am genuinely worse at this than the person you can hire full-time, who will be faster, cheaper and closer to the product. This is not modesty. It is a warning about your money.',
  },
  {
    title: 'Being the reason the project is late',
    body: 'I am one person with one client at a time, and I will tell you before we start if the dates do not work. What I will not do is take the project anyway and manage your expectations afterwards.',
  },
];


---

<Base
  title="About — Sergio Gualda, product designer in Barcelona"
  description="I’m a product designer based in Barcelona, originally from Almeria. I help founders and companies turn messy ideas into clear, usable products."
  schema={[
    {
      // ProfilePage rather than AboutPage: this is the author page every
      // BlogPosting on the site points at, and ProfilePage is the type Google
      // documents for exactly that. AboutPage describes an organisation.
      '@type': 'ProfilePage',
      name: 'About Sergio Gualda',
      dateModified: new Date().toISOString(),
      mainEntity: { '@id': `${SITE.url}/#person` },
    },
  ]}
>
  <Header slot="nav" />

  <article class="shell page">
    <Image
      src={portrait}
      alt="Sergio Gualda"
      class="portrait"
      widths={[128, 256]}
      sizes="108px"
      loading="eager"
    />

    <h1>Hello,</h1>

    <div class="bio">
      <p>
        My name is Sergio, and I’m a product designer based in Barcelona, originally from
        Almeria (southern Spain).
      </p>
      <p>
        I’ve always been drawn to understanding how things could be different. As a kid, I was
        more interested in possibilities than instructions. Fascinated by the logic behind how
        things behaved. That same mindset is what led me into product design.
      </p>
      <p>
        The road here was not exactly planned. I started out learning how to build things with
        code. Later, I got into visual work and communication. Somewhere along the way, I
        realized what I really cared about was creating things that make sense to people, things
        that feel good to use and solve real problems.
      </p>
      <p>
        Now I help founders and companies turn messy ideas into clear, usable products. I care
        about flow, simplicity, and making digital experiences feel effortless. If someone
        does not have to think too hard while using something, I’ve done my job right.
      </p>
      <p>
        I believe in being honest, staying curious, and not taking things too seriously. I enjoy
        working with people who are passionate, open to experimenting (and messing up), and who
        see feedback as a way to get better, not as something personal. Bonus points if you can
        make me laugh in the process.
      </p>
    </div>

    {/* The questions people actually type about a person — where, for whom,
        how long — answered in one place. Every figure here is already stated
        somewhere else on the site; none of it is new, it was just never
        gathered where a search engine or a model would look for it. */}
    <dl class="facts">
      <dt>Where</dt><dd>Barcelona, CET. Remote across Europe.</dd>
      <dt>How long</dt><dd>Ten years in product, mostly SaaS and mobile apps.</dd>
      <dt>Who with</dt><dd>Teams of roughly two to forty people. Founders, and the person who can change the plan.</dd>
      <dt>What kind of work</dt><dd>Zero-to-one product, scoping under a deadline, and saying the thing nobody in the room wants to say.</dd>
      <dt>Languages</dt><dd>Spanish and English.</dd>
    </dl>

    <section class="block">
      <h2>What I’m good at.</h2>
      <dl>
        {goodAt.map((x) => (<><dt>{x.title}</dt><dd>{x.body}</dd></>))}
      </dl>
    </section>

    <section class="block">
      <h2>…and what I’m not.</h2>
      <dl class="spaced">
        {notFor.map((x) => (<><dt>{x.title}</dt><dd>{x.body}</dd></>))}
      </dl>
    </section>

  </article>

  <NextStep line="Think we would work well together?" />

  <Footer slot="footer" />
</Base>

<style>
  .page { text-align: left; padding-top: clamp(40px, 7vh, 72px); }

  .portrait {
    width: 108px;
    height: 108px;
    border-radius: var(--radius-sm);
    object-fit: cover;
    margin-bottom: var(--space-7);
  }

  h1 { margin-bottom: 26px; }

  .bio p {
    font-size: 1.0625rem;
    line-height: 1.62;
    letter-spacing: 0;
    color: var(--dim);
  }
  .bio p + p { margin-top: 1.15em; }

  .block { margin-top: clamp(58px, 8vw, 86px); }
  .facts {
    display: grid;
    grid-template-columns: minmax(0, 34%) 1fr;
    gap: var(--space-3) var(--space-5);
    margin: var(--space-9) 0;
    padding: var(--space-7) 0;
    border-block: 1px solid var(--hair);
    font-size: 0.9375rem;
    line-height: 1.55;
    letter-spacing: 0;
  }
  .facts dt { color: var(--dim); }
  .facts dd { margin: 0; }
  @media (max-width: 560px) {
    .facts { grid-template-columns: 1fr; gap: var(--space-1); }
    .facts dd { margin-bottom: var(--space-4); }
  }

  .block h2 { margin-bottom: 26px; }
  .block .lead {
    margin: -14px 0 26px;
    font-size: 0.9375rem;
    line-height: 1.55;
    letter-spacing: 0;
    color: var(--dim);
  }

  dl dt {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.3;
    margin-bottom: 8px;
  }
  dl dd {
    font-size: 1.0625rem;
    line-height: 1.55;
    letter-spacing: 0;
    color: var(--dim);
  }
  dl dd + dt { margin-top: 26px; }
  .spaced dd + dt { margin-top: 34px; }
</style>
