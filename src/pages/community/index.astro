---
import Base from '@layouts/Base.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import NextStep from '@components/NextStep.astro';
import { SITE, SOCIAL } from '@lib/site';

/**
 * /community/ was live on the old WordPress site. Kept as a real page rather
 * than a bare 301 to Substack: a redirect hands the URL's value to a domain
 * that is not ours, and gives the visitor no idea what they are joining.
 *
 * The wall of questions is the whole pitch. A community page that describes
 * itself in adjectives, supportive, high-signal, curated — is describing every
 * community ever made. Showing the actual questions lets somebody decide in
 * three seconds whether these are their people, and it puts twenty real
 * phrasings of product problems into the HTML, which is what anybody looking
 * for a room like this is actually typing into a search box.
 */

/** Two rows, opposite directions. Real shapes of question, not slogans. */
const WALL = [
  [
    'Is this feature worth building or am I just bored?',
    'Nobody used it in week two. Now what?',
    'How do you say no to a founder without losing the client?',
    'Figma file or working prototype for the investor demo?',
    'We shipped and the graph is flat',
    'When do you start charging?',
    'Is my onboarding the problem, or is it the product?',
    'How many users is enough to decide?',
    'Design system now, or in six months?',
    'They said they loved it. They have not opened it since.',
  ],
  [
    'What do you charge for a two-week product review?',
    'Solo founder, no designer — where do I start?',
    'How do you run an interview without leading them?',
    'Our roadmap is a wishlist. How do we cut it?',
    'Is research worth it at ten users?',
    'The CEO redesigned it over the weekend',
    'Do I need a co-founder who can build?',
    'How do you tell a real signal from a polite one?',
    'We have product-market fit. Do we?',
    'Pricing page or waiting list first?',
  ],
];

const TOPICS = [
  {
    h: 'Product design and UX',
    p: 'Flows that lose people, onboarding that does not land, research at the scale you can actually afford. The practical end of it, not the theory.',
  },
  {
    h: 'UI and craft',
    p: 'When polish is the work and when it is procrastination wearing a lanyard. Design systems, components, and whether you need one yet.',
  },
  {
    h: 'Startups and early product',
    p: 'First versions, launches that went quiet, deciding what not to build. Most of the room is two to ten people with less time than the plan needed.',
  },
  {
    h: 'Going out on your own',
    p: 'Rates, scope, saying no, the first client, and the client you should have said no to. Freelancers, consultants and founders in the same thread.',
  },
];

const FAQS = [
  {
    q: 'Who is the community for?',
    a: 'Product designers, founders and people building software alone or in small teams, working through the decisions that do not have a right answer. You bring the thing you are stuck on, and other people tell you what they tried and what it cost them.',
  },
  {
    q: 'Is it free?',
    a: 'Yes. It runs on Substack chat, so joining takes one click if you already have an account and about thirty seconds if you do not. There is no paid tier, no cohort, and nothing to upgrade to.',
  },
  {
    q: 'What gets discussed?',
    a: 'Product design, UX and UI, early-stage startups, discovery and user research, scoping, pricing, freelancing, and the awkward parts of working with founders. Anything with a decision in it. Launch announcements and job posts are the two things that do not belong.',
  },
  {
    q: 'How active is it?',
    a: 'Deliberately quiet. A handful of real conversations a week rather than a firehose you mute in four days. If you want a channel that scrolls faster than you can read it, this is not that.',
  },
  {
    q: 'Where can I find a community for product designers?',
    a: 'There are three shapes worth knowing. Large open Slacks are good for meeting people and bad for getting a specific answer, because volume buries threads. Paid cohorts buy you structure and deadlines and end on a fixed date. Small chats like this one are for one decision you are stuck on, and are useless for networking. Pick by what you actually need this month rather than by size.',
  },
  {
    q: 'Why Substack chat instead of Slack or Discord?',
    a: 'Because it is one login most people already have, it does not add another icon to a dock, and leaving takes one click. Slack and Discord are built to be checked constantly, which is right for a workplace and wrong for a place you visit when you are stuck. The format shapes the behaviour more than the rules do.',
  },
  {
    q: 'How do I get a useful answer instead of sympathy?',
    a: 'Say what you already tried, give one number, say what you would do if nobody replied, and say what kind of answer you want. Most questions in product communities get sympathy because they describe a feeling rather than a decision, and nobody can help with a feeling.',
  },
  {
    q: 'Do you answer questions there yourself?',
    a: 'Often, but as one more person in the room rather than the resident expert. The useful answer usually comes from whoever last had the same problem, and that is rarely me.',
  },
];
---

<Base
  title="A community for product, design and startup people"
  description="A small, quiet chat for product designers, founders and people building software: UX, UI, early-stage decisions, freelancing. Free, on Substack, no launch posts."
  schema={[
    {
      '@type': 'FAQPage',
      '@id': `${SITE.url}/community/#faq`,
      mainEntity: FAQS.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ]}
>
  <Header slot="nav" />

  <section class="col intro">
    <span class="eyebrow">Community</span>
    <h1>Say what is<br />not working.</h1>
    <p class="sub">
      A small chat for product designers, founders and people building software. You bring the
      thing you are stuck on, other people tell you what they tried. That is the whole format.
    </p>
    <div class="actions">
      <a class="btn btn--dark" href={SOCIAL.community} target="_blank" rel="noopener">Join the chat</a>
      <a class="btn btn--ghost" href="/writing/">More essays</a>
    </div>
  </section>

  {/* Full-bleed on purpose: it is the one element on this page allowed out of
      the shell, because a wall has to look like a wall. */}
  <p class="col wall-lab">The kind of thing people ask in there</p>
  <div class="wall" aria-label="The kind of thing people ask in there">
    {
      WALL.map((row, i) => (
        <div class="track" data-dir={i % 2 ? 'right' : 'left'}>
          {/* Doubled so the loop has no seam. The copy is aria-hidden, or a
              screen reader reads all twenty questions twice. */}
          <ul class="row">{row.map((q) => <li>{q}</li>)}</ul>
          <ul class="row" aria-hidden="true">{row.map((q) => <li>{q}</li>)}</ul>
        </div>
      ))
    }
  </div>

  <section class="section col">
    <span class="eyebrow">What gets talked about</span>
    <h2>Four things,<br />and their awkward parts.</h2>
    <dl class="topics">
      {TOPICS.map((t) => (<><dt>{t.h}</dt><dd>{t.p}</dd></>))}
    </dl>
  </section>


  <section class="section col">
    <span class="eyebrow">The only rule</span>
    <h2>How to ask so you<br />get a useful answer.</h2>
    <p class="sub">
      Most questions in product communities get sympathy instead of answers, and it is almost
      always the fault of how they were asked. Four things fix it.
    </p>
    <ol class="how">
      <li>
        <h3>Say what you already tried</h3>
        <p>
          Without it, the first six replies are things you have already ruled out. One line
          about what you tried and why it did not work skips all of them.
        </p>
      </li>
      <li>
        <h3>Give one number</h3>
        <p>
          «Nobody is using it» could be four people or four thousand. «Sixty signed up, eleven
          came back» is a completely different problem, and it is answerable.
        </p>
      </li>
      <li>
        <h3>Say what you would do if nobody replied</h3>
        <p>
          It forces you to name your own default, which is usually where the actual
          disagreement is. Half the time you answer your own question writing this line.
        </p>
      </li>
      <li>
        <h3>Say what kind of answer you want</h3>
        <p>
          A gut reaction, a sanity check, or somebody to argue with you. They are three
          different favours and people give the wrong one when you do not say.
        </p>
      </li>
    </ol>
  </section>

  <section class="section col">
    <span class="eyebrow">Where it sits</span>
    <h2>Compared with<br />the other options.</h2>
    <div class="table-scroll" tabindex="0" role="region" aria-label="Table, scrollable">
      <table>
        <thead>
          <tr><th></th><th>This chat</th><th>A big Slack</th><th>A paid cohort</th></tr>
        </thead>
        <tbody>
          <tr><td>Cost</td><td>Free</td><td>Free</td><td>Hundreds to thousands</td></tr>
          <tr><td>Volume</td><td>A few threads a week</td><td>More than anybody reads</td><td>Fixed, then it ends</td></tr>
          <tr><td>Who answers</td><td>Whoever last had the problem</td><td>Whoever is online</td><td>The person paid to</td></tr>
          <tr><td>Best for</td><td>One decision you are stuck on</td><td>Finding people</td><td>Structure and deadlines</td></tr>
          <tr><td>Worst for</td><td>Networking</td><td>Getting a specific answer</td><td>Anything urgent</td></tr>
        </tbody>
      </table>
    </div>
    <p class="sub small">
      None of these is better than the others. They answer different questions, and the mistake
      is joining the wrong one and concluding that communities do not work.
    </p>
  </section>

  <section class="section col">
    <h2>What it is not.</h2>
    <ul class="nots">
      <li>Not a Slack you will mute in four days.</li>
      <li>Not a place to post your launch.</li>
      <li>Not a course, a cohort, or a funnel with a nice name.</li>
      <li>Not free advice from me on demand — I am in there as one more person.</li>
    </ul>
    <p class="sub small">
      It is on Substack because it is one login you already have, and because if it ever stops
      being useful you can leave in one click. Both of those matter more than they sound.
    </p>
    <div class="actions">
      <a class="btn btn--dark" href={SOCIAL.community} target="_blank" rel="noopener">Join the chat</a>
    </div>
  </section>

  <section class="section col">
    <span class="eyebrow">Questions</span>
    <h2>Before you join.</h2>
    <div class="faq">
      {
        FAQS.map((f) => (
          <details>
            <summary>{f.q}<span class="pm" aria-hidden="true">+</span></summary>
            <div class="ans"><p>{f.a}</p></div>
          </details>
        ))
      }
    </div>
  </section>

  <NextStep
    line="Some questions are too specific for a group chat."
    secondLabel="More essays"
    secondHref="/writing/"
    community={false}
  />

  <Footer slot="footer" />
</Base>

<style>
  .intro { padding-top: clamp(52px, 9vh, 84px); }
  .intro h1 { margin-bottom: 18px; }
  .intro .actions { margin-top: 30px; }

  /* ── the wall ── */
  /* Said out loud rather than only in an aria-label: without it the rows read
     as a live feed of the community, which sets the wrong expectation for what
     you find on the other side of the link. */
  .wall-lab {
    margin-top: clamp(52px, 8vw, 84px);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .wall {
    margin: var(--space-6) 0 clamp(52px, 8vw, 84px);
    display: grid;
    gap: 14px;
    /* Fades into the page at both edges rather than stopping at them, so the
       rows read as a slice of something larger than the screen. */
    mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
    overflow: hidden;
  }
  .track { display: flex; width: max-content; gap: 14px; }
  .track[data-dir='left'] { animation: slide-l 64s linear infinite; }
  .track[data-dir='right'] { animation: slide-r 78s linear infinite; }
  /* Stops so you can actually read one. */
  .wall:hover .track,
  .wall:focus-within .track { animation-play-state: paused; }

  .row { display: flex; gap: 14px; list-style: none; }
  .row li {
    flex: none;
    padding: 13px 20px;
    border: 1px solid var(--hair);
    border-radius: var(--radius-pill);
    background: var(--surface);
    font-size: 0.9375rem;
    letter-spacing: var(--ls-read);
    color: var(--dim);
    white-space: nowrap;
    transition: color 0.24s var(--ease), border-color 0.24s var(--ease);
  }
  .row li:hover { color: var(--ink); border-color: var(--ink); }

  /* Exactly half the doubled track, plus half a gap, so the loop lands on the
     seam and never jumps. */
  @keyframes slide-l {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-50% - 7px)); }
  }
  @keyframes slide-r {
    from { transform: translateX(calc(-50% - 7px)); }
    to { transform: translateX(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; }
    /* Still shows what it is. It just stops moving. */
    .wall { mask-image: linear-gradient(to right, #000 86%, transparent); }
  }

  .topics { text-align: left; margin-top: var(--space-8); }
  .topics dt {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: var(--ls-heading);
    margin-bottom: var(--space-2);
  }
  .topics dd {
    margin: 0 0 var(--space-6);
    font-size: 0.9375rem;
    line-height: var(--lh-read);
    letter-spacing: 0;
    color: var(--dim);
  }

  .how { list-style: none; text-align: left; margin-top: var(--space-8); counter-reset: n; }
  .how li { padding: var(--space-6) 0; border-top: 1px solid var(--hair); counter-increment: n; }
  .how li:last-child { border-bottom: 1px solid var(--hair); }
  .how h3 {
    font-size: 1.0625rem;
    margin-bottom: var(--space-2);
  }
  .how h3::before {
    content: counter(n, decimal-leading-zero);
    display: inline-block;
    min-width: 32px;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: var(--ls-caps);
    color: var(--dim);
    vertical-align: 2px;
  }
  .how p {
    font-size: 0.9375rem;
    line-height: var(--lh-read);
    letter-spacing: var(--ls-read);
    color: var(--dim);
    padding-left: 32px;
  }

  .nots { list-style: none; text-align: left; margin: 34px 0 30px; }
  .nots li {
    position: relative;
    padding: 14px 0 14px 34px;
    font-size: 1.0625rem;
    line-height: var(--lh-ui);
    color: var(--dim);
  }
  .nots li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 21px;
    width: 12px;
    height: 12px;
    background:
      linear-gradient(var(--err), var(--err)) center / 100% 2px no-repeat,
      linear-gradient(var(--err), var(--err)) center / 2px 100% no-repeat;
    rotate: 45deg;
  }
  .nots li + li { border-top: 1px solid var(--hair); }
  .small { font-size: 1rem; }
  .section .actions { margin-top: 28px; }
</style>
