---
import Base from '@layouts/Base.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { TOPICS } from '@lib/topics';

/**
 * /styleguide/ — every token and component in one place, noindex.
 *
 * Without it, each new page reinvents what already exists. That has already
 * happened twice: `.go` ended up defined three times with different sizes,
 * and two card systems grew side by side. Values are read from the live
 * stylesheet at runtime, so this page cannot claim a colour the site does
 * not actually use.
 */

/**
 * `text: true` means the token is used for actual text, so WCAG AA applies.
 * Borders and surfaces are held to 3:1 for non-text contrast at most, and
 * flagging them as failures would train everyone to ignore the flag.
 */
const colours: [string, string, boolean][] = [
  ['--ink', 'Body text, headings', true],
  ['--dim', 'Sub-headings, captions, meta', true],
  ['--surface', 'Cards, fields, placeholders', false],
  ['--hair', 'Every 1px rule', false],
  ['--paper', 'Page background', false],
  ['--inverse', 'Dark bands', false],
];

const type = [
  ['--title-size', 'h1', 'Zalando Sans Expanded 600'],
  ['--h2-size', 'h2', 'Zalando Sans Expanded 700'],
  ['--h3-size', 'h3', 'Zalando Sans Expanded 600'],
  ['--sub-size', '.sub', 'Archivo 400'],
  ['--text-size', 'body', 'Archivo 400'],
];
---

<Base title="Styleguide" description="Design tokens and components for sgualda.com." noindex={true}>
  <Header slot="nav" />

  <section class="col intro">
    <span class="eyebrow">Internal</span>
    <h1>Styleguide</h1>
    <p class="sub">
      Every token and every component state. Not indexed, not linked from the site. If you’re
      building a page and the thing you need is not here, add it here first.
    </p>
  </section>

  <div class="wide sg">
    <section>
      <h2>Colour</h2>
      <p class="hint">Contrast is measured live against the page background.</p>
      <ul class="swatches">
        {
          colours.map(([token, use, isText]) => (
            <li>
              <span class="chip" style={`background: var(${token})`} data-token={token}></span>
              <code>{token}</code>
              <span class="val" data-val={token}>—</span>
              <span class="ratio" data-ratio={token} data-text={String(isText)}>—</span>
              <span class="use">{use}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2>Type</h2>
      <ul class="typelist">
        {
          type.map(([token, tag, family]) => (
            <li>
              <span class="meta"><code>{token}</code> · {family} · <span data-val={token}>—</span></span>
              {tag === 'h1' && <h1>Making things is no longer the hard part</h1>}
              {tag === 'h2' && <h2>Three things I’m fairly sure of</h2>}
              {tag === 'h3' && <h3>Enthusiasm is not demand</h3>}
              {tag === '.sub' && <p class="sub" style="margin:0;max-width:none">The only signal that means anything is somebody using the thing a second time.</p>}
              {tag === 'body' && <p>Anyone can produce a screen. Almost nobody can say why that one and not another.</p>}
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2>Buttons</h2>
      <p class="hint">Every state, including the ones easy to forget.</p>
      <div class="row">
        <a class="btn btn--dark" href="#0">Dark</a>
        <a class="btn btn--ghost" href="#0">Ghost</a>
        <button class="btn btn--dark" disabled>Disabled</button>
        <button class="btn btn--ghost" disabled>Disabled ghost</button>
      </div>
      <p class="hint">Tab to them: focus is a double ring, readable on light and dark.</p>
      <div class="row dark-strip">
        <a class="btn btn--dark inv" href="#0">On a dark band</a>
      </div>
    </section>

    <section>
      <h2>Card</h2>
      <p class="hint">One component, <code>.card-link</code>. Hover for the animated ring.</p>
      <ul class="cards">
        <li class="card-link">
          <a href="#0">
            <h3>Why is nobody using your product?</h3>
            <p>Which of the five you’re in, and the cheap test that confirms it.</p>
          </a>
        </li>
        <li class="card-link">
          <a href="#0">
            <h3>Can you charge for this yet?</h3>
            <p>Whether you’re ready, and what to fix first if you’re not.</p>
          </a>
        </li>
      </ul>
    </section>

    <section>
      <h2>Chips</h2>
      <ul class="chips">
        {TOPICS.map((t) => <li><a href="#0">{t.label}</a></li>)}
      </ul>
    </section>

    <section>
      <h2>Form fields</h2>
      <p class="hint">Left-aligned by rule, even though everything else is centred.</p>
      <div class="f"><label for="sg1">Label</label><input id="sg1" placeholder="Placeholder" /></div>
      <div class="f"><label for="sg2">Focused</label><input id="sg2" value="Tab into this one" /></div>
      <div class="f"><label for="sg3">Textarea</label><textarea id="sg3" placeholder="Two paragraphs is plenty."></textarea></div>
      <p class="formErr" role="alert">This is the error state. It sits above the buttons so it cannot be missed.</p>
    </section>

    <section>
      <h2>Question and answer</h2>
      <p class="hint">Shared by the checks and the qualifier.</p>
      <div class="panel">
        <div class="dots"><i class="on"></i><i></i><i></i></div>
        <p class="qq">What happens when somebody lands on your page?</p>
        <button class="opt" type="button">They land and leave within seconds<em>The most common answer.</em></button>
        <button class="opt" type="button">They sign up, then stop</button>
      </div>
    </section>

    <section>
      <h2>FAQ</h2>
      <div class="faq">
        <details open>
          <summary>Are these really free?<span class="pm">+</span></summary>
          <div class="ans"><p>Yes. No account, no email, no trial that turns into something.</p></div>
        </details>
        <details>
          <summary>Where do my answers go?<span class="pm">+</span></summary>
          <div class="ans"><p>Nowhere. Everything runs in your browser.</p></div>
        </details>
      </div>
    </section>

    <section>
      <h2>Layout</h2>
      <p class="hint">
        One shell for everything: header, footer, sections and bands. The map diagram is the
        single documented exception.
      </p>
      <div class="shellbox"><span data-val="--shell">—</span></div>
    </section>
  </div>

  <Footer slot="footer" />
</Base>

<style>
  .intro { padding-top: clamp(44px, 8vh, 72px); }
  .sg { text-align: left; }
  .sg > section { margin-top: var(--gap); padding-top: 34px; border-top: 1px solid var(--hair); }
  .sg h2 { margin-bottom: 8px; }
  .hint { font-size: 0.9375rem; letter-spacing: 0; color: var(--dim); margin-bottom: 26px; }
  code {
    font-family: var(--font-mono); font-size: 0.8125rem;
    background: var(--surface); padding: 2px 6px; border-radius: 5px;
  }

  .swatches { list-style: none; display: grid; gap: 10px; }
  .swatches li {
    display: grid; grid-template-columns: 44px 130px 90px 70px 1fr;
    gap: 14px; align-items: center; font-size: 0.875rem; letter-spacing: 0;
  }
  .chip { width: 44px; height: 44px; border-radius: 10px; border: 1px solid var(--hair); }
  .val, .ratio { font-family: var(--font-mono); font-size: 0.75rem; color: var(--dim); }
  .ratio[data-fail='true'] { color: #b00; font-weight: 600; }
  .use { color: var(--dim); }

  .typelist { list-style: none; display: grid; gap: 34px; }
  .typelist .meta {
    display: block; font-size: 0.75rem; letter-spacing: 0.06em;
    color: var(--dim); margin-bottom: 10px;
  }

  .row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-bottom: 20px; }
  .btn[disabled] { opacity: 0.4; pointer-events: none; }
  .dark-strip {
    background: var(--inverse); padding: 24px; border-radius: var(--radius-card);
  }
  .dark-strip .inv { background: var(--paper); color: var(--ink); border-color: var(--paper); }

  .cards { list-style: none; display: grid; gap: 14px; }
  .cards h3 { font-size: 1rem; margin-bottom: 8px; }
  .cards p { font-size: 0.875rem; line-height: 1.5; letter-spacing: 0; color: var(--dim); }

  .chips { list-style: none; display: flex; gap: 8px; flex-wrap: wrap; }
  .chips a {
    display: block; padding: 9px 18px; border-radius: var(--radius-pill);
    border: 1px solid var(--hair); font-size: 0.8125rem; font-weight: 500; letter-spacing: -0.01em;
  }
  .chips a:hover { border-color: var(--ink); }

  .panel {
    background: var(--paper); border: 1px solid var(--hair);
    border-radius: var(--radius-card); padding: 30px;
  }
  .shellbox {
    background: var(--surface); border-radius: var(--radius-card);
    padding: 26px; text-align: center; font-family: var(--font-mono); font-size: 0.8125rem;
    color: var(--dim); width: var(--shell); max-width: 100%;
  }

  @media (max-width: 620px) {
    .swatches li { grid-template-columns: 44px 1fr; }
    .swatches .val, .swatches .ratio, .swatches .use { grid-column: 2; }
  }
</style>

<script>
  /* Read the values from the live stylesheet rather than repeating them here,
     so this page cannot claim a token the site does not actually use. */
  const cs = getComputedStyle(document.documentElement);

  const luminance = (hex: string) => {
    const m = hex.trim().match(/^#?([\da-f]{6})$/i);
    if (!m) return null;
    const [r, g, b] = [0, 2, 4].map((i) => parseInt(m[1].slice(i, i + 2), 16) / 255);
    const f = (c: number) => (c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);
    return 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(b);
  };

  const toHex = (v: string) => {
    const m = v.match(/rgba?\(([^)]+)\)/);
    if (!m) return v.trim();
    const [r, g, b] = m[1].split(',').map((n) => Number(n.trim()));
    return '#' + [r, g, b].map((n) => n.toString(16).padStart(2, '0')).join('');
  };

  document.querySelectorAll<HTMLElement>('[data-val]').forEach((el) => {
    const raw = cs.getPropertyValue(el.dataset.val!).trim();
    el.textContent = raw.startsWith('rgb') ? toHex(raw) : raw;
  });

  const paperL = luminance(toHex(cs.getPropertyValue('--paper')));
  document.querySelectorAll<HTMLElement>('[data-ratio]').forEach((el) => {
    const l = luminance(toHex(cs.getPropertyValue(el.dataset.ratio!)));
    if (l === null || paperL === null) return;
    const ratio = (Math.max(l, paperL) + 0.05) / (Math.min(l, paperL) + 0.05);
    el.textContent = ratio.toFixed(2) + ':1';
    // Only text tokens are held to 4.5:1. Flagging borders and surfaces as
    // failures would teach everyone to ignore the flag.
    el.dataset.fail = String(el.dataset.text === 'true' && ratio < 4.5);
    if (el.dataset.text !== 'true') el.title = 'Non-text token — AA does not apply';
  });
</script>
