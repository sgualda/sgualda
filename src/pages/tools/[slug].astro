---
import Base from '@layouts/Base.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { TOOLS, CATS, type Tool } from '@lib/tools';
import { SITE } from '@lib/site';
import '@styles/quiz.css';

export function getStaticPaths() {
  return TOOLS.map((t) => ({ params: { slug: t.slug }, props: { t } }));
}

const { t } = Astro.props as { t: Tool };
const url = `${SITE.url}/tools/${t.slug}/`;

/**
 * A dedicated landing per tool. The check itself is the interactive part; the
 * FAQs are server-rendered, which is what a crawler that does not run
 * JavaScript actually sees on these pages.
 */
---

<Base
  title={t.title}
  description={t.meta}
  schema={[
    {
      '@type': 'WebApplication',
      name: t.n,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web browser',
      url,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
      description: t.lead,
      author: { '@id': `${SITE.url}/#person` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
        { '@type': 'ListItem', position: 2, name: 'Tools', item: `${SITE.url}/tools/` },
        { '@type': 'ListItem', position: 3, name: t.n },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: t.faqs.map(([q, a]) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ]}
>
  <Header slot="nav" />

  <section class="col intro">
    <p class="crumb"><a href="/tools/">Tools</a> · {CATS[t.cat]}</p>
    <h1>{t.n}</h1>
    <p class="sub">{t.lead}</p>
  </section>

  <div class="col">
    <div class="panel">
      <div class="dots" id="dots">{t.q.map(() => <i></i>)}</div>
      <div id="box"></div>
      {/* Only this tool's data, not all six. See #Q-077. */}
      <script
        type="application/json"
        id="tool-data"
        set:html={JSON.stringify({ q: t.q, b: t.b })}
      />
    </div>
    <p class="aside">
      Everything runs in your browser. Nothing is sent anywhere, and the answer gets its own link you can send to your team.
    </p>
  </div>

  <section class="section col">
    <span class="eyebrow">Questions</span>
    <h2>About this check.</h2>
    <div class="faq">
      {
        t.faqs.map(([q, a]) => (
          <details>
            <summary>{q}<span class="pm">+</span></summary>
            <div class="ans"><p>{a}</p></div>
          </details>
        ))
      }
      <details>
        <summary>Is it free, and where do my answers go?<span class="pm">+</span></summary>
        <div class="ans">
          <p>
            Free, with no account and no email. Everything runs in your browser — nothing is
            sent to a server, nothing is stored, and I never see what you clicked.
          </p>
        </div>
      </details>
    </div>
  </section>

  <section class="section col">
    <span class="eyebrow">More</span>
    <h2>Other checks.</h2>
    <ul class="more">
      {
        TOOLS.filter((o) => o.id !== t.id).slice(0, 3).map((o) => (
          <li class="card-link">
            <a href={`/tools/${o.slug}/`}>
              <h3>{o.n}</h3>
              <p>{o.out}</p>
              <span class="go">Start the check <i aria-hidden="true">→</i></span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="actions" style="margin-top:30px">
      <a class="btn btn--ghost" href="/tools/">See all checks</a>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .intro { padding-top: clamp(44px, 8vh, 72px); }
  .crumb {
    font-size: 0.6875rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--dim); margin-bottom: 18px;
  }
  .crumb a:hover { color: var(--ink); }
  .intro h1 { font-size: clamp(1.75rem, 4.2vw, 2.5rem); margin-bottom: 18px; }
  .panel {
    margin-top: 32px; background: var(--paper);
    border: 1px solid var(--hair); border-radius: var(--radius-card);
    padding: clamp(26px, 5vw, 38px) clamp(20px, 4vw, 30px);
  }
  .aside { margin-top: 14px; font-size: 0.8125rem; color: var(--dim); letter-spacing: 0; }


  .more { list-style: none; text-align: left; margin-top: 34px; display: grid; gap: 14px; }
  .more h3 { font-size: 1rem; margin-bottom: 8px; }
  .more p { font-size: 0.875rem; line-height: 1.5; letter-spacing: 0; color: var(--dim); margin-bottom: 18px; }
  .go {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 0.875rem; font-weight: 500; letter-spacing: -0.01em; color: var(--ink);
  }
  .go i { font-style: normal; transition: transform 0.3s var(--ease); }
  .card-link:hover .go i { transform: translateX(5px); }
</style>

<script>
  type Bucket = { max: number; name: string; sub: string; body: string; next: string[] };
  type Data = { q: [string, [string, number][]][]; b: Bucket[] };

  import { celebrate, settle } from '@lib/feedback';

  const $ = (id: string) => document.getElementById(id)!;
  const t: Data = JSON.parse($('tool-data').textContent!);

  /**
   * Answers live in the hash: #a=0,2,4
   *
   * That gives every result a URL you can send to your team — which is the
   * point of these, and the page says so itself — and it makes the browser
   * back button walk back through the questions instead of leaving the site.
   * Nothing is sent anywhere: a hash never reaches a server.
   */
  let answers: number[] = [];

  const readHash = (): number[] => {
    const m = location.hash.match(/a=([\d,]*)/);
    if (!m || !m[1]) return [];
    return m[1]
      .split(',')
      .filter(Boolean)
      .map(Number)
      .filter((n, i) => Number.isInteger(n) && n >= 0 && n < (t.q[i]?.[1].length ?? 0))
      .slice(0, t.q.length);
  };

  const writeHash = (next: number[], push: boolean) => {
    const url = next.length ? `#a=${next.join(',')}` : location.pathname;
    if (push) history.pushState({ a: next }, '', url);
    else history.replaceState({ a: next }, '', url);
  };

  const setDots = (i: number) =>
    $('dots').querySelectorAll('i').forEach((d, k) => d.classList.toggle('on', k <= i));

  function render() {
    const at = answers.length;
    at < t.q.length ? ask(at) : result();
  }

  function ask(at: number) {
    setDots(at);
    const [q, opts] = t.q[at];
    $('box').innerHTML =
      `<div class="step">` +
      (at > 0 ? `<button class="back" type="button" id="back">← Back</button>` : '') +
      `<span class="eyebrow">Question ${at + 1} of ${t.q.length}</span>` +
      `<p class="qq">${q}</p>` +
      opts.map(([label], i) => `<button class="opt" type="button" data-i="${i}">${label}</button>`).join('') +
      `</div>`;

    $('box').querySelectorAll<HTMLButtonElement>('.opt').forEach((b) =>
      b.addEventListener('click', () => {
        answers = [...answers, Number(b.dataset.i)];
        writeHash(answers, true);
        render();
      })
    );
    document.getElementById('back')?.addEventListener('click', () => history.back());
  }

  function result() {
    setDots(t.q.length);
    const score = answers.reduce((sum, choice, i) => sum + (t.q[i][1][choice]?.[1] ?? 0), 0);
    const r = t.b.find((x) => score <= x.max) ?? t.b[t.b.length - 1];

    $('box').innerHTML =
      `<div class="step" role="status" aria-live="polite">` +
      `<span class="vlab">Your answer</span><p class="vname">${r.name}</p>` +
      `<p class="vnote" style="text-align:center;margin:10px 0 22px">${r.sub}</p>` +
      `<div class="vwhy">${r.body}</div>` +
      `<div class="vcols" style="grid-template-columns:1fr"><div><h4>What I would do next</h4><ul>` +
      r.next.map((n) => `<li>${n}</li>`).join('') +
      `</ul></div></div>` +
      `<p class="vnote">${t.q.length} questions cannot know your product. Treat this as a strong ` +
      `opinion from somebody who has made the same call.</p>` +
      `<div class="vacts">` +
      `<a class="btn btn--dark" href="/work-with-me/">See if I can help</a>` +
      `<button class="btn btn--ghost" type="button" id="share">Copy link to this answer</button>` +
      `</div>` +
      `<button class="again" type="button" id="again">Run it again</button></div>`;

    // The first bucket is the good news, the last is the expensive one.
    // Anything between gets no reaction: a shrug is not an event.
    const panel = document.querySelector('.panel');
    if (r === t.b[0]) celebrate(panel);
    else if (r === t.b[t.b.length - 1]) settle(panel);

    $('again').addEventListener('click', () => {
      answers = [];
      writeHash(answers, true);
      render();
    });

    $('share').addEventListener('click', async () => {
      const btn = $('share');
      try {
        await navigator.clipboard.writeText(location.href);
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = location.href;
      }
      setTimeout(() => (btn.textContent = 'Copy link to this answer'), 2200);
    });
  }

  // Back and forward both just re-read the hash.
  addEventListener('popstate', () => {
    answers = readHash();
    render();
  });

  answers = readHash();
  writeHash(answers, false);
  render();
</script>
