---
import { getCollection } from 'astro:content';
import Base from '@layouts/Base.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { getTools, CATS, type Tool } from '@lib/content';
import { SITE } from '@lib/site';
import '@styles/quiz.css';

export async function getStaticPaths() {
  const tools = await getTools();
  return tools.map((t) => ({ params: { slug: t.slug }, props: { t, tools } }));
}

const { t, tools } = Astro.props as { t: Tool; tools: Tool[] };
const url = `${SITE.url}/tools/${t.slug}/`;

/**
 * A dedicated landing per tool. The check itself is the interactive part; the
 * FAQs are server-rendered, which is what a crawler that does not run
 * JavaScript actually sees on these pages.
 */
const terms = (await getCollection('glossary'))
  .filter((g) => g.data.tool === t.slug)
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<Base
  title={t.title}
  description={t.meta}
  schema={[
    {
      '@type': 'WebApplication',
      name: t.n,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web browser',
      url,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
      description: t.lead,
      author: { '@id': `${SITE.url}/#person` },
    },
    {
      '@type': 'FAQPage',
      mainEntity: t.faqs.map(([q, a]) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ]}
>
  <Header slot="nav" />

  <section class="col intro">
    <Breadcrumbs items={[{ label: 'Tools', href: '/tools/' }, { label: CATS[t.cat] }]} />
    <h1>{t.n}</h1>
    <p class="sub">{t.lead}</p>
  </section>

  <div class="col">
    <div class="panel">
      <div class="dots" id="dots" role="presentation">{t.q.map(() => <i></i>)}</div>
      {/* The panel rewrites itself on every answer. Without a live region a
          screen reader user hears nothing change and loses their place. */}
      <div id="box" role="status" aria-live="polite" aria-atomic="true"></div>
      {/* Only this tool’s data, not all six. See #Q-077. */}
      <script
        type="application/json"
        id="tool-data"
        set:html={JSON.stringify({ q: t.q, b: t.b })}
      />
    </div>
    <p class="aside">
      Everything runs in your browser. Nothing is sent anywhere, and the answer gets its own link you can send to your team.
    </p>
  </div>

  <section class="section col">
    <span class="eyebrow">Questions</span>
    <h2>About this check.</h2>
    <div class="faq">
      {
        t.faqs.map(([q, a]) => (
          <details>
            <summary>{q}<span class="pm" aria-hidden="true">+</span></summary>
            <div class="ans"><p>{a}</p></div>
          </details>
        ))
      }
      <details>
        <summary>Is it free, and where do my answers go?<span class="pm" aria-hidden="true">+</span></summary>
        <div class="ans">
          <p>
            Free, with no account and no email. Everything runs in your browser — nothing is
            sent to a server, nothing is stored, and I never see what you clicked.
          </p>
        </div>
      </details>
    </div>
  </section>

  <section class="section col">
    <span class="eyebrow">More</span>
    <h2>Other checks.</h2>
    <ul class="more">
      {
        tools.filter((o) => o.slug !== t.slug).slice(0, 3).map((o) => (
          <li class="card-link">
            <a href={`/tools/${o.slug}/`}>
              <h3>{o.n}</h3>
              <p>{o.out}</p>
              <span class="arrow-link">Start the check <i aria-hidden="true">→</i></span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="actions" style="margin-top:30px">
      <a class="btn btn--ghost" href="/tools/">See all checks</a>
    </div>
  </section>


  {terms.length > 0 && (
    <section class="section col">
      <span class="eyebrow">Vocabulary</span>
      <h2>Words this check uses.</h2>
      <dl class="terms-inline">
        {terms.map((g) => (
          <div>
            <dt><a href={`/glossary/#${g.id}`}>{g.data.name}</a></dt>
            <dd>{g.data.definition}</dd>
          </div>
        ))}
      </dl>
    </section>
  )}

  <Footer slot="footer" />
</Base>

<style>
  .intro { padding-top: clamp(44px, 8vh, 72px); }
  .intro h1 { font-size: clamp(1.75rem, 4.2vw, 2.5rem); margin-bottom: 18px; }
  .panel {
    margin-top: 32px; background: var(--paper);
    border: 1px solid var(--hair); border-radius: var(--radius-card);
    padding: clamp(26px, 5vw, 38px) clamp(20px, 4vw, 30px);
  }
  .aside { margin-top: 14px; font-size: 0.8125rem; color: var(--dim); letter-spacing: 0; }


  .more { list-style: none; text-align: left; margin-top: 34px; display: grid; gap: 14px; }
  .more h3 { font-size: 1rem; margin-bottom: 8px; }
  .more p { font-size: 0.875rem; line-height: 1.5; letter-spacing: 0; color: var(--dim); margin-bottom: 18px; }
</style>

<script>
  import { createQuiz, type Question } from '@lib/quiz';
  import { celebrate, settle } from '@lib/feedback';

  type Bucket = { max: number; name: string; sub: string; body: string; next: string[] };
  type Data = { q: [string, [string, number][]][]; b: Bucket[] };

  const $ = (id: string) => document.getElementById(id)!;
  const t: Data = JSON.parse($('tool-data').textContent!);

  const questions: Question[] = t.q.map(([text, options], i) => ({
    key: String(i),
    text,
    options: options.map(([label, value]) => ({ label, value })),
  }));

  createQuiz<Bucket>({
    questions,
    box: $('box'),
    dots: $('dots'),
    syncHash: true,

    resolve(answers) {
      const score = answers.reduce((sum, a) => sum + Number(a.value), 0);
      return t.b.find((x) => score <= x.max) ?? t.b[t.b.length - 1];
    },

    renderQuestion: (q, i, total) =>
      `<div class="step">` +
      (i > 0 ? `<button class="back" type="button" data-quiz-back>← Back</button>` : '') +
      `<span class="eyebrow">Question ${i + 1} of ${total}</span>` +
      `<h2 class="qq" data-quiz-head tabindex="-1">${q.text}</h2>` +
      q.options.map((o, n) => `<button class="opt" type="button" data-quiz-opt="${n}">${o.label}</button>`).join('') +
      `</div>`,

    renderVerdict: (r) =>
      `<div class="step">` +
      `<span class="vlab">Your answer</span>` +
      `<h2 class="vname" data-quiz-head tabindex="-1">${r.name}</h2>` +
      `<p class="vnote" style="text-align:center;margin:10px 0 22px">${r.sub}</p>` +
      `<div class="vwhy">${r.body}</div>` +
      `<div class="vcols" style="grid-template-columns:1fr"><div><h4>What I would do next</h4><ul>` +
      r.next.map((n) => `<li>${n}</li>`).join('') +
      `</ul></div></div>` +
      `<p class="vnote">${questions.length} questions cannot know your product. Treat this as a ` +
      `strong opinion from somebody who has made the same call.</p>` +
      `<div class="vacts">` +
      `<a class="btn btn--dark" href="/work-with-me/">See if I can help</a>` +
      `<button class="btn btn--ghost" type="button" id="share">Copy link to this answer</button>` +
      `</div><button class="again" type="button" data-quiz-restart>Run it again</button></div>`,

    onRender({ verdict }) {
      if (!verdict) return;

      const panel = document.querySelector('.panel');
      if (verdict === t.b[0]) celebrate(panel);
      else if (verdict === t.b[t.b.length - 1]) settle(panel);

      document.getElementById('share')?.addEventListener('click', async () => {
        const btn = $('share');
        try {
          await navigator.clipboard.writeText(location.href);
          btn.textContent = 'Copied';
        } catch {
          btn.textContent = location.href;
        }
        setTimeout(() => (btn.textContent = 'Copy link to this answer'), 2200);
      });
    },
  });
</script>

<style>
  .terms-inline { text-align: left; margin-top: var(--space-6); }
  .terms-inline > div { padding: var(--space-5) 0; }
  .terms-inline > div + div { border-top: 1px solid var(--hair); }
  .terms-inline dt {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-2);
  }
  .terms-inline dt a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .terms-inline dt a:hover { opacity: 0.6; }
  .terms-inline dd {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    letter-spacing: 0;
    color: var(--dim);
  }
</style>
