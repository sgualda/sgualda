---
import Base from '@layouts/Base.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { INDEX_FAQ_HTML } from '@lib/tools';
import { getTools, CATS } from '@lib/content';

const TOOLS = await getTools();

/** /tools/ — matches the Figma frame "Tools". */

const cats = [
  { key: 'all', label: 'All', n: TOOLS.length },
  ...Object.entries(CATS).map(([key, label]) => ({
    key,
    label,
    n: TOOLS.filter((t) => t.cat === key).length,
  })),
];

// FAQPage schema derived from the rendered markup, so the two cannot drift.
const faqs = [...INDEX_FAQ_HTML.matchAll(/<summary>([\s\S]*?)<span class="pm">[\s\S]*?<div class="ans">([\s\S]*?)<\/div>/g)].map(
  (m) => ({
    q: m[1].replace(/<[^>]+>/g, '').trim(),
    a: m[2].replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim(),
  })
);
---

<Base
  title="Tools — free checks on your product"
  description="Six free checks: why nobody is using your product, whether that feedback was real, if a feature is worth building, and whether you can charge yet."
  schema={[
    {
      '@type': 'ItemList',
      name: 'Free product tools',
      numberOfItems: TOOLS.length,
      itemListElement: TOOLS.map((t, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `https://sgualda.com/tools/${t.slug}/`,
        item: {
          '@type': 'WebApplication',
          name: t.n,
          applicationCategory: 'BusinessApplication',
          operatingSystem: 'Web browser',
          offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
          description: t.lead,
        },
      })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ]}
>
  <Header slot="nav" />

  <section class="col intro">
    <span class="eyebrow">Tools</span>
    <h1>Six checks,<br />one decision.</h1>
    <p class="sub">
      Pick the one that matches what you’re stuck on. Each asks you a few multiple-choice
      questions and gives you a straight answer, not a score, not a report you have to interpret.
    </p>
  </section>

  <div class="col">
    <div class="filters rail" role="group" aria-label="Filter by topic">
      {
        cats.map((c, i) => (
          <button class:list={['chip', { on: i === 0 }]} type="button" data-filter={c.key} aria-pressed={i === 0}>
            {c.label} <span>{c.n}</span>
          </button>
        ))
      }
    </div>
    <p class="fcount" id="filterCount" role="status" aria-live="polite"></p>

    {/* The same rows as /writing/ and /map/.
        These were filled cards with pills on top and no arrow, which made the
        third list of clickable things on this site look like a third kind of
        object. What is actually different about a check is what it costs you
        to run one, so that is what the meta line says. */}
    <ol class="rows cards">
      {
        TOOLS.map((t) => (
          <li class="card" data-cat={t.cat}>
            <a href={`/tools/${t.slug}/`}>
              <span class="r-meta">{t.time} · {t.count}</span>
              <span class="r-title">{t.n}</span>
              <span class="r-note">{t.lead}</span>
              <span class="r-go" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>

  <section class="section col">
    <span class="eyebrow">Questions</span>
    <h2>Before you start.</h2>
    <div class="faq" set:html={INDEX_FAQ_HTML} />
  </section>

  <Footer slot="footer" />
</Base>


<style>
  /* The list is `.rows` from base.css; only its top margin is local. */
  .cards { margin-top: 34px; }

  .intro { padding-top: clamp(52px, 9vh, 84px); }
  .intro h1 { margin-bottom: 18px; }

  /* A rail rather than a wrapped row. Five chips wrapped onto two lines put a
     single centred pill on its own row, which reads as an error. Scrolling
     keeps them on one line at any width and the fade says there is more. */
  .filters { gap: 8px; margin-top: 54px; padding-block: 4px; }
  /* Centred while they fit, scrolled once they do not. */
  .filters[data-start='true'][data-end='true'] { justify-content: center; }
  .chip {
    font-family: var(--font-body); font-size: var(--fs-fine); font-weight: 500; letter-spacing: var(--ls-read);
    padding: 12px 18px; border-radius: var(--radius-pill);
    border: 1px solid var(--hair); background: transparent; color: var(--ink); cursor: pointer;
    transition: background var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .chip span { color: var(--dim); margin-left: 2px; }
  .chip:hover { border-color: var(--ink); }
  .chip.on { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .chip.on span { color: color-mix(in srgb, var(--paper) 60%, transparent); }

  .fcount {
    margin-top: var(--space-4);
    font-size: var(--fs-label);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--dim);
    min-height: 1em;
  }

  /* 42ms between cards: enough to read as a sequence, short enough that six of
     them finish inside a quarter of a second. */
  .card.in { animation: card-in var(--dur-slow) var(--ease) both; animation-delay: calc(var(--d) * 42ms); }
  @keyframes card-in {
    from { opacity: 0; transform: translateY(10px) scale(0.985); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .card.in { animation: none; }
  }

  .card[hidden] { display: none; }

</style>

<script>
  import { rails } from '@lib/rail';
  rails();

  /* ── category filter ── */
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const cards = document.querySelectorAll<HTMLElement>('.card');
  const count = document.getElementById('filterCount');
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const f = chip.dataset.filter;
      chips.forEach((c) => {
        const on = c === chip;
        c.classList.toggle('on', on);
        c.setAttribute('aria-pressed', String(on));
      });
      /**
       * The change of state, made obvious.
       *
       * Toggling `hidden` was instantaneous and therefore invisible: cards
       * vanished and the ones below jumped up, and the eye read that as the
       * page reflowing rather than as a filter being applied. Now the survivors
       * re-enter with a short stagger, so the change is something you watch
       * happen and can count.
       *
       * The stagger is capped at six steps. Beyond that the last card arrives
       * late enough to feel like a slow page rather than a deliberate motion.
       */
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let shown = 0;
      cards.forEach((card) => {
        const keep = f === 'all' || card.dataset.cat === f;
        card.hidden = !keep;
        if (!keep) return;
        if (!reduced) {
          card.style.setProperty('--d', String(Math.min(shown, 6)));
          // Restart the animation: removing and re-adding in the same frame is
          // a no-op, so the reflow read forces it.
          card.classList.remove('in');
          void card.offsetWidth;
          card.classList.add('in');
        }
        shown++;
      });
      if (count) count.textContent = shown === cards.length ? '' : `${shown} of ${cards.length}`;
    })
  );
</script>
