---
import { getCollection } from 'astro:content';
import Base from '@layouts/Base.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Newsletter from '@components/Newsletter.astro';

const essays = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf()
);

/**
 * One date, small and out of the way.
 *
 * It used to be two lines — the month above DD/YY, the second set in the
 * display face at 1.125rem semibold. That made the date the loudest thing in
 * every row, louder than the title it belonged to, and it ate a 96px column
 * that pushed every headline into a narrow ragged strip. A date is metadata.
 * It goes above the title, quiet, in one line.
 */
const stamp = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

/** Rendered up front, revealed six at a time. */
const PAGE = 6;
---

<Base
  title="Writing — what building things actually cost"
  description="Essays, notes and reference material on designing and building digital products. Written from what specific decisions cost, including the ones that went badly."
  schema={[
    {
      '@type': 'CollectionPage',
      name: 'Writing',
      description: 'Essays on product design and the decisions behind it.',
      hasPart: essays.map((e) => ({
        '@type': 'BlogPosting',
        headline: e.data.title,
        datePublished: e.data.published.toISOString(),
        url: `https://sgualda.com/writing/${e.id}/`,
      })),
    },
  ]}
>
  <Header slot="nav" />

  <section class="col intro">
    <span class="eyebrow">Writing</span>
    <h1>Writing</h1>
    {/*
      The subject, not the format. "Stories, thoughts and reflections" is what
      every blog subtitle on the internet says.

      A block of three explanatory paragraphs sat here and was removed — it read
      as filler on a page whose job is to get out of the way of the list. The
      index stays a list.

      No topic pages either: with seven essays published the largest cluster
      holds four and the smallest holds one, so a page per topic would be five
      thin pages competing with this one for the same queries. Worth revisiting
      at roughly five substantial pieces per cluster.
    */}
    <p class="sub">What decisions actually cost me, written down while I still remember.</p>
  </section>

  <div class="col">
    <!-- Every essay is in the HTML from the start; the ones past the first six
         are only hidden. Loading them over the network would make them
         invisible to crawlers, which is the usual way infinite scroll quietly
         costs a site its long tail. -->
    <ol class="list" id="list">
      {
        essays.map((e, i) => (
          <li class:list={['row', { hidden: i >= PAGE }]}>
            <a href={`/writing/${e.id}/`}>
              <time datetime={e.data.published.toISOString().slice(0, 10)}>
                {stamp(e.data.published)}
              </time>
              <h2>{e.data.title}</h2>
              <p>{e.data.hook ?? e.data.description}</p>
              <span class="go" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </span>
            </a>
          </li>
        ))
      }
    </ol>

    {
      essays.length > PAGE && (
        <div class="more">
          <button class="btn btn--ghost" type="button" id="more">
            <span id="moreLabel">Show {Math.min(PAGE, essays.length - PAGE)} more</span>
            <span class="dots" id="dots" hidden aria-hidden="true"><i /><i /><i /></span>
          </button>
          <p class="count">
            <span id="shown">{PAGE}</span> of {essays.length}
          </p>
        </div>
      )
    }
  </div>

  <section class="section col">
    <Newsletter />
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .intro { padding-top: clamp(52px, 9vh, 84px); }


  .intro h1 { margin-bottom: 18px; }

  /* ── the index ──
     A list of things to read, so the title leads and everything else gets out
     of its way: date above in the small size, hook underneath in the secondary
     one, a hairline between rows and nothing else. The arrow is the only
     decoration and it only moves on hover.

     The previous version was a two-column grid — date on the left, title on the
     right — which is a table, and a table of seven things is a table too few.
     It also broke below 560px, where 96px of date left the titles wrapping
     every three words. */
  .list {
    /* An ordered list because the order means something — newest first — but
       the markers do not: "1." on the most recent essay numbers nothing a
       reader needs. Semantics kept, decoration dropped. */
    list-style: none;
    text-align: left;
    margin-top: clamp(48px, 8vh, 80px);
  }
  .row.hidden { display: none; content-visibility: hidden; }
  .row { border-top: 1px solid var(--hair); }
  .row:last-of-type { border-bottom: 1px solid var(--hair); }

  .list a {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: 'time  go' 'title go' 'hook  go';
    align-items: start;
    column-gap: 24px;
    padding: clamp(24px, 3.5vw, 34px) 0;
    transition: opacity 0.24s var(--ease);
  }
  .list a:hover { opacity: 0.62; }

  .list time {
    grid-area: time;
    font-size: var(--fs-fine);
    line-height: var(--lh-ui);
    letter-spacing: var(--ls-read);
    color: var(--dim);
  }
  /* The title is the row. Display face, and the only thing at this size. */
  .list h2 {
    grid-area: title;
    margin-top: 8px;
    font-size: clamp(1.125rem, 2.4vw, 1.375rem);
    font-weight: 600;
    letter-spacing: var(--ls-heading);
    line-height: var(--lh-tight);
    max-width: 30ch;
  }
  /* The hook, which the list never showed and every essay already has. It is
     the difference between scanning seven titles and knowing which one is for
     you. */
  .list p {
    grid-area: hook;
    margin-top: 10px;
    max-width: 52ch;
    font-size: var(--fs-sub);
    line-height: var(--lh-read);
    color: var(--dim);
  }
  .go {
    grid-area: go;
    align-self: center;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--hair);
    flex: none;
  }
  .go svg {
    width: 15px; height: 15px;
    stroke: var(--ink); stroke-width: 1.7; fill: none;
    stroke-linecap: round; stroke-linejoin: round;
    transition: transform 0.24s var(--ease);
  }
  .list a:hover .go svg { transform: translateX(3px); }

  /* On a phone the arrow goes: a 34px circle beside a wrapping headline is the
     first thing to squeeze the text, and the whole row is already the target. */
  @media (max-width: 560px) {
    .list a { grid-template-columns: 1fr; grid-template-areas: 'time' 'title' 'hook'; }
    .list h2 { max-width: none; }
    .go { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .list a, .go svg { transition: none; }
  }

  .more { margin-top: 52px; text-align: center; }
  .more .btn { min-width: 168px; }
  .more .btn[disabled] { cursor: default; }

  .dots { display: inline-flex; gap: 6px; align-items: center; }
  .dots[hidden] { display: none; }
  .dots i {
    width: 5px; height: 5px; border-radius: 50%;
    background: currentColor;
    animation: bounce 1.05s var(--ease) infinite;
  }
  .dots i:nth-child(2) { animation-delay: 0.14s; }
  .dots i:nth-child(3) { animation-delay: 0.28s; }
  @keyframes bounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.35; }
    30% { transform: translateY(-7px); opacity: 1; }
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .row.enter { animation: none; }
    .dots i { animation: none; }
  }
  .count {
    margin-top: 18px; text-align: center;
    font-size: 0.6875rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--dim);
  }
  /* On a phone the date stops being a column.
     Ninety-six pixels of date against a 390px screen left the titles in a
     narrow ragged strip, wrapping every two or three words, and the whole list
     read as a broken table sitting left of a centred page. Stacked, each row is
     one full-width block: date, then title. The list is still left-aligned —
     centring a column of titles of different lengths is the one thing that
     would look worse — but now it reads as a deliberate block rather than a
     column that ran out of room. */
</style>

<script>
  const PAGE = 6;
  const rows = [...document.querySelectorAll<HTMLElement>('.row')];
  const btn = document.getElementById('more') as HTMLButtonElement | null;
  const label = document.getElementById('moreLabel');
  const dots = document.getElementById('dots');
  const shown = document.getElementById('shown');

  if (btn && rows.length > PAGE) {
    let visible = PAGE;

    btn.addEventListener('click', () => {
      // Loading state first, so the button acknowledges the press before
      // anything moves. Without it the rows just appear and the click feels
      // like it did nothing.
      btn.disabled = true;
      label?.setAttribute('hidden', '');
      dots?.removeAttribute('hidden');

      setTimeout(() => {
        const batch = rows.slice(visible, visible + PAGE);
        batch.forEach((r, i) => {
          r.style.setProperty('--d', String(i));
          r.classList.remove('hidden');
          r.classList.add('enter');
        });
        visible += batch.length;
        if (shown) shown.textContent = String(visible);

        const left = rows.length - visible;
        if (left <= 0) {
          btn.closest('.more')?.remove();
          return;
        }
        if (label) label.textContent = `Show ${Math.min(PAGE, left)} more`;
        dots?.setAttribute('hidden', '');
        label?.removeAttribute('hidden');
        btn.disabled = false;
      }, 480);
    });
  }
</script>
