---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import portrait from '../../assets/portrait.jpg';
import Base from '@layouts/Base.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import NextStep from '@components/NextStep.astro';
import { SITE } from '@lib/site';
import { TOPICS } from '@lib/topics';
import { getStages, getTools } from '@lib/content';

const STAGES = await getStages();
const TOOLS = await getTools();

export async function getStaticPaths() {
  const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.published.valueOf() - a.data.published.valueOf()
  );

  return essays.map((entry, i) => {
    // Related by shared topic, most recent first. Never the essay itself.
    const related = essays
      .filter((e) => e.id !== entry.id && e.data.topics.some((t) => entry.data.topics.includes(t)))
      .slice(0, 3);

    return {
      params: { slug: entry.id },
      props: {
        entry,
        related,
      },
    };
  });
}

const { entry, related } = Astro.props as {
  entry: CollectionEntry<'essays'>;
  related: CollectionEntry<'essays'>[];
};
const { Content } = await render(entry);
const d = entry.data;

// Reading time from the raw markdown. 200 wpm is the usual figure for
// non-fiction; rounded up so it never claims less than it takes.
const words = entry.body?.split(/\s+/).length ?? 0;
const minutes = Math.max(1, Math.ceil(words / 200));

const topics = TOPICS.filter((t) => d.topics.includes(t.slug));
// The stages and checks this essay's topics belong to — the cross-links that
// tie the three content systems together.
const stages = STAGES.filter((s) => topics.some((t) => t.stage === s.slug));
const tools = TOOLS.filter((t) => topics.some((x) => x.tool === t.slug));

const url = `${SITE.url}/writing/${entry.id}/`;

/** External sources linked in the body — declared as `citation` in the schema. */
const cited = [...(entry.body ?? '').matchAll(/\]\((https?:\/\/[^)\s]+)\)/g)]
  .map((m) => m[1])
  .filter((u) => !u.includes('sgualda.com'))
  .filter((u, i, a) => a.indexOf(u) === i);

/** Glossary terms this essay actually mentions, matched on the term name. */
const glossary = await getCollection('glossary');
const terms = glossary.filter((g) =>
  new RegExp(`\\b${g.data.name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\b`, 'i').test(entry.body ?? '')
);
const fmt = (x: Date) => x.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base
  title={d.seoTitle ?? d.title}
  description={d.description}
  schema={[
    {
      '@type': 'BlogPosting',
      headline: d.title,
      description: d.description,
      datePublished: d.published.toISOString(),
      dateModified: (d.updated ?? d.published).toISOString(),
      url,
      mainEntityOfPage: url,
      author: { '@id': `${SITE.url}/#person` },
      publisher: { '@id': `${SITE.url}/#person` },
      inLanguage: 'en',
      wordCount: words,
      timeRequired: `PT${minutes}M`,
      articleSection: topics.map((t) => t.label),
      keywords: d.topics,
      // The house terms this essay uses, pointed at their definitions. It is
      // how a model knows "repeat use" here means the same thing it means on
      // /glossary/ rather than a phrase that happens to appear twice.
      ...(terms.length && { about: terms.map((t) => ({ '@id': `${SITE.url}/glossary/#${t.id}` })) }),
      // The external sources the essay already links, declared. A model
      // deciding whether to trust a page weighs what it cites, and a link
      // buried in a paragraph is far less legible than this.
      ...(cited.length && { citation: cited }),
    },
    // Mirrors the rendered FAQ block below. Same source, so they cannot drift.
    ...(d.faqs?.length
      ? [
          {
            '@type': 'FAQPage',
            '@id': `${url}#faq`,
            mainEntity: d.faqs.map(({ q, a }) => ({
              '@type': 'Question',
              name: q,
              acceptedAnswer: { '@type': 'Answer', text: a },
            })),
          },
        ]
      : []),
  ]}
>
  <Header slot="nav" />

  <article>
    <header class="col head">
      <Breadcrumbs items={[{ label: 'Writing', href: '/writing/' }, { label: 'Essay' }]} />
      <h1>{d.title}</h1>
      <p class="meta">
        <time datetime={d.published.toISOString()}>{fmt(d.published)}</time>
        {' · '}{minutes} min read
        {
          d.updated && d.updated.valueOf() !== d.published.valueOf() && (
            <> · updated {fmt(d.updated)}</>
          )
        }
      </p>
    </header>

    <div class="col prose">
      <Content />
    </div>

    {/* Real markup, not just schema. A question answered in full on the page
        is what a model quotes; a paragraph of prose that happens to contain
        the answer is not. Same source as the FAQPage node above. */}
    {d.faqs && d.faqs.length > 0 && (
      <section class="col essay-faq">
        <h2>Questions people ask about this</h2>
        <div class="faq">
          {d.faqs.map(({ q, a }) => (
            <details>
              <summary>{q}<span class="pm" aria-hidden="true">+</span></summary>
              <div class="ans"><p>{a}</p></div>
            </details>
          ))}
        </div>
      </section>
    )}

    {/* An essay is where a stranger from Google lands, and until now nothing on
        the page said who wrote it or why they would know. The face is the
        cheapest trust signal available and it was already sitting in the repo. */}
    <aside class="col byline">
      <Image src={portrait} alt="Sergio Gualda" widths={[96, 192]} sizes="56px" loading="lazy" />
      <div>
        <p class="who"><strong>Sergio Gualda</strong> — product designer in Barcelona.</p>
        <p class="what">
          I take vague problems to shipped first versions for small teams, and write down what
          the decisions cost. <a href="/about/">More about me</a> · <a href="/work-with-me/">Work with me</a>
        </p>
      </div>
    </aside>
  </article>

  {
    (stages.length > 0 || tools.length > 0) && (
      <section class="section col">
        <span class="eyebrow">Put it to work</span>
        <h2>Where this applies.</h2>
        <ul class="cross">
          {stages.map((s) => (
            <li class="card-link">
              <a href={`/map/${s.slug}/`}>
                <h3>Stage {s.n} — {s.name}</h3>
                <p>{s.lead}</p>
              </a>
            </li>
          ))}
          {tools.map((t) => (
            <li class="card-link">
              <a href={`/tools/${t.slug}/`}>
                <h3>{t.n}</h3>
                <p>{t.out}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="section col">
        <span class="eyebrow">Related</span>
        <h2>More like this.</h2>
        <ul class="related">
          {related.map((e) => (
            <li>
              <a href={`/writing/${e.id}/`}>
                <span class="h">{e.data.title}</span>
                <span class="p">{e.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }


  <NextStep
    line="Recognise any of this in your own product?"
    secondLabel="More essays"
    secondHref="/writing/"
  />

  {/* The disagreement invitation stays, but as a line rather than a button:
      a mailto: opens a mail client, which on a phone is one of the heaviest
      things you can ask of somebody who is still reading. */}
  <p class="col disagree">
    Something here you disagree with? <a href={`mailto:${SITE.email}`}>That’s the useful kind of email</a>.
  </p>

  <Footer slot="footer" />
</Base>

<style>
  .head { padding-top: clamp(44px, 8vh, 72px); }
  .head h1 { font-size: clamp(1.9rem, 4.4vw, 2.9rem); }
  .meta { margin-top: 18px; font-size: 0.875rem; color: var(--dim); }

  /* Article body: left-aligned. Centred text is fine for headings and short
     blocks, but it destroys readability over 400 words. */
  .prose {
    margin-top: 52px;
    text-align: left;
    font-size: 1.125rem;
    line-height: 1.72;
    letter-spacing: -0.011em;
  }
  .prose :global(p) { margin-bottom: 1.35em; }
  .prose :global(h2) { margin: 2.2em 0 0.7em; font-size: clamp(1.4rem, 3vw, 1.75rem); }
  .prose :global(h3) { margin: 1.8em 0 0.6em; }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .prose :global(strong) { font-weight: 600; }
  .prose :global(ul),
  .prose :global(ol) { margin: 0 0 1.35em 1.2em; }
  .prose :global(li) { margin-bottom: 0.5em; padding-left: 0.3em; }
  .prose :global(img) {
    border-radius: var(--radius-card);
    margin: 2em 0;
    width: 100%;
  }
  .prose :global(blockquote) {
    border-left: 2px solid var(--hair);
    padding-left: 1.2em;
    margin: 1.8em 0;
    color: var(--dim);
  }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--hair); margin: 2.4em 0; }
  .prose :global(pre) {
    background: var(--surface);
    border-radius: 14px;
    padding: 18px;
    overflow-x: auto;
    font-size: 0.9rem;
  }

  /* The wrapper the rehype plugin adds. The table keeps its own semantics;
     only the box around it scrolls. */
  .prose :global(.table-scroll) { overflow-x: auto; margin: var(--space-6) 0; }
  .prose :global(.table-scroll:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }
  .prose :global(table) {
    border-collapse: collapse;
    width: 100%;
    min-width: 420px;
    font-size: 0.875rem;
    letter-spacing: 0;
  }
  .prose :global(th), .prose :global(td) {
    text-align: left;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--hair);
    vertical-align: top;
  }
  .prose :global(th) { font-weight: 600; white-space: nowrap; }
  .prose :global(td:first-child) { color: var(--dim); }

  .essay-faq { margin-top: var(--space-9); text-align: left; }
  .essay-faq h2 {
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    text-align: center;
    margin-bottom: var(--space-6);
  }

  .disagree {
    margin-top: var(--space-7);
    text-align: center;
    font-size: 0.875rem;
    letter-spacing: 0;
    color: var(--dim);
  }
  .disagree a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }

  .byline {
    display: flex;
    gap: var(--space-5);
    align-items: flex-start;
    text-align: left;
    margin-top: var(--space-9);
    padding-top: var(--space-7);
    border-top: 1px solid var(--hair);
  }
  .byline img {
    width: 56px;
    height: 56px;
    flex: none;
    border-radius: var(--radius-sm);
    object-fit: cover;
  }
  .byline .who { font-size: 0.9375rem; letter-spacing: 0; margin-bottom: 6px; }
  .byline .what { font-size: 0.875rem; line-height: 1.55; letter-spacing: 0; color: var(--dim); }
  .byline a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .byline a:hover { opacity: 0.6; }

  .cross, .related { list-style: none; text-align: left; margin-top: 32px; display: grid; gap: 14px; }
  .cross h3 { font-size: 1rem; margin-bottom: 8px; }
  .cross p { font-size: 0.875rem; line-height: 1.5; letter-spacing: 0; color: var(--dim); }
  .related li + li { border-top: 1px solid var(--hair); }
  .related a { display: block; padding: 20px 0; transition: opacity 0.2s var(--ease); }
  .related a:hover { opacity: 0.55; }
  .related .h {
    display: block; font-family: var(--font-display); font-size: 1.0625rem;
    font-weight: 600; letter-spacing: -0.03em; margin-bottom: 6px;
  }
  .related .p { font-size: 0.9375rem; line-height: 1.5; letter-spacing: 0; color: var(--dim); }

  .pager em {
    display: block; font-style: normal; font-size: 0.6875rem;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--dim); margin-bottom: 6px;
  }
  .pager span {
    font-family: var(--font-display); font-size: 0.9375rem;
    font-weight: 600; letter-spacing: -0.03em; line-height: 1.3;
  }

  .next { margin-top: var(--gap); padding-top: 44px; border-top: 1px solid var(--hair); }
  .next .actions { margin-top: 22px; }
</style>
