---
import { getCollection } from 'astro:content';
import Base from '@layouts/Base.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { TOPICS, type Topic } from '@lib/topics';
import { STAGES } from '@lib/stages';
import { TOOLS } from '@lib/tools';

export async function getStaticPaths() {
  const essays = await getCollection('essays', ({ data }) => !data.draft);
  return TOPICS.filter((t) => essays.some((e) => e.data.topics.includes(t.slug))).map((topic) => ({
    params: { slug: topic.slug },
    props: {
      topic,
      posts: essays
        .filter((e) => e.data.topics.includes(topic.slug))
        .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf()),
    },
  }));
}

const { topic, posts } = Astro.props as { topic: Topic; posts: any[] };
const stage = topic.stage ? STAGES.find((s) => s.slug === topic.stage) : undefined;
const tool = topic.tool ? TOOLS.find((t) => t.slug === topic.tool) : undefined;

const month = (d: Date) => d.toLocaleDateString('en-GB', { month: 'long' });
const dayYear = (d: Date) =>
  `${String(d.getDate()).padStart(2, '0')}/${String(d.getFullYear()).slice(-2)}`;
---

<Base
  title={`${topic.label} — essays`}
  description={`${topic.blurb} ${posts.length} ${posts.length === 1 ? 'essay' : 'essays'} on ${topic.label.toLowerCase()}, written from what building products actually cost me.`}
  schema={[
    {
      '@type': 'CollectionPage',
      name: `${topic.label} — essays`,
      description: topic.blurb,
      hasPart: posts.map((e) => ({
        '@type': 'BlogPosting',
        headline: e.data.title,
        url: `https://sgualda.com/writing/${e.id}/`,
      })),
    },
  ]}
>
  <Header slot="nav" />

  <section class="col intro">
    <Breadcrumbs items={[{ label: 'Journal', href: '/writing/' }, { label: topic.label }]} />
    <h1>{topic.label}</h1>
    <p class="sub">{topic.blurb}</p>
  </section>

  <div class="col">
    <ol class="list">
      {
        posts.map((e) => (
          <li class="row">
            <a href={`/writing/${e.id}/`}>
              <span class="when">
                <em>{month(e.data.published)}</em>
                <b>{dayYear(e.data.published)}</b>
              </span>
              <span class="what">{e.data.title}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>

  {
    (stage || tool) && (
      <section class="section col">
        <span class="eyebrow">Related</span>
        <h2>Where this fits.</h2>
        <ul class="rel">
          {stage && (
            <li class="card-link">
              <a href={`/map/${stage.slug}/`}>
                <h3>Stage {stage.n} — {stage.name}</h3>
                <p>{stage.lead}</p>
              </a>
            </li>
          )}
          {tool && (
            <li class="card-link">
              <a href={`/tools/${tool.slug}/`}>
                <h3>{tool.n}</h3>
                <p>{tool.out}</p>
              </a>
            </li>
          )}
        </ul>
      </section>
    )
  }

  <section class="section col">
    <span class="eyebrow">Everything else</span>
    <h2>Other topics.</h2>
    <ul class="chips">
      {
        TOPICS.filter((t) => t.slug !== topic.slug).map((t) => (
          <li><a href={`/writing/topic/${t.slug}/`}>{t.label}</a></li>
        ))
      }
      <li><a href="/writing/">All essays</a></li>
    </ul>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .intro { padding-top: clamp(44px, 8vh, 72px); }
  .intro h1 { margin-bottom: 18px; }

  .list { list-style: none; text-align: left; margin-top: 48px; }
  .row + .row { margin-top: 34px; }
  .list a { display: grid; grid-template-columns: 96px 1fr; gap: 24px; align-items: start; transition: opacity 0.2s var(--ease); }
  .list a:hover { opacity: 0.55; }
  .when { color: var(--dim); }
  .when em { display: block; font-style: normal; font-size: 0.8125rem; letter-spacing: 0; line-height: 1.2; }
  .when b {
    display: block; margin-top: 2px;
    font-family: var(--font-display); font-size: 1.125rem; font-weight: 600;
    letter-spacing: -0.03em; line-height: 1.2;
  }
  .what { font-family: var(--font-display); font-size: 1.0625rem; font-weight: 600; letter-spacing: -0.03em; line-height: 1.32; }

  .rel { list-style: none; text-align: left; margin-top: 34px; display: grid; gap: 14px; }
  .rel h3 { font-size: 1rem; margin-bottom: 8px; }
  .rel p { font-size: 0.875rem; line-height: 1.5; letter-spacing: 0; color: var(--dim); }

  .chips { list-style: none; display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; margin-top: 30px; }
  .chips a {
    display: block; padding: 9px 18px; border-radius: var(--radius-pill);
    border: 1px solid var(--hair); font-size: 0.8125rem; font-weight: 500;
    letter-spacing: -0.01em; transition: border-color 0.2s var(--ease);
  }
  .chips a:hover { border-color: var(--ink); }

  @media (max-width: 480px) { .list a { grid-template-columns: 74px 1fr; gap: 16px; } }
</style>
