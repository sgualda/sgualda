---
import { getCollection } from 'astro:content';
import Base from '@layouts/Base.astro';
import { SITE } from '@lib/site';
import { KIND, KIND_LABEL, STAGE, TIMING, BUDGET, ABOUT_YOU, EXTRA, STEPS } from '@lib/intake';
import '@styles/quiz.css';

/**
 * /services/start/ — the project intake.
 *
 * Moved from /work-with-me/brief/ on 2026-08-20 and rebuilt around the three
 * services. What did not change is why it is a page of its own: three minutes
 * of typing is the only thing that should be possible on this screen, and
 * every link in a header is an invitation to abandon it.
 *
 * `?s=web-design` arrives from a service page and pre-answers step one. Without
 * it the form still works, it just starts unanswered — a bookmark, or somebody
 * who came straight here, is not a broken state.
 *
 * noindex: it is the end of a funnel, not a landing page. Somebody arriving
 * from a search result has skipped the part that explains what any of this is.
 */
const services = (await getCollection('services', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

/**
 * The per-service questions, handed to the client as data rather than baked
 * into the script.
 *
 * They live in each service's content file, beside the copy that promises
 * them. Serialising them here means adding a fourth service is a markdown file
 * and nothing else — the form has no list of services in it to forget to
 * update.
 */
const SPECIFIC = Object.fromEntries([
  ...services.map((s) => [s.id, s.data.intake]),
  /**
   * The "something else" path.
   *
   * Somebody who does not fit the three still has to be askable. These are the
   * two questions that make any brief answerable, and they are open on purpose.
   */
  [
    'unsure',
    [
      ['u1', 'What would you want me to do?', 'textarea', 'However roughly. I would rather read the messy version.'],
      ['u2', 'Is there a site already?', 'input', 'A link, if there is one.'],
    ],
  ],
]);

/** Labels the payload uses, so the email that arrives is readable prose. */
const LABELS = Object.fromEntries([
  [STAGE[0], STAGE[1]],
  [TIMING[0], TIMING[1]],
  [BUDGET[0], BUDGET[1]],
  [EXTRA[0], EXTRA[1]],
  ...services.flatMap((s) => s.data.intake.map((f) => [f[0], f[1]])),
  ['u1', 'What would you want me to do?'],
  ['u2', 'Is there a site already?'],
]);
---

<Base
  title="Start a project"
  description="Six short steps. I read every brief myself and reply within five working days with what fits, what it would involve and what it costs, or that none of it fits."
  noindex
  bare
>
  {/* Somebody arriving from a bookmark had one way out, and it led back into
      the funnel rather than to the site. The logo is the way home that
      everybody already looks for. */}
  <a class="home" href="/" aria-label={`${SITE.name} — home`}>
    <img src="/img/logo.png" alt="" width="96" height="96" />
  </a>

  <a class="close" href="/services/" aria-label="Close the form and go back to services">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M18 6 6 18M6 6l12 12" />
    </svg>
  </a>

  <div class="col sheet">
    {/* The visible label is the eyebrow; the page still needs a heading, or
        somebody navigating by headings lands on a form with no name. */}
    <h1 class="sr-only">Start a project</h1>
    <span class="eyebrow">Your project</span>
    <ol class="stepper" id="stepper" aria-label="Progress" style={`--steps:${STEPS.length}`}>
      {
        STEPS.map((label, i) => (
          <li data-step={i + 1}>
            <span class="n">{i + 1}</span>
            <span class="lab">{label}</span>
          </li>
        ))
      }
    </ol>

    <div class="panel">
      <div id="bBox"></div>
      {/* Honeypot. Hidden from people, irresistible to bots. */}
      <div class="hp" aria-hidden="true">
        <label for="website">Website</label>
        <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
    </div>

    <p class="aside">
      Or just email me — <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
    </p>
  </div>

  {/* Content, not code. Read once by the script below. */}
  <script type="application/json" id="intake-data" is:inline set:html={JSON.stringify({ SPECIFIC, LABELS, KIND, KIND_LABEL, STAGE, TIMING, BUDGET, ABOUT_YOU, EXTRA })} />
</Base>

<style>
  /* Vertically centred on a tall screen, top-aligned once the panel outgrows
     it, so a five-field step never gets cut off. */
  .sheet {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(64px, 12vh, 96px) clamp(40px, 8vh, 72px);
  }
  /* A flex column stretches its children, which left-aligns the rules on
     either side of the label. */
  .sheet > .eyebrow { align-self: center; margin-bottom: var(--space-6); }

  .home {
    position: fixed;
    top: max(16px, env(safe-area-inset-top));
    left: max(16px, env(safe-area-inset-left));
    z-index: 10;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    opacity: 0.75;
    transition: opacity 0.2s var(--ease);
  }
  .home:hover { opacity: 1; }
  .home img { width: 30px; height: 30px; object-fit: contain; }

  .close {
    position: fixed;
    top: max(16px, env(safe-area-inset-top));
    right: max(16px, env(safe-area-inset-right));
    z-index: 10;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-pill);
    border: 1px solid var(--hair);
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    color: var(--ink);
    transition: border-color 0.24s var(--ease);
  }
  .close:hover { border-color: var(--ink); }
  .close svg {
    width: 20px; height: 20px;
    stroke: currentColor; stroke-width: 1.6; fill: none; stroke-linecap: round;
  }

  /* A real stepper rather than six dots. Six dots tell you how far along you
     are; this also tells you what is left, which is what decides whether
     somebody finishes a form they did not plan to fill in.

     The column count comes from the step list rather than being written here,
     so adding a step does not silently squash the last one off the grid. */
  .stepper {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(var(--steps, 6), 1fr);
    gap: var(--space-2);
    margin: var(--space-8) 0 var(--space-6);
  }
  .stepper li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    position: relative;
    padding-top: 12px;
    border-top: 2px solid var(--hair);
    transition: border-color 0.32s var(--ease);
  }
  .stepper .n {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--hair);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--dim);
    transition: background 0.32s var(--ease), color 0.32s var(--ease), border-color 0.32s var(--ease);
  }
  .stepper .lab {
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    line-height: var(--lh-tight);
    text-align: center;
    color: var(--dim);
    transition: color 0.32s var(--ease);
  }

  /* Done */
  .stepper li[data-state='done'] { border-top-color: var(--ink); }
  .stepper li[data-state='done'] .n {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  /* Current */
  .stepper li[data-state='now'] { border-top-color: var(--ink); }
  .stepper li[data-state='now'] .n { border-color: var(--ink); color: var(--ink); }
  .stepper li[data-state='now'] .lab { color: var(--ink); font-weight: 500; }

  /* On a phone the labels are unreadable at any size that fits. The numbers
     and the rules still carry the progress; the current step is named in the
     panel itself. */
  @media (max-width: 720px) {
    .stepper .lab { display: none; }
    .stepper li { padding-top: 10px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .stepper li, .stepper .n, .stepper .lab { transition: none; }
    .close { transition: none; }
  }
</style>

<script>
  type Field = [string, string, string, string];

  const DATA = JSON.parse(document.getElementById('intake-data')!.textContent!) as {
    SPECIFIC: Record<string, Field[]>;
    LABELS: Record<string, string>;
    KIND: [string, string][];
    KIND_LABEL: Record<string, string>;
    STAGE: Field;
    TIMING: Field;
    BUDGET: Field;
    ABOUT_YOU: Field[];
    EXTRA: Field;
  };

  const $ = (id: string) => document.getElementById(id)!;
  const TOTAL = 6;

  /**
   * Which service, handed over in the URL by the page they came from.
   *
   * Read once. Somebody arriving without it — a bookmark, a shared link, the
   * footer — gets step one unanswered rather than a wrong default, because a
   * pre-ticked box is an answer somebody did not give.
   */
  const params = new URLSearchParams(location.search);
  const fromUrl = params.get('s');
  const initialKind = fromUrl && DATA.SPECIFIC[fromUrl] ? fromUrl : '';

  let step = 0;

  /**
   * Answers survive going back a step, and closing the tab.
   * sessionStorage rather than localStorage: it dies with the tab, so a shared
   * or public machine does not keep somebody's half-written brief around.
   */
  const KEY = 'intake-draft';
  let kept: Record<string, string> = {};
  try {
    kept = JSON.parse(sessionStorage.getItem(KEY) ?? '{}');
  } catch {
    kept = {};
  }
  if (initialKind && !kept.kind) kept.kind = initialKind;

  const persist = () => {
    try {
      sessionStorage.setItem(KEY, JSON.stringify(kept));
    } catch {
      // Private mode. The draft still survives going back, just not a reload.
    }
  };

  /** The chosen service, or the open-ended path. */
  const kindOf = () => (kept.kind && DATA.SPECIFIC[kept.kind] ? kept.kind : 'unsure');

  /** Focus rather than scroll: it moves the screen reader with it. */
  const focusHead = () => $('bBox').querySelector<HTMLElement>('[data-quiz-head]')?.focus();

  const setStepper = () =>
    document.querySelectorAll<HTMLElement>('#stepper li').forEach((li) => {
      const n = +li.dataset.step!;
      li.dataset.state = step === 0 ? 'todo' : n < step ? 'done' : n === step ? 'now' : 'todo';
      if (n === step) li.setAttribute('aria-current', 'step');
      else li.removeAttribute('aria-current');
    });

  const field = ([id, lab, type, hint]: Field) => {
    const h = hint ? `<p class="hint">${hint}</p>` : '';
    if (type.startsWith('select|'))
      return `<div class="f"><label for="${id}">${lab}</label><select id="${id}">${type
        .split('|')
        .slice(1)
        .map((o) => `<option>${o}</option>`)
        .join('')}</select>${h}</div>`;
    if (type === 'input') return `<div class="f"><label for="${id}">${lab}</label><input id="${id}">${h}</div>`;
    return `<div class="f"><label for="${id}">${lab}</label><textarea id="${id}"></textarea>${h}</div>`;
  };

  function paint() {
    const kind = kindOf();
    const specifics = DATA.SPECIFIC[kind] ?? [];

    const panes: string[] = [
      // 1 — which service
      `<p class="qq" data-quiz-head tabindex="-1">What do you need?</p>` +
        DATA.KIND.map(
          ([k, label]) =>
            `<label class="ck"><input type="radio" name="kind" value="${k}"${
              k === kept.kind ? ' checked' : ''
            }><span>${label}</span></label>`
        ).join(''),

      // 2 — the project
      `<p class="qq" data-quiz-head tabindex="-1">What are you building?</p>` +
        field(['company', 'Company or project', 'input', '']) +
        field(['site', 'Website, if there is one', 'input', 'A link is worth more than a description.']) +
        field(DATA.STAGE),

      // 3 — the one that is actually read
      `<p class="qq" data-quiz-head tabindex="-1">What is in the way?</p>` +
        `<p class="intro">The problem you want solved, not the task you were going to hire for. ` +
        `Do not polish it — the messy version is more useful.</p>` +
        field(['blocked', 'In your own words', 'textarea', '']),

      // 4 — per service
      `<p class="qq" data-quiz-head tabindex="-1">A few specifics.</p>` +
        `<p class="intro">All optional. They make my reply more specific, and skipping them ` +
        `costs you nothing.</p>` +
        specifics.map(field).join(''),

      // 5 — time and money
      `<p class="qq" data-quiz-head tabindex="-1">Time and budget.</p>` +
        field(DATA.TIMING) +
        field(DATA.BUDGET),

      // 6 — contact, last on purpose
      `<p class="qq" data-quiz-head tabindex="-1">Where do I reply?</p>` +
        field(DATA.ABOUT_YOU[0]) +
        field(DATA.ABOUT_YOU[1]) +
        field(DATA.EXTRA) +
        // The single most common silent objection to a form is not knowing what
        // happens to the address. /privacy/ answers it well and nobody filling
        // in this form was ever going to read it.
        `<p class="privacy">Your email is used to reply to you and nothing else. No list, no ` +
        `sequence, no third party. <a href="/privacy/">What I do with it</a>.</p>`,
    ];

    if (step === 0) {
      const chosen = kept.kind ? DATA.KIND_LABEL[kept.kind] : null;
      $('bBox').innerHTML =
        `<div class="step start">` +
        (chosen ? `<p class="tag">${chosen}</p>` : '') +
        `<h2 class="qq" data-quiz-head tabindex="-1">Tell me what is going on.</h2>` +
        `<p class="intro">Six short steps, about five minutes. I read every one myself and ` +
        `reply within five working days with what fits, what it would involve and roughly ` +
        `what it costs — or that none of it fits, and why.</p>` +
        `<p class="intro">Nothing is sent until the last step, and you can close this at any ` +
        `point.</p>` +
        `<div class="fnav one"><button class="btn btn--dark" type="button" data-go="1">Start</button></div>` +
        `</div>`;
      setStepper();
      $('bBox')
        .querySelectorAll<HTMLButtonElement>('[data-go]')
        .forEach((b) => b.addEventListener('click', () => { step = 1; paint(); focusHead(); }));
      return;
    }

    $('bBox').innerHTML =
      `<div class="step">${panes[step - 1]}<div class="fnav">` +
      `<button class="btn btn--ghost" type="button" data-go="${step - 1}">Back</button>` +
      (step < TOTAL
        ? `<button class="btn btn--dark" type="button" data-go="${step + 1}">Continue</button>`
        : `<button class="btn btn--dark" type="button" id="send">Send it</button>`) +
      `</div></div>`;

    // Repainting a step rebuilds its markup, so anything already typed has to
    // be put back. Without this, Back is a destructive button.
    for (const [id, v] of Object.entries(kept)) {
      const el = document.getElementById(id) as HTMLInputElement | null;
      if (el && v) el.value = v;
    }
    if (kept.kind) {
      const radio = document.querySelector<HTMLInputElement>(`input[name=kind][value="${CSS.escape(kept.kind)}"]`);
      if (radio) radio.checked = true;
    }

    setStepper();
    $('bBox')
      .querySelectorAll<HTMLButtonElement>('[data-go]')
      .forEach((b) =>
        b.addEventListener('click', () => {
          const to = +b.dataset.go!;
          // Only going forward is gated. Back is always allowed, or a half-filled
          // step becomes a trap.
          if (to > step && !checkStep()) return;
          step = to;
          paint();
          focusHead();
        })
      );
    document.getElementById('send')?.addEventListener('click', submit);
  }

  /**
   * Each step is checked on the way out of it, not at the end.
   *
   * Validating everything on Send produces the worst possible message:
   * standing on the last step being told step three is wrong, with no way back
   * to it except guessing. Catching it in place means the error is always
   * about the field you are looking at.
   */
  function checkStep(): boolean {
    document.getElementById('bErr')?.remove();
    if (step === 1 && !kept.kind) {
      showError('Pick one. If none of them is right, the last option is the right one.');
      return false;
    }
    if (step === 3 && (kept.blocked ?? '').trim().length < 20) {
      showError('This is the one I actually read. A couple of sentences is enough.');
      $('bBox').querySelector<HTMLElement>('#blocked')?.focus();
      return false;
    }
    if (step === TOTAL && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test((kept.email ?? '').trim())) {
      showError('I need an email address that works, or I cannot reply.');
      $('bBox').querySelector<HTMLElement>('#email')?.focus();
      return false;
    }
    return true;
  }

  /* ── submitting ── */
  const opened = Date.now();
  const val = (id: string) => (document.getElementById(id) as HTMLInputElement | null)?.value?.trim() ?? '';

  const remember = () =>
    document.querySelectorAll<HTMLInputElement>('#bBox input, #bBox textarea, #bBox select').forEach((el) => {
      if (el.id) kept[el.id] = el.value;
      persist();
    });

  async function submit() {
    const btn = document.getElementById('send') as HTMLButtonElement;
    const email = val('email');
    const blocked = kept.blocked ?? '';

    if (!checkStep()) return;
    // Step 3 cannot be empty by now, but a brief that arrives without it is
    // useless to me, so it stays checked rather than assumed.
    if (blocked.trim().length < 20) {
      step = 3;
      paint();
      focusHead();
      showError('This is the one I actually read. A couple of sentences is enough.');
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Sending…';
    document.getElementById('bErr')?.remove();

    /**
     * Everything that is not a named field goes across as label → answer, so
     * the email that lands is readable prose rather than `s3: Yes`.
     */
    const SKIP = new Set(['kind', 'company', 'site', 'blocked', 'name', 'email', 'website']);
    const specifics: Record<string, string> = {};
    for (const [id, v] of Object.entries(kept)) {
      if (SKIP.has(id) || !v.trim()) continue;
      specifics[DATA.LABELS[id] ?? id] = v.trim();
    }

    try {
      const res = await fetch('/api/brief.php', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          kind: DATA.KIND_LABEL[kept.kind ?? ''] ?? 'Not sure yet',
          product: [kept.company, kept.site].filter(Boolean).join(' — ') || '—',
          stage: kept.stage ?? '',
          blocked: blocked.trim(),
          specifics,
          name: kept.name ?? '',
          email,
          website: val('website'),
          elapsed: Date.now() - opened,
        }),
      });
      // The endpoint is PHP, so a server misconfiguration answers with an HTML
      // error page. Parsing that as JSON throws "Unexpected token '<'", which
      // is a stack trace shown to somebody who just wanted to send a message.
      const type = res.headers.get('content-type') ?? '';
      if (!type.includes('application/json')) {
        throw new Error(
          `Something is wrong at my end (${res.status}). Email hello@sgualda.com and I will pick it up there.`
        );
      }
      const out = await res.json();
      if (!res.ok || !out.ok) throw new Error(out.error || 'Something went wrong.');

      // The success page owns the reassurance. Carrying the address means it
      // can say where the confirmation went.
      sessionStorage.setItem('brief-sent', email);
      sessionStorage.removeItem(KEY);
      location.href = '/services/start/sent/';
    } catch (err) {
      btn.disabled = false;
      btn.textContent = 'Send it';
      showError(
        err instanceof Error && err.message
          ? err.message
          : 'Could not send, check your connection, or email hello@sgualda.com instead.'
      );
    }
  }

  function showError(msg: string) {
    document.getElementById('bErr')?.remove();
    const p = document.createElement('p');
    p.id = 'bErr';
    p.className = 'formErr';
    p.setAttribute('role', 'alert');
    p.textContent = msg;
    document.querySelector('#bBox .fnav')?.before(p);
  }

  // Capture on the panel, so a value is kept the moment it changes rather than
  // only when the step advances.
  $('bBox').addEventListener('input', remember);
  $('bBox').addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name === 'kind') kept.kind = t.value;
    remember();
    persist();
  });

  paint();
</script>
