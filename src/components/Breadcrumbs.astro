---
import { SITE } from '@lib/site';

/**
 * One component for the visible trail and its JSON-LD, generated from the same
 * array. They were written separately, which meant the schema promised Google
 * a structure the reader could not see.
 */
interface Crumb { label: string; href?: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ label: 'Home', href: '/' }, ...items].map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: new URL(c.href, SITE.url).href } : {}),
  })),
};
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {
      items.map((c, i) => (
        <li>
          {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
          {i < items.length - 1 && <span class="sep" aria-hidden="true">·</span>}
        </li>
      ))
    }
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<style>
  .crumbs { margin-bottom: var(--space-5); }
  .crumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .crumbs li { display: flex; gap: var(--space-2); }
  .crumbs a { transition: color 0.2s var(--ease); }
  .crumbs a:hover { color: var(--ink); }
  .sep { opacity: 0.5; }
</style>
