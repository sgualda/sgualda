---
import { SITE, SOCIAL, NAV, MORE } from '@lib/site';


const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="inner">
    <nav class="map" aria-label="Footer">
      <div class="group">
        <h2>Site</h2>
        <ul>
          <li><a href="/">Home</a></li>
          {NAV.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}
        </ul>
      </div>

      <div class="group">
        <h2>More</h2>
        <ul>
          {MORE.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}
          <li><a href="/glossary/">Glossary</a></li>
        </ul>
      </div>

    </nav>

    <div class="bottom">
      {/* The mark rather than the name set in bold. The header already
          establishes it, and repeating a name in type where a logo exists is
          the sort of thing that makes a site feel unfinished. */}
      {/* The mark and the role are one identity block, stacked. As siblings of
          a flex row they sat side by side, which read as a logo with a caption
          rather than as a signature. */}
      <div class="ident">
        <a class="mark" href="/" aria-label={`${SITE.name} — home`}>
          <img src="/img/logo.png" alt="" width="96" height="96" />
        </a>
        <p class="who">
          <span>{SITE.role}</span><br />
          {SITE.location}<br />
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </p>
      </div>

      <ul class="elsewhere">
        {SOCIAL.linkedin && <li><a href={SOCIAL.linkedin} rel="me noopener">LinkedIn</a></li>}
        {SOCIAL.instagram && <li><a href={SOCIAL.instagram} rel="me noopener">Instagram</a></li>}
        <li><a href={SOCIAL.community} rel="me noopener">Substack</a></li>
      </ul>
    </div>

    <div class="legal">
      <span>© {year} {SITE.name}</span>
      <span class="legal-links">
        <a href="/privacy/">Privacy</a>
        <a href="/legal/">Legal</a>
      </span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--gap);
    padding: 54px 0 44px;
    border-top: 1px solid var(--hair);
  }
  .inner { width: var(--shell); margin-inline: auto; text-align: left; }

  .map {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 34px 24px;
  }
  .group h2 {
    font-family: var(--font-body);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dim);
    margin-bottom: 14px;
  }
  .group ul { list-style: none; }
  .group li + li { margin-top: 2px; }
  /* 15px of text in a 24px box. WCAG 2.5.8 asks for 24×24 on anything that is
     not a link inside a sentence, and ten navigation links at 16px tall were
     the least comfortable thing on the site on a phone. The padding replaces
     the old margin, so the footer is the same height. */
  .group a {
    display: block;
    padding-block: 5px;
    font-size: var(--fs-sub);
    line-height: var(--lh-ui);
    letter-spacing: var(--ls-read);
    color: var(--ink);
    transition: opacity var(--dur-fast) var(--ease);
  }
  .group a:hover { opacity: 0.55; text-decoration: underline; text-underline-offset: 3px; }

  .bottom {
    margin-top: 44px;
    padding-top: 28px;
    border-top: 1px solid var(--hair);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px 32px;
    flex-wrap: wrap;
  }
  .mark { display: block; width: 34px; height: 34px; margin-bottom: var(--space-5); }
  .mark img { width: 100%; height: 100%; object-fit: contain; }
  .who { font-size: var(--fs-sub); line-height: 1.75; letter-spacing: var(--ls-read); color: var(--dim); }
  .who strong { color: var(--ink); font-weight: 600; }
  .who a { color: var(--ink); }
  .who a:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* One row, not a stacked column — it read as a second menu before. */
  .elsewhere { list-style: none; display: flex; gap: 14px; }
  .elsewhere a {
    display: block;
    padding: 5px 6px;
    font-size: var(--fs-sub); letter-spacing: var(--ls-read); color: var(--ink);
  }
  .elsewhere a:hover { text-decoration: underline; text-underline-offset: 3px; }

  .legal {
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px solid var(--hair);
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: var(--fs-fine);
    color: var(--dim);
  }
  .legal a:hover { color: var(--ink); }
  .legal-links { display: flex; gap: 18px; }

  /* Centred on a phone.
     The footer is the one place the site broke its own alignment rule: every
     other section centres its headings and its short blocks at this width, and
     the footer stayed hard left, so the last thing on every page looked like a
     different site. Two columns collapsing to one left-aligned column also put
     ten links in a tall ragged strip down the left edge.

     Centred is the right choice rather than the easy one: at 390px the link
     labels are two or three words, a single centred column reads as one block
     rather than a list of leftovers, and it matches the hero, the bands and the
     newsletter directly above it. */
  @media (max-width: 560px) {
    .inner { text-align: center; }
    .map { grid-template-columns: 1fr; gap: 28px; }
    .bottom { flex-direction: column; align-items: center; }
    .mark { margin-inline: auto; }
    .elsewhere { justify-content: center; flex-wrap: wrap; }
    .legal { flex-direction: column; align-items: center; gap: 10px; }
    .legal-links { justify-content: center; }
  }
</style>
