---
/**
 * Two or three numbers with their context, side by side.
 *
 * A figure is read in half a second where the same claim in a sentence takes
 * four. Used to break a run of prose with something that can be scanned.
 *
 * Every number here has to be true and checkable. A made-up statistic on a
 * site about honesty is the most expensive kind of decoration there is.
 */
interface Props {
  items: { value: string; label: string }[];
}
const { items } = Astro.props;
---

<ul class="figures">
  {
    items.map((f) => (
      <li>
        <span class="v">{f.value}</span>
        <span class="l">{f.label}</span>
      </li>
    ))
  }
</ul>

<style>
  .figures {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--space-5);
    margin: var(--space-8) 0;
    text-align: left;
  }
  .figures li {
    padding-top: var(--space-4);
    border-top: 1px solid var(--hair);
  }
  .v {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2.1rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .l {
    display: block;
    margin-top: var(--space-2);
    font-size: 0.875rem;
    line-height: 1.45;
    letter-spacing: 0;
    color: var(--dim);
  }
</style>
