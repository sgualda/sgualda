---
import { NAV, CTA, SITE } from '@lib/site';
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <nav class="bar" aria-label="Main">
    <a href="/" class="logo" aria-label={`${SITE.name} — home`}>
      <img src="/img/logo.png" alt="" width="96" height="96" />
    </a>

    <ul class="links">
      {
        NAV.map(({ label, href }) => (
          <li>
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
          </li>
        ))
      }
    </ul>

    <a class="btn btn--dark cta" href={CTA.href}>{CTA.label}</a>

    <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
      <span></span><span></span>
    </button>
  </nav>
</header>

<!-- Full-screen mobile menu -->
<div class="sheet" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Menu" hidden>
  <button class="sheet-close" type="button" id="sheet-close" aria-label="Close menu">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M18 6 6 18M6 6l12 12" />
    </svg>
  </button>

  <ul class="sheet-links">
    {
      NAV.map(({ label, href }, i) => (
        <li style={`--i:${i}`}>
          <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
        </li>
      ))
    }
    <li style={`--i:${NAV.length}`} class="sheet-cta">
      <a class="btn btn--dark" href={CTA.href}>{CTA.label}</a>
    </li>
  </ul>
  <p class="sheet-foot" style={`--i:${NAV.length + 1}`}>
    <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
  </p>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }
  .bar {
    width: var(--shell);
    margin-inline: auto;
    padding-block: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
  }
  .logo { width: 36px; height: 36px; flex: none; }
  .logo img { width: 100%; height: 100%; object-fit: contain; }

  .links { display: flex; align-items: center; gap: 2px; list-style: none; }
  .links a {
    display: block;
    padding: 7px 10px;
    border-radius: 8px;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
    white-space: nowrap;
    transition: color 0.2s var(--ease);
  }
  .links a:hover,
  .links a[aria-current='page'] { color: var(--ink); }

  /* ── burger ── */
  .burger {
    display: none;
    /* 44px, not 40: it is the only way to navigate on a phone and it sits at
       the top corner, which is the hardest place on the screen to hit. */
    width: 44px;
    height: 44px;
    margin-left: auto;
    border: 0;
    background: transparent;
    cursor: pointer;
    position: relative;
    z-index: 82;
  }
  .burger span {
    display: block;
    width: 22px;
    height: 1.5px;
    margin: 5px auto;
    background: var(--ink);
    border-radius: 2px;
    transition: transform 0.36s var(--ease), opacity 0.24s var(--ease);
  }
  .burger[aria-expanded='true'] span:first-child { transform: translateY(3.25px) rotate(45deg); }
  .burger[aria-expanded='true'] span:last-child { transform: translateY(-3.25px) rotate(-45deg); }

  /* ── full-screen sheet ── */
  .sheet {
    position: fixed;
    inset: 0;
    z-index: 80;
    background: var(--paper);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 30px;
    /* Circular reveal from the burger, top-right. */
    clip-path: circle(0% at calc(100% - 40px) 34px);
    transition: clip-path 0.62s cubic-bezier(0.76, 0, 0.24, 1);
  }
  .sheet[hidden] { display: none; }
  .sheet.open { clip-path: circle(150% at calc(100% - 40px) 34px); }

  /* The burger sits inside .site-header, which has z-index 60 and therefore
     creates a stacking context — its own z-index cannot lift it above the
     sheet. So the close control lives inside the sheet instead. */
  .sheet-close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    background: none;
    border: 0;
    color: var(--ink);
    cursor: pointer;
    border-radius: 50%;
    opacity: 0;
    /* Fades in, never scales: a scaled-down button is a smaller touch target
       for the length of the animation, and 48px × 0.9 is below the minimum. */
    transition: opacity 0.3s var(--ease), background 0.2s var(--ease);
    transition-delay: 0.2s;
  }
  .sheet.open .sheet-close { opacity: 1; }
  .sheet-close:hover { background: var(--surface); }
  .sheet-close svg {
    width: 22px; height: 22px;
    stroke: currentColor; stroke-width: 1.6; fill: none;
    stroke-linecap: round;
  }

  .sheet-links { list-style: none; text-align: center; }
  .sheet-links li {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.4s var(--ease), transform 0.4s var(--ease);
    transition-delay: calc(0.16s + var(--i) * 0.055s);
  }
  .sheet.open .sheet-links li { opacity: 1; transform: none; }
  .sheet-links a {
    display: block;
    padding: 12px 0;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 9vw, 2.6rem);
    font-weight: 600;
    letter-spacing: 0em;
    line-height: var(--lh-display);
  }
  .sheet-links a[aria-current='page'] { color: var(--accent); }
  .sheet-cta { margin-top: 22px; }
  .sheet-cta a { font-family: var(--font-body); font-size: 0.9375rem; letter-spacing: var(--ls-read); }

  .sheet-foot {
    font-size: 0.9375rem;
    color: var(--dim);
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.4s var(--ease), transform 0.4s var(--ease);
    transition-delay: calc(0.16s + var(--i) * 0.055s);
  }
  .sheet.open .sheet-foot { opacity: 1; transform: none; }

  @media (max-width: 820px) {
    .bar { justify-content: space-between; gap: 10px; }
    .links,
    /* Sergio's call: the bar holds the logo and the burger, nothing else. The
       action lives inside the menu, where it is the largest thing on screen. */
    .cta { display: none; }
    .burger { display: block; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet { transition: none; }
    .sheet-links li,
    .sheet-foot { transition: none; }
  }
</style>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.burger');
  const sheet = document.querySelector<HTMLElement>('.sheet');

  if (burger && sheet) {
    const FOCUSABLE = 'a[href], button:not([disabled]), input, [tabindex]:not([tabindex="-1"])';
    let lastFocused: HTMLElement | null = null;
    let hideTimer = 0;
    let openFrame = 0;

    const setOpen = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.body.style.overflow = open ? 'hidden' : '';

      // Everything behind the sheet is removed from the accessibility tree and
      // the tab order. Without this, Tab walked through the page underneath.
      // The theme toggle is fixed and sits below the sheet, so it is hidden
      // but still tabbable unless it is named here too.
      for (const el of document.querySelectorAll('main, footer, .site-header nav, .theme-toggle')) {
        if (el !== sheet) (el as HTMLElement).inert = open;
      }

      if (open) {
        lastFocused = document.activeElement as HTMLElement;
        clearTimeout(hideTimer);
        sheet.hidden = false;
        // The class goes on next frame so the clip-path has something to
        // animate from. If the menu is dismissed inside that frame the
        // callback must not fire, or it re-opens a sheet that is closing and
        // leaves it stuck open with no way out.
        openFrame = requestAnimationFrame(() => {
          openFrame = 0;
          sheet.classList.add('open');
          sheet.querySelector<HTMLElement>(FOCUSABLE)?.focus();
        });
      } else {
        if (openFrame) { cancelAnimationFrame(openFrame); openFrame = 0; }
        sheet.classList.remove('open');
        // Deliberately a timer, not transitionend. That event does not fire at
        // all under prefers-reduced-motion, and it fires unreliably when the
        // menu is closed before the opening transition has finished — which
        // left the sheet stuck open about one time in five.
        const ms = parseFloat(getComputedStyle(sheet).transitionDuration) * 1000 || 0;
        clearTimeout(hideTimer);
        hideTimer = window.setTimeout(() => {
          if (!sheet.classList.contains('open')) sheet.hidden = true;
        }, ms);
        lastFocused?.focus();
      }
    };

    burger.addEventListener('click', () =>
      setOpen(burger.getAttribute('aria-expanded') !== 'true')
    );
    document.getElementById('sheet-close')?.addEventListener('click', () => setOpen(false));

    sheet.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (burger.getAttribute('aria-expanded') !== 'true') return;

      if (e.key === 'Escape') {
        setOpen(false);
        return;
      }
      if (e.key !== 'Tab') return;

      // Cycle focus inside the sheet.
      const items = [...sheet.querySelectorAll<HTMLElement>(FOCUSABLE)];
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement;

      if (e.shiftKey && (active === first || active === burger)) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    });
  }
</script>
