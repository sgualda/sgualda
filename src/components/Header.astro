---
import { NAV, CTA, SITE } from '@lib/site';
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <nav class="bar" aria-label="Main">
    <a href="/" class="logo" aria-label={`${SITE.name} — home`}>
      <img src="/img/logo.png" alt="" width="96" height="96" />
    </a>

    <ul class="links">
      {
        NAV.map(({ label, href }) => (
          <li>
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
          </li>
        ))
      }
    </ul>

    <a class="btn btn--dark cta" href={CTA.href}>{CTA.label}</a>

    <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
      <span></span><span></span>
    </button>
  </nav>
</header>

<!-- Full-screen mobile menu -->
<div class="sheet" id="mobile-menu" hidden>
  <ul class="sheet-links">
    {
      NAV.map(({ label, href }, i) => (
        <li style={`--i:${i}`}>
          <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
        </li>
      ))
    }
    <li style={`--i:${NAV.length}`} class="sheet-cta">
      <a class="btn btn--dark" href={CTA.href}>{CTA.label}</a>
    </li>
  </ul>
  <p class="sheet-foot" style={`--i:${NAV.length + 1}`}>
    <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
  </p>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }
  .bar {
    width: var(--shell);
    margin-inline: auto;
    padding-block: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
  }
  .logo { width: 36px; height: 36px; flex: none; }
  .logo img { width: 100%; height: 100%; object-fit: contain; }

  .links { display: flex; align-items: center; gap: 2px; list-style: none; }
  .links a {
    display: block;
    padding: 7px 10px;
    border-radius: 8px;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
    white-space: nowrap;
    transition: color 0.2s var(--ease);
  }
  .links a:hover,
  .links a[aria-current='page'] { color: var(--ink); }

  /* ── burger ── */
  .burger {
    display: none;
    width: 40px;
    height: 40px;
    margin-left: auto;
    border: 0;
    background: transparent;
    cursor: pointer;
    position: relative;
    z-index: 82;
  }
  .burger span {
    display: block;
    width: 22px;
    height: 1.5px;
    margin: 5px auto;
    background: var(--ink);
    border-radius: 2px;
    transition: transform 0.36s var(--ease), opacity 0.24s var(--ease);
  }
  .burger[aria-expanded='true'] span:first-child { transform: translateY(3.25px) rotate(45deg); }
  .burger[aria-expanded='true'] span:last-child { transform: translateY(-3.25px) rotate(-45deg); }

  /* ── full-screen sheet ── */
  .sheet {
    position: fixed;
    inset: 0;
    z-index: 80;
    background: var(--paper);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 30px;
    /* Circular reveal from the burger, top-right. */
    clip-path: circle(0% at calc(100% - 40px) 34px);
    transition: clip-path 0.62s cubic-bezier(0.76, 0, 0.24, 1);
  }
  .sheet[hidden] { display: none; }
  .sheet.open { clip-path: circle(150% at calc(100% - 40px) 34px); }

  .sheet-links { list-style: none; text-align: center; }
  .sheet-links li {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.4s var(--ease), transform 0.4s var(--ease);
    transition-delay: calc(0.16s + var(--i) * 0.055s);
  }
  .sheet.open .sheet-links li { opacity: 1; transform: none; }
  .sheet-links a {
    display: block;
    padding: 12px 0;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 9vw, 2.6rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }
  .sheet-links a[aria-current='page'] { color: var(--accent); }
  .sheet-cta { margin-top: 22px; }
  .sheet-cta a { font-family: var(--font-body); font-size: 0.9375rem; letter-spacing: -0.01em; }

  .sheet-foot {
    font-size: 0.9375rem;
    color: var(--dim);
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.4s var(--ease), transform 0.4s var(--ease);
    transition-delay: calc(0.16s + var(--i) * 0.055s);
  }
  .sheet.open .sheet-foot { opacity: 1; transform: none; }

  @media (max-width: 820px) {
    .bar { justify-content: space-between; gap: 10px; }
    .links,
    .cta { display: none; }
    .burger { display: block; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet { transition: none; }
    .sheet-links li,
    .sheet-foot { transition: none; }
  }
</style>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.burger');
  const sheet = document.querySelector<HTMLElement>('.sheet');

  if (burger && sheet) {
    const setOpen = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.body.style.overflow = open ? 'hidden' : '';

      if (open) {
        sheet.hidden = false;
        // Force a frame so the clip-path transition actually runs.
        requestAnimationFrame(() => sheet.classList.add('open'));
      } else {
        sheet.classList.remove('open');
        sheet.addEventListener('transitionend', () => { if (!sheet.classList.contains('open')) sheet.hidden = true; }, { once: true });
      }
    };

    burger.addEventListener('click', () =>
      setOpen(burger.getAttribute('aria-expanded') !== 'true')
    );
    sheet.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).tagName === 'A') setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') setOpen(false);
    });
  }
</script>
