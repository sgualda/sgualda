---
/**
 * The dark subscribe band. Appears on the Home, the Map and the Journal in the
 * Figma file, so it lives here rather than being pasted into three pages.
 */
interface Props {
  title?: string;
  body?: string;
}
const {
  title = 'Every other week,<br />one thing I got wrong.',
  body = 'And what it cost. No roundups, no five tips, no news.',
} = Astro.props;
---

<div class="band">
  <h2 set:html={title} />
  <p>{body}</p>
  <!-- Opens Substack in a new tab rather than navigating away: the reader
       keeps the page they were on, and comes back to it. -->
  <form
    class="signup"
    action="https://sgualda.substack.com/subscribe"
    method="get"
    target="_blank"
    {...{ rel: 'noopener' }}
  >
    <label class="sr-only" for="nl-email">Email address</label>
    <input id="nl-email" name="email" type="email" required placeholder="name@email.com" />
    <button class="btn" type="submit">Subscribe</button>
    <p class="fine">Opens Substack in a new tab.</p>
  </form>
</div>

<style>
  .band {
    background: var(--band);
    color: var(--on-band);
    /* Invisible in light, where band and border are the same colour. In dark
       it is the edge that makes a raised surface read as raised. */
    border: 1px solid color-mix(in srgb, var(--on-band) 8%, var(--band));
    border-radius: var(--radius-band);
    padding: clamp(44px, 7vw, 68px) 24px;
    text-align: center;
  }
  .band h2 { color: var(--on-band); }
  .band p {
    margin-top: 14px;
    font-size: 1rem;
    letter-spacing: 0;
    color: color-mix(in srgb, var(--on-band) 68%, transparent);
  }
  .signup { margin-top: 28px; display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
  .signup input {
    background: color-mix(in srgb, var(--on-band) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--on-band) 42%, transparent);
    color: var(--on-band);
    border-radius: var(--radius-pill);
    padding: 13px 20px;
    font-size: 0.9375rem;
    min-width: 220px;
    outline: none;
  }
  .signup input::placeholder { color: color-mix(in srgb, var(--on-band) 68%, transparent); }
  .signup input:focus { border-color: var(--on-band); }
    /* The band's own contrast, not the page's. --paper here meant a white
     button in light and a near-black one in dark, which vanished into the
     grey band it was sitting on. */
  .signup .btn { background: var(--on-band); color: var(--band); border-color: var(--on-band); }
  .signup .btn:hover { background: color-mix(in srgb, var(--on-band) 84%, transparent); }

  .fine {
    flex-basis: 100%;
    margin-top: var(--space-3);
    font-size: 0.75rem;
    letter-spacing: 0;
    color: color-mix(in srgb, var(--on-band) 55%, transparent);
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
  }
</style>
