---
/**
 * The dark subscribe band. Appears on the Home, the Map and the Journal in the
 * Figma file, so it lives here rather than being pasted into three pages.
 */
interface Props {
  title?: string;
  body?: string;
}
const {
  title = 'Every other week,<br />one thing I got wrong.',
  body = 'And what it cost. No roundups, no five tips, no news.',
} = Astro.props;
---

<div class="band">
  <h2 set:html={title} />
  <p>{body}</p>
  <form class="signup" action="https://sgualda.substack.com/subscribe" method="get">
    <label class="sr-only" for="nl-email">Email address</label>
    <input id="nl-email" name="email" type="email" required placeholder="name@email.com" />
    <button class="btn" type="submit">Subscribe</button>
  </form>
</div>

<style>
  .band {
    background: var(--inverse);
    color: var(--on-inverse);
    border-radius: var(--radius-band);
    padding: clamp(44px, 7vw, 68px) 24px;
    text-align: center;
  }
  .band h2 { color: var(--on-inverse); }
  .band p {
    margin-top: 14px;
    font-size: 1rem;
    letter-spacing: 0;
    color: color-mix(in srgb, var(--on-inverse) 68%, transparent);
  }
  .signup { margin-top: 28px; display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
  .signup input {
    background: color-mix(in srgb, var(--on-inverse) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--on-inverse) 42%, transparent);
    color: var(--on-inverse);
    border-radius: var(--radius-pill);
    padding: 13px 20px;
    font-size: 0.9375rem;
    min-width: 220px;
    outline: none;
  }
  .signup input::placeholder { color: color-mix(in srgb, var(--on-inverse) 68%, transparent); }
  .signup input:focus { border-color: var(--on-inverse); }
  .signup .btn { background: var(--paper); color: var(--ink); border-color: var(--paper); }
  .signup .btn:hover { background: color-mix(in srgb, var(--paper) 84%, transparent); }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
  }
</style>
