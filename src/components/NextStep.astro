---
/**
 * The end of a page that has finished making its argument.
 *
 * Five of the seven page types used to end without offering anything: the
 * essays, /about/, the glossary, the community page and a check you had not
 * completed. Those are precisely the pages a stranger lands on, so the site was
 * convincing well and closing rarely.
 *
 * Deliberately quiet. It is a line and two links, not a banner: somebody who
 * has just read 1,200 words does not need to be sold to, they need to be told
 * where the door is. The second link is always the low-commitment one, because
 * the whole proposition is that contacting costs nothing.
 */
interface Props {
  /** The sentence above the buttons. Written for the page it sits on. */
  line: string;
  /** Overrides the secondary action where a page has a better one. */
  secondLabel?: string;
  secondHref?: string;
  /**
   * Offers the community as a third, lowest-commitment option. On by default:
   * /community/ had zero contextual inbound links and was reachable only from
   * the footer, which is the weakest place in the internal link graph.
   */
  community?: boolean;
}
const { line, secondLabel = 'Run a free check', secondHref = '/tools/', community = true } = Astro.props;
---

<section class="col next-step">
  <p class="line">{line}</p>
  <div class="actions">
    <a class="btn btn--dark" href="/work-with-me/">Hire me</a>
    <a class="btn btn--ghost" href={secondHref}>{secondLabel}</a>
  </div>
  {
    community && (
      <p class="aside-link">
        Or ask the room — <a href="/community/">the community chat</a> is free and full of
        people with the same problem.
      </p>
    )
  }
</section>

<style>
  .next-step {
    margin-top: var(--gap);
    padding-top: var(--space-9);
    border-top: 1px solid var(--hair);
    text-align: center;
  }
  .line {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: var(--ls-heading);
    line-height: var(--lh-tight);
  }
  .next-step .actions { margin-top: var(--space-6); }
  .aside-link {
    margin-top: var(--space-4);
    font-size: 0.8125rem;
    line-height: var(--lh-ui);
    letter-spacing: 0;
    color: var(--dim);
  }
  .aside-link a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }

</style>
